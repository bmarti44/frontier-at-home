diff --git a/src/llama-model-loader.cpp b/src/llama-model-loader.cpp
index 28f8bb793..5866d301a 100644
--- a/src/llama-model-loader.cpp
+++ b/src/llama-model-loader.cpp
@@ -1441,3 +1441,5 @@ bool llama_model_loader::load_all_data(
-    // Buffer size: balance between memory usage and I/O efficiency
-    // 64MB works well for NVMe drives
-    const size_t buffer_size = alignment != 1 ? 64 * 1024 * 1024 + 2 * alignment : 1 * 1024 * 1024;
+    // Payload size: balance between memory usage and I/O efficiency. Allocate
+    // separate alignment headroom because host-buffer bases are not required
+    // to satisfy the model file's block alignment.
+    const size_t upload_chunk_size = alignment != 1 ? 64 * 1024 * 1024 : 1 * 1024 * 1024;
+    const size_t host_buffer_size = upload_chunk_size + alignment - 1;
@@ -1492 +1494 @@ bool llama_model_loader::load_all_data(
-            auto * buf = ggml_backend_buft_alloc_buffer(host_buft, buffer_size);
+            auto * buf = ggml_backend_buft_alloc_buffer(host_buft, host_buffer_size);
@@ -1601 +1603 @@ bool llama_model_loader::load_all_data(
-                        size_t read_size = std::min<size_t>(buffer_size, read_end - read_start - bytes_read);
+                        size_t read_size = std::min<size_t>(upload_chunk_size, read_end - read_start - bytes_read);
