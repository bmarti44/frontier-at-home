+        const auto release = [] { g_expert_slab.active_readers.fetch_sub(1); };
+        if (g_expert_slab.state.load() != 1) { release(); return {}; }
+        auto found = g_expert_slab.by_key.find(identity.key);
+        if (found == g_expert_slab.by_key.end()) { release(); return {}; }
+        const cuda_expert_slab_record &record = g_expert_slab.records[found->second];
+        const uint64_t read_bytes = cuda_expert_slab_align_up(
+            record.payload_bytes, g_expert_slab.header.alignment);
+        if (record.payload_bytes != identity.expected_length ||
+            read_bytes == 0 || read_bytes > capacity ||
+            memcmp(record.payload_sha256, identity.expected_sha256.data(), 32) != 0) {
+            release(); return {};
+        }
+        const uint64_t submit_ns = submit_ns_;
+        const uint32_t in_flight = g_pf.slab_window.in_flight.fetch_add(1) + 1;
+        cuda_expert_slab_window_max(&g_pf.slab_window.peak_in_flight, in_flight);
+        cuda_expert_slab_window_min(&g_pf.slab_window.first_submit_ns, submit_ns);
+        const int ok = cuda_pread_full(g_pf.fd, buffer, read_bytes,
+                                       record.expert_slab_offset);
+        const uint64_t complete_ns = cuda_expert_slab_now_ns();
+        g_pf.slab_window.in_flight.fetch_sub(1);
+        cuda_expert_slab_window_max64(&g_pf.slab_window.last_complete_ns, complete_ns);
+        g_pf.slab_window.reads.fetch_add(1);
+        g_pf.slab_window.logical_bytes.fetch_add(record.payload_bytes);
+        g_pf.slab_window.actual_bytes.fetch_add(read_bytes);
+        if (getenv("DS4_CUDA_EXPERT_SLAB_TRACE"))
+            fprintf(stderr,
+                    "SLABIO worker=%d layer=%u expert=%u offset=%llu bytes=%llu "
+                    "submit_ns=%llu complete_ns=%llu ok=%d\n",
+                    worker_id_, record.layer, record.expert,
+                    (unsigned long long)record.expert_slab_offset,
+                    (unsigned long long)read_bytes,
+                    (unsigned long long)submit_ns,
+                    (unsigned long long)complete_ns, ok);
+        release();
+        return {ok != 0, ok ? (size_t)record.payload_bytes : 0};
+    }
+    bool sha256(const uint8_t *data, size_t bytes, uint8_t out[32]) override {
+        return cuda_expert_slab_sha256(data, bytes, out) != 0;
+    }
+    bool copy_sync(const uint8_t *buffer, size_t bytes) override {
+        if (!gate_dst_ || !up_dst_ || !down_dst_ ||
+            bytes != 2u * gate_bytes_ + down_bytes_) return false;
+        const bool copied = cuda_ok(cudaMemcpy(gate_dst_, buffer, gate_bytes_, cudaMemcpyDefault),
+                       "prefetch gate copy") &&
+            cuda_ok(cudaMemcpy(up_dst_, buffer + gate_bytes_, gate_bytes_,
+                               cudaMemcpyDefault), "prefetch up copy") &&
+            cuda_ok(cudaMemcpy(down_dst_, buffer + 2u * gate_bytes_, down_bytes_,
+                               cudaMemcpyDefault), "prefetch down copy");
+        if (!copied || !publish_) return copied;
+        const uint32_t slot = cuda_expert_cache_insert(key_, gate_off_, down_off_);
+        if (slot == UINT32_MAX) return false;
+        uint8_t *fill = g_expert_persist_cache.arena +
+            (uint64_t)slot * g_expert_persist_cache.slot_bytes;
+        const bool published =
+            cuda_ok(cudaMemcpy(fill, gate_dst_, gate_bytes_, cudaMemcpyDefault),
+                    "pf arena gate") &&
+            cuda_ok(cudaMemcpy(fill + gate_bytes_, up_dst_, gate_bytes_,
+                               cudaMemcpyDefault), "pf arena up") &&
+            cuda_ok(cudaMemcpy(fill + 2u * gate_bytes_, down_dst_, down_bytes_,
+                               cudaMemcpyDefault), "pf arena down");
+        if (!published) {
+            g_expert_persist_cache.map->erase(key_);
+            g_expert_persist_cache.meta[slot].key = UINT64_MAX;
+        }
+        return published;
+    }
+    void invalidate_slab() override {
+        (void)cuda_expert_slab_fail("prefetch read/SHA/lease integrity failure");
+    }
+    uint64_t now_ns() override { return cuda_expert_slab_now_ns(); }
+    bool publication_expected() const override { return publish_; }
+    uint64_t submit_ns() const { return submit_ns_; }
+private:
+    int worker_id_ = -1;
+    char *gate_dst_ = NULL;
+    char *up_dst_ = NULL;
+    char *down_dst_ = NULL;
+    uint64_t gate_bytes_ = 0;
+    uint64_t down_bytes_ = 0;
+    uint64_t key_ = 0;
+    uint64_t gate_off_ = 0;
+    uint64_t down_off_ = 0;
+    bool publish_ = false;
+    uint64_t submit_ns_ = 0;
+};
