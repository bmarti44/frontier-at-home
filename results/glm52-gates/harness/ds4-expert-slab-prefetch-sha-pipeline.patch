+    ds4_slab_prefetch::ReadResult read(
+            const ds4_slab_prefetch::Identity &identity,
+            uint8_t *buffer, size_t capacity) override {
+        submit_ns_ = cuda_expert_slab_now_ns();
+        if (g_expert_slab.state.load() != 1 ||
+            identity.model_generation != g_model_load_generation ||
+            g_expert_slab.model_generation != g_model_load_generation) return {};
