From d2520d9a580f3a0bd8d7861091e2ae197998bf6c Mon Sep 17 00:00:00 2001
From: Brian Martin <brian@brianmartin.com>
Date: Fri, 7 Aug 2026 13:10:06 -0400
Subject: [PATCH 33/40] fix: graduate verified GLM restored frontier

---
 ds4.c        | 13 ++++++-------
 ds4.h        |  8 +++-----
 ds4_server.c | 17 ++++++++---------
 3 files changed, 17 insertions(+), 21 deletions(-)

diff --git a/ds4.c b/ds4.c
index 89b0c43..36a4b69 100644
--- a/ds4.c
+++ b/ds4.c
@@ -49227,24 +49227,22 @@ static bool ds4_session_is_glm(const ds4_session *s) {
     return s && s->engine && DS4_MODEL_FAMILY == DS4_MODEL_FAMILY_GLM_DSA;
 }
 
-bool ds4_glm_restored_frontier_authoritative(bool diagnostic_enabled,
-                                             bool payload_complete,
+bool ds4_glm_restored_frontier_authoritative(bool payload_complete,
                                              uint32_t saved_tokens,
                                              uint32_t compact_rows) {
-    return diagnostic_enabled && payload_complete && saved_tokens != 0 &&
+    return payload_complete && saved_tokens != 0 &&
            compact_rows == saved_tokens;
 }
 
 bool ds4_glm_apply_restored_frontier(ds4_tokens *evaluated,
                                      const ds4_tokens *checkpoint,
-                                     bool diagnostic_enabled,
                                      bool payload_complete,
                                      uint32_t saved_tokens,
                                      uint32_t compact_rows) {
     if (!evaluated || !checkpoint ||
         checkpoint->len != (int)saved_tokens ||
         !ds4_glm_restored_frontier_authoritative(
-            diagnostic_enabled, payload_complete, saved_tokens, compact_rows))
+            payload_complete, saved_tokens, compact_rows))
         return false;
     ds4_tokens_copy(evaluated, checkpoint);
     return true;
@@ -50976,6 +50974,7 @@ int ds4_session_load_payload(ds4_session *s, FILE *fp, uint64_t payload_bytes, c
         s->mtp_draft_valid = false;
         s->glm_dense_cache_len = g->full_kv_cache ? saved_full_live : 0;
         {
+            const int prior_frontier = s->glm_evaluated.len;
             const char *restore_flag =
                 getenv("DS4_GLM_RESTORED_FRONTIER_DIAGNOSTIC");
             const bool restore_enabled =
@@ -50984,7 +50983,7 @@ int ds4_session_load_payload(ds4_session *s, FILE *fp, uint64_t payload_bytes, c
                 ds4_glm_apply_restored_frontier(
                     (ds4_tokens *)&s->glm_evaluated,
                     (const ds4_tokens *)&s->checkpoint,
-                    restore_enabled, remaining == 0,
+                    remaining == 0,
                     saved_tokens, expected_compact_live);
             if (restore_enabled) {
                 fprintf(stderr,
@@ -50992,7 +50991,7 @@ int ds4_session_load_payload(ds4_session *s, FILE *fp, uint64_t payload_bytes, c
                         "checkpoint=%u compact_rows=%u prior_frontier=%d\n",
                         authoritative ? "authoritative" : "rejected",
                         saved_tokens, expected_compact_live,
-                        s->glm_evaluated.len);
+                        prior_frontier);
             }
         }
         return 0;
diff --git a/ds4.h b/ds4.h
index 1e53af8..8a5cefe 100644
--- a/ds4.h
+++ b/ds4.h
@@ -357,15 +357,13 @@ typedef enum {
 #define DS4_SESSION_SYNC_INTERRUPTED 2
 int ds4_session_sync(ds4_session *s, const ds4_tokens *prompt, char *err, size_t errlen);
 bool ds4_session_rewrite_requires_rebuild(int live_len, int canonical_len, int common);
-/* A restored GLM checkpoint may replace a longer live frontier only in the
- * diagnostic arm, after the loader has verified a complete compact snapshot. */
-bool ds4_glm_restored_frontier_authoritative(bool diagnostic_enabled,
-                                             bool payload_complete,
+/* A restored GLM checkpoint may replace a longer live frontier only after the
+ * loader has verified a complete compact snapshot covering every saved token. */
+bool ds4_glm_restored_frontier_authoritative(bool payload_complete,
                                              uint32_t saved_tokens,
                                              uint32_t compact_rows);
 bool ds4_glm_apply_restored_frontier(ds4_tokens *evaluated,
                                      const ds4_tokens *checkpoint,
-                                     bool diagnostic_enabled,
                                      bool payload_complete,
                                      uint32_t saved_tokens,
                                      uint32_t compact_rows);
diff --git a/ds4_server.c b/ds4_server.c
index 35bf4cf..ef48b6d 100644
--- a/ds4_server.c
+++ b/ds4_server.c
@@ -16745,11 +16745,10 @@ static void test_glm_restored_frontier_requires_complete_snapshot(void) {
      * production snapshot whose compact cache covers every checkpoint token
      * is authoritative without a diagnostic opt-in.  Incomplete snapshots
      * remain rejected. */
-    TEST_ASSERT(ds4_glm_restored_frontier_authoritative(false, true, 5044, 5044));
-    TEST_ASSERT(!ds4_glm_restored_frontier_authoritative(true, false, 5044, 5044));
-    TEST_ASSERT(!ds4_glm_restored_frontier_authoritative(true, true, 5044, 4096));
-    TEST_ASSERT(!ds4_glm_restored_frontier_authoritative(true, true, 0, 0));
-    TEST_ASSERT(ds4_glm_restored_frontier_authoritative(true, true, 5044, 5044));
+    TEST_ASSERT(ds4_glm_restored_frontier_authoritative(true, 5044, 5044));
+    TEST_ASSERT(!ds4_glm_restored_frontier_authoritative(false, 5044, 5044));
+    TEST_ASSERT(!ds4_glm_restored_frontier_authoritative(true, 5044, 4096));
+    TEST_ASSERT(!ds4_glm_restored_frontier_authoritative(true, 0, 0));
 
     ds4_tokens prior = {0};
     ds4_tokens checkpoint = {0};
@@ -16760,18 +16759,18 @@ static void test_glm_restored_frontier_requires_complete_snapshot(void) {
     ds4_tokens_push(&checkpoint, 12);
 
     TEST_ASSERT(ds4_glm_apply_restored_frontier(
-        &prior, &checkpoint, false, true, 2, 2));
+        &prior, &checkpoint, true, 2, 2));
     TEST_ASSERT(prior.len == 2 && prior.v[0] == 11 && prior.v[1] == 12);
     prior.len = 2;
     ds4_tokens_push(&prior, 13);
     TEST_ASSERT(!ds4_glm_apply_restored_frontier(
-        &prior, &checkpoint, true, false, 2, 2));
+        &prior, &checkpoint, false, 2, 2));
     TEST_ASSERT(prior.len == 3 && prior.v[2] == 13);
     TEST_ASSERT(!ds4_glm_apply_restored_frontier(
-        &prior, &checkpoint, true, true, 2, 1));
+        &prior, &checkpoint, true, 2, 1));
     TEST_ASSERT(prior.len == 3 && prior.v[2] == 13);
     TEST_ASSERT(ds4_glm_apply_restored_frontier(
-        &prior, &checkpoint, true, true, 2, 2));
+        &prior, &checkpoint, true, 2, 2));
     TEST_ASSERT(prior.len == 2 && prior.v[0] == 11 && prior.v[1] == 12);
     checkpoint.v[1] = 99;
     TEST_ASSERT(prior.v[1] == 12);
-- 
2.43.0

