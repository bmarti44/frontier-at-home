 } g_expert_slab;
 static std::mutex g_expert_slab_init_mu;
 
+typedef unsigned char *(*cuda_expert_slab_sha256_fn)(
+    const unsigned char *, size_t, unsigned char *);
+static struct {
+    void *handle;
+    cuda_expert_slab_sha256_fn sha256;
+} g_expert_slab_crypto;
+
 /* O_DIRECT buffers must also be CUDA page-locked.  Pageable per-layer
  * buffers make cudaMemcpy perform an implicit registration/staging cycle on
  * every expert miss; the live RED arm measured 2--9 ms reads inside 50--70 ms
@@ -23760,6 +23768,40 @@ static uint64_t cuda_expert_slab_align_up(uint64_t value, uint64_t alignment) {
     return (value + alignment - 1) / alignment * alignment;
 }
 
+static int cuda_expert_slab_crypto_init(void) {
+    if (g_expert_slab_crypto.sha256) return 1;
+    const char *libraries[] = {"libcrypto.so.3", "libcrypto.so"};
+    for (const char *library : libraries) {
+        void *handle = dlopen(library, RTLD_NOW | RTLD_LOCAL);
+        if (!handle) continue;
+        void *symbol = dlsym(handle, "SHA256");
+        cuda_expert_slab_sha256_fn function = NULL;
+        memcpy(&function, &symbol, sizeof(function));
+        if (function) {
+            g_expert_slab_crypto.handle = handle;
+            g_expert_slab_crypto.sha256 = function;
+            return 1;
+        }
+        (void)dlclose(handle);
+    }
+    return 0;
+}
+
+static int cuda_expert_slab_sha256(const void *data, size_t bytes,
+                                   uint8_t out[32]) {
+    return g_expert_slab_crypto.sha256 &&
+           g_expert_slab_crypto.sha256(
+               (const unsigned char *)data, bytes, out) == out;
+}
+
+static void cuda_expert_slab_crypto_release(void) {
+    g_expert_slab_crypto.sha256 = NULL;
+    if (g_expert_slab_crypto.handle) {
+        (void)dlclose(g_expert_slab_crypto.handle);
+        g_expert_slab_crypto.handle = NULL;
+    }
+}
