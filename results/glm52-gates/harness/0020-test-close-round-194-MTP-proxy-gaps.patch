+#!/usr/bin/env python3
+"""Externally inspect the default-off candidate sandbox before GPU work."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import select
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+
+
+BINARY = Path(sys.argv.pop(1) if len(sys.argv) > 1 and not sys.argv[1].startswith("-") else "./ds4").resolve()
+PACK = Path(os.environ.get("DS4_GLM_MTP_PROXY_TEST_PACK", ""))
+FULL_MODEL = Path(os.environ.get("DS4_GLM_MTP_PROXY_TEST_FULL_MODEL", ""))
+
+
+def write_source(directory: Path) -> None:
+    directory.mkdir()
+    artifacts = {
+        "z0.f32le": b"".join(struct.pack("<f", i * 0.0001) for i in range(6144)),
+        "q1.i32le": struct.pack("<i", 42),
+        "source-position.u32le": struct.pack("<I", 4096),
+        "min-position.u32le": struct.pack("<I", 4080),
+    }
+    manifest = {"schema": "glm52-mtp-proxy-source-v1", "artifacts": []}
+    for name, data in artifacts.items():
+        (directory / name).write_bytes(data)
+        manifest["artifacts"].append(
+            {"bytes": len(data), "name": name, "sha256": hashlib.sha256(data).hexdigest()}
+        )
+    (directory / "complete.json").write_text(
+        json.dumps(manifest, sort_keys=True, separators=(",", ":")) + "\n"
+    )
+
+
+@unittest.skipUnless(PACK.is_file() and FULL_MODEL.is_file(), "exact pack/model required")
+class GlmMtpProxySandboxTests(unittest.TestCase):
+    def test_real_candidate_child_drops_full_model_and_denies_escape(self) -> None:
+        with tempfile.TemporaryDirectory(prefix="ds4-glm-proxy-sandbox-") as td:
+            root = Path(td)
+            source = root / "source"
+            output = root / "output"
+            forbidden = root / "forbidden-model.gguf"
+            forbidden.write_bytes(b"forbidden")
+            write_source(source)
+            ready_r, ready_w = os.pipe()
+            release_r, release_w = os.pipe()
+            inherited_model_fd = os.open(FULL_MODEL, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
+            env = {
+                "HOME": os.environ.get("HOME", "/tmp"),
+                "LANG": "C.UTF-8",
+                "LC_ALL": "C.UTF-8",
+                "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
+                "DS4_LOCK_FILE": str(root / "engine.lock"),
+                "DS4_GLM_MTP_PROXY_CANDIDATE_DIR": str(output),
+                "DS4_GLM_MTP_PROXY_PACK": str(PACK.resolve()),
+                "DS4_GLM_MTP_PROXY_SOURCE_STATE": str(source),
+                "DS4_GLM_MTP_PROXY_SANDBOX_READY_FD": str(ready_w),
+                "DS4_GLM_MTP_PROXY_SANDBOX_RELEASE_FD": str(release_r),
+                "DS4_GLM_MTP_PROXY_SANDBOX_FORBIDDEN_PATH": str(forbidden),
+                "DS4_GLM_MTP_PROXY_SANDBOX_UNEXPECTED_DEVICE": "/dev/zero",
+            }
+            process = subprocess.Popen(
+                [str(BINARY), "--model", str(forbidden), "--prompt", "sandbox probe"],
+                env=env,
+                pass_fds=(ready_w, release_r, inherited_model_fd),
+                text=True,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+            )
+            os.close(ready_w)
+            os.close(release_r)
+            os.close(inherited_model_fd)
+            try:
+                readable, _, _ = select.select([ready_r], [], [], 15)
+                self.assertTrue(readable, "candidate did not reach sandbox inspection barrier")
+                self.assertEqual(os.read(ready_r, 1), b"R")
+                fd_targets = []
+                for entry in (Path("/proc") / str(process.pid) / "fd").iterdir():
+                    try:
+                        fd_targets.append(os.readlink(entry))
+                    except FileNotFoundError:
+                        pass
+                maps = (Path("/proc") / str(process.pid) / "maps").read_text()
+                self.assertFalse(any(str(FULL_MODEL) in target for target in fd_targets))
+                self.assertNotIn(str(FULL_MODEL), maps)
+                self.assertFalse(any(str(forbidden) in target for target in fd_targets))
+                os.write(release_w, b"G")
+                stdout, stderr = process.communicate(timeout=15)
+            finally:
+                os.close(ready_r)
+                os.close(release_w)
+                if process.poll() is None:
+                    process.kill()
+                    process.wait()
+            self.assertNotEqual(process.returncode, 0)
+            self.assertEqual(stdout, "")
+            self.assertIn("GLM MTP proxy sandbox active", stderr)
+            self.assertIn(
+                "sandbox probe model_reopen=DENIED socket=DENIED ptrace=DENIED "
+                "process_vm=DENIED unexpected_device=DENIED inherited_full_model=ABSENT",
+                stderr,
+            )
+            self.assertNotIn("cannot open model", stderr)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
