+#!/usr/bin/env python3
+"""Observe and fault the real publisher at actual syscall boundaries."""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+import unittest
+
+
+WORKER = Path(sys.argv.pop(1) if len(sys.argv) > 1 and not sys.argv[1].startswith("-") else "tests/glm_mtp_proxy_publish_worker").resolve()
+ARTIFACTS = (
+    "states.f32le", "head-logits.f32le", "tokens.i32le",
+    "positions.u32le", "slots.u32le", "router-scores.f32le",
+    "router-ranks.u8", "prefix-max-scores.f32le",
+    "prefix-max-ranks.u8", "stage-receipts.u64le",
+)
+
+
+def run_traced(directory: Path, injection: str | None = None) -> tuple[subprocess.CompletedProcess[str], str]:
+    trace = directory.parent / f"{directory.name}.trace"
+    command = [
+        "/usr/bin/strace", "-qq", "-f", "-o", str(trace),
+        "-e", "trace=openat,write,fsync,rename,renameat,renameat2",
+    ]
+    if injection:
+        command += ["-e", f"inject={injection}"]
+    command += [str(WORKER), str(directory)]
+    result = subprocess.run(
+        command, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        timeout=30, check=False,
+    )
+    return result, trace.read_text()
+
+
+def validate_if_complete(directory: Path) -> None:
+    complete = directory / "complete.json"
+    if not complete.exists():
+        return
+    manifest = json.loads(complete.read_bytes())
+    assert manifest["schema"] == "glm52-mtp-proxy-transcript-v1"
+    assert tuple(item["name"] for item in manifest["artifacts"]) == ARTIFACTS
+    for item in manifest["artifacts"]:
+        path = directory / item["name"]
+        assert path.is_file() and path.stat().st_size == item["bytes"]
+
+
+class GlmMtpProxyPublicationSyscallTests(unittest.TestCase):
+    def test_success_uses_atomic_completion_last_and_real_durability_calls(self) -> None:
+        with tempfile.TemporaryDirectory(prefix="glm-mtp-publish-syscall-") as td:
+            directory = Path(td) / "output"
+            directory.mkdir()
+            result, trace = run_traced(directory)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            renames = [line for line in trace.splitlines() if "renameat2(" in line]
+            self.assertEqual(len(renames), len(ARTIFACTS) + 1)
+            self.assertIn('"complete.json"', renames[-1])
+            for name in ARTIFACTS:
+                self.assertTrue(any(f'"{name}"' in line for line in renames))
+            staging_opens = [
+                line for line in trace.splitlines()
+                if "openat(" in line and ".tmp." in line
+            ]
+            self.assertEqual(len(staging_opens), len(ARTIFACTS) + 1)
+            self.assertTrue(all("O_EXCL" in line and "O_NOFOLLOW" in line for line in staging_opens))
+            fsyncs = [line for line in trace.splitlines() if "fsync(" in line]
+            self.assertGreaterEqual(len(fsyncs), len(ARTIFACTS) + 3)
+            validate_if_complete(directory)
+
+    def test_real_syscall_faults_and_kills_never_leave_partial_admissible_output(self) -> None:
+        with tempfile.TemporaryDirectory(prefix="glm-mtp-publish-counts-") as td:
+            baseline_directory = Path(td) / "output"
+            baseline_directory.mkdir()
+            baseline, baseline_trace = run_traced(baseline_directory)
+            self.assertEqual(baseline.returncode, 0, baseline.stderr)
+        recoverable_injections = (
+            "write:error=ENOSPC:when=1",
+            "write:error=EINTR:when=1",
+            "write:retval=1:when=1",
+            "fsync:error=EIO:when=1",
+            "renameat2:error=EIO:when=1",
+        )
+        for index, injection in enumerate(recoverable_injections):
+            with self.subTest(injection=injection), tempfile.TemporaryDirectory(
+                prefix=f"glm-mtp-publish-fault-{index}-"
+            ) as td:
+                directory = Path(td) / "output"
+                directory.mkdir()
+                result, _ = run_traced(directory, injection)
+                if "error=EINTR" in injection or "retval=1" in injection:
+                    self.assertEqual(result.returncode, 0, result.stderr)
+                else:
+                    self.assertNotEqual(result.returncode, 0)
+                validate_if_complete(directory)
+                if result.returncode != 0:
+                    self.assertFalse((directory / "complete.json").exists())
+        for syscall in ("write", "fsync", "renameat2"):
+            count = len([
+                line for line in baseline_trace.splitlines()
+                if re.search(rf"\b{syscall}\(", line)
+            ])
+            self.assertGreater(count, 0, f"successful publisher made no {syscall} syscall")
+            for occurrence in range(1, count + 1):
+                injection = f"{syscall}:signal=SIGKILL:when={occurrence}"
+                with self.subTest(injection=injection), tempfile.TemporaryDirectory(
+                    prefix=f"glm-mtp-publish-kill-{syscall}-{occurrence}-"
+                ) as td:
+                    directory = Path(td) / "output"
+                    directory.mkdir()
+                    result, _ = run_traced(directory, injection)
+                    self.assertNotEqual(result.returncode, 0)
+                    # A kill before completion leaves no admissible marker. A
+                    # kill during/after the final directory fsync may leave the
+                    # fully written atomic transcript, which must validate.
+                    validate_if_complete(directory)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
