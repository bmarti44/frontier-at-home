+static int mutate_byte(const char *path, off_t offset, uint8_t *saved) {
+    int fd = open(path, O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0 || pread(fd, saved, 1, offset) != 1) {
+        if (fd >= 0) close(fd);
+        return -1;
+    }
+    const uint8_t changed = *saved ^ 1u;
+    const int ok = pwrite(fd, &changed, 1, offset) == 1 && fsync(fd) == 0;
+    close(fd);
+    return ok ? 0 : -1;
+}
+
+static int restore_byte(const char *path, off_t offset, uint8_t saved) {
+    int fd = open(path, O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) return -1;
+    const int ok = pwrite(fd, &saved, 1, offset) == 1 && fsync(fd) == 0;
