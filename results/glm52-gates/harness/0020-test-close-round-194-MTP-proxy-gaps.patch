diff --git a/tests/glm_mtp_proxy_publish_worker.c b/tests/glm_mtp_proxy_publish_worker.c
new file mode 100644
index 0000000..aac7d01
--- /dev/null
+++ b/tests/glm_mtp_proxy_publish_worker.c
@@ -0,0 +1,65 @@
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+typedef struct {
+    const char *name;
+    const void *data;
+    uint64_t size;
+} proxy_artifact;
+
+typedef struct {
+    uint32_t step;
+    uint32_t position;
+    uint32_t slot;
+    uint32_t boundary;
+    uint64_t monotonic_ns;
+} proxy_stage_receipt;
+
+extern int ds4_glm_mtp_proxy_publish_contract(
+    const char *, const proxy_artifact *, uint32_t, const char *)
+    __attribute__((weak));
+
+int main(int argc, char **argv) {
+    if (argc != 2) return 64;
+    if (!ds4_glm_mtp_proxy_publish_contract) return 77;
+    static const struct {
+        const char *name;
+        uint64_t size;
+    } expected[] = {
+        {"states.f32le", 221184},
+        {"head-logits.f32le", 5575680},
+        {"tokens.i32le", 36},
+        {"positions.u32le", 32},
+        {"slots.u32le", 32},
+        {"router-scores.f32le", 614400},
+        {"router-ranks.u8", 153600},
+        {"prefix-max-scores.f32le", 230400},
+        {"prefix-max-ranks.u8", 57600},
+        {"stage-receipts.u64le", 192},
+    };
+    proxy_artifact artifacts[sizeof(expected) / sizeof(expected[0])];
+    for (size_t i = 0; i < sizeof(expected) / sizeof(expected[0]); i++) {
+        uint8_t *data = calloc(1u, (size_t)expected[i].size);
+        if (!data) return 70;
+        data[0] = (uint8_t)(i + 1u);
+        artifacts[i] = (proxy_artifact){expected[i].name, data, expected[i].size};
+    }
+    proxy_stage_receipt *stages = (proxy_stage_receipt *)artifacts[9].data;
+    for (uint32_t i = 0; i < 8u; i++) {
+        stages[i] = (proxy_stage_receipt){
+            .step = i + 1u,
+            .position = 4096u + i,
+            .slot = 4096u + i,
+            .boundary = 1u,
+            .monotonic_ns = 1000001u + i,
+        };
+    }
+    const int rc = ds4_glm_mtp_proxy_publish_contract(
+        argv[1], artifacts,
+        (uint32_t)(sizeof(artifacts) / sizeof(artifacts[0])), NULL);
+    for (size_t i = 0; i < sizeof(artifacts) / sizeof(artifacts[0]); i++) {
+        free((void *)artifacts[i].data);
+    }
+    return rc;
+}
