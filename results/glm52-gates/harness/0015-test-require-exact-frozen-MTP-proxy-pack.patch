+static int reflink_mutation(const char *source, char path[128], off_t offset) {
+    strcpy(path, "/tmp/ds4-glm-mtp-pack-mutation.XXXXXX");
+    int out = mkstemp(path);
+    if (out < 0) return -1;
+    int in = open(source, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (in < 0 || ioctl(out, FICLONE, in) != 0) {
+        if (in >= 0) close(in);
+        close(out);
+        unlink(path);
+        return -1;
+    }
+    close(in);
+    uint8_t value;
+    if (pread(out, &value, 1, offset) != 1) {
+        close(out);
+        unlink(path);
+        return -1;
+    }
+    value ^= 1u;
+    if (pwrite(out, &value, 1, offset) != 1 || fsync(out) != 0) {
+        close(out);
+        unlink(path);
+        return -1;
+    }
+    close(out);
+    return 0;
 }
 
