+    if (g_expert_slab.fd >= 0) (void)close(g_expert_slab.fd);
+    g_expert_slab.fd = -1;
+    g_expert_slab.records.clear();
+    g_expert_slab.by_key.clear();
+    g_expert_slab.file_size = 0;
+    g_expert_slab.model_generation = 0;
+    g_expert_slab.state.store(0);
+}
