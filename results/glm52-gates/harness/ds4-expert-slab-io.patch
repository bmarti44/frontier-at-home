+/* Default-off, byte-identical expert sidecar. The offline builder writes one
+ * 4096-aligned gate|up|down record per (layer, expert), so each miss needs one
+ * O_DIRECT read instead of three distant GGUF reads. Explicit configuration
+ * is fail-closed: a bad header, model identity, index, read, or checksum never
+ * falls back to different bytes. */
+#pragma pack(push, 1)
+typedef struct {
+    uint8_t magic[8];
+    uint32_t version;
+    uint32_t alignment;
+    uint64_t model_size;
+    uint8_t model_probe_sha256[32];
+    uint8_t model_sha256[32];
+    uint32_t record_count;
+    uint32_t record_size;
+    uint64_t data_offset;
+} cuda_expert_slab_header;
+typedef struct {
+    uint32_t layer;
+    uint32_t expert;
+    uint64_t expert_slab_offset;
+    uint64_t payload_bytes;
+    uint64_t gate_bytes;
+    uint64_t down_bytes;
+    uint8_t payload_sha256[32];
+    uint8_t reserved[8];
+} cuda_expert_slab_record;
+#pragma pack(pop)
+static_assert(sizeof(cuda_expert_slab_header) == 104,
+              "expert slab header format drift");
+static_assert(sizeof(cuda_expert_slab_record) == 80,
+              "expert slab record format drift");
+
+static struct {
+    std::atomic<int> state{0}; /* 0 uninitialized, 1 active, 2 off, -1 invalid */
+    int fd = -1;
+    uint64_t file_size;
+    dev_t device;
+    ino_t inode;
+    struct timespec mtime;
+    struct timespec ctime;
+    uint64_t model_generation;
+    cuda_expert_slab_header header;
+    std::vector<cuda_expert_slab_record> records;
+    std::unordered_map<uint64_t, size_t> by_key;
+    std::atomic<uint64_t> reads;
+    std::atomic<uint64_t> bytes;
+    std::atomic<uint64_t> active_readers;
+} g_expert_slab;
+static std::mutex g_expert_slab_init_mu;
+
+typedef struct {
+    std::atomic<uint64_t> reads;
+    std::atomic<uint64_t> logical_bytes;
+    std::atomic<uint64_t> actual_bytes;
+    std::atomic<uint64_t> first_submit_ns;
+    std::atomic<uint64_t> last_complete_ns;
+    std::atomic<uint32_t> in_flight;
+    std::atomic<uint32_t> peak_in_flight;
+} cuda_expert_slab_window;
+
+static uint64_t cuda_expert_slab_align_up(uint64_t value, uint64_t alignment) {
+    if (alignment == 0 || value > UINT64_MAX - (alignment - 1)) return 0;
+    return (value + alignment - 1) / alignment * alignment;
+}
+
+static uint64_t cuda_expert_slab_now_ns(void) {
+    struct timespec ts;
+    if (clock_gettime(CLOCK_MONOTONIC_RAW, &ts) != 0) return 0;
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+static int cuda_expert_slab_hex(const char *text, uint8_t out[32]) {
+    if (!text || strlen(text) != 64) return 0;
+    for (int i = 0; i < 32; i++) {
+        int hi, lo;
+        const char a = text[i * 2], b = text[i * 2 + 1];
+        hi = a >= '0' && a <= '9' ? a - '0' :
+             (a >= 'a' && a <= 'f' ? a - 'a' + 10 : -1);
+        lo = b >= '0' && b <= '9' ? b - '0' :
+             (b >= 'a' && b <= 'f' ? b - 'a' + 10 : -1);
+        if (hi < 0 || lo < 0) return 0;
+        out[i] = (uint8_t)((hi << 4) | lo);
+    }
+    return 1;
+}
+
+static int cuda_expert_slab_stable(const struct stat *a,
+                                   const struct stat *b) {
+    return a && b && a->st_dev == b->st_dev && a->st_ino == b->st_ino &&
+           a->st_size == b->st_size &&
+           a->st_mtim.tv_sec == b->st_mtim.tv_sec &&
+           a->st_mtim.tv_nsec == b->st_mtim.tv_nsec &&
+           a->st_ctim.tv_sec == b->st_ctim.tv_sec &&
+           a->st_ctim.tv_nsec == b->st_ctim.tv_nsec;
+}
+
+static int cuda_expert_slab_hash_direct_fd(int regular_fd,
+                                           uint64_t file_size,
+                                           uint64_t align,
+                                           uint8_t out[32]) {
+#if defined(__linux__) && defined(O_DIRECT)
+    if (regular_fd < 0 || file_size == 0 || align < 512 ||
+        (align & (align - 1u)) != 0 || align > (8u << 20)) {
+        return 0;
+    }
+    char proc_path[64];
+    snprintf(proc_path, sizeof(proc_path), "/proc/self/fd/%d", regular_fd);
+    const int direct_fd = open(proc_path, O_RDONLY | O_CLOEXEC | O_DIRECT);
+    if (direct_fd < 0) return 0;
+    struct stat regular_before, direct_before;
+    if (fstat(regular_fd, &regular_before) != 0 ||
+        fstat(direct_fd, &direct_before) != 0 ||
+        !S_ISREG(regular_before.st_mode) || regular_before.st_size < 0 ||
+        (uint64_t)regular_before.st_size != file_size ||
+        !cuda_expert_slab_stable(&regular_before, &direct_before)) {
+        (void)close(direct_fd);
+        return 0;
+    }
+    const uint64_t chunk_bytes = cuda_round_up(8u << 20, align);
+    void *raw = NULL;
+    if (posix_memalign(&raw, (size_t)align, (size_t)chunk_bytes) != 0) {
+        (void)close(direct_fd);
+        return 0;
+    }
+    uint8_t *buffer = (uint8_t *)raw;
+    ec_sha256 digest;
+    ec_sha256_init(&digest);
+    uint64_t offset = 0;
+    const uint64_t direct_bytes = cuda_round_down(file_size, align);
+    while (offset < direct_bytes) {
+        const size_t count = (size_t)((direct_bytes - offset) < chunk_bytes ?
+                                     (direct_bytes - offset) : chunk_bytes);
+        if (!cuda_pread_full(direct_fd, buffer, count, offset)) {
+            free(raw);
+            (void)close(direct_fd);
+            return 0;
+        }
+        ec_sha256_update(&digest, buffer, count);
+        offset += count;
+    }
+    if (offset < file_size) {
+        const size_t count = (size_t)(file_size - offset);
+        if (!cuda_pread_full(regular_fd, buffer, count, offset)) {
+            free(raw);
+            (void)close(direct_fd);
+            return 0;
+        }
+        ec_sha256_update(&digest, buffer, count);
+#if defined(POSIX_FADV_DONTNEED)
+        if (posix_fadvise(regular_fd, (off_t)offset, (off_t)count,
+                          POSIX_FADV_DONTNEED) != 0) {
+            free(raw);
+            (void)close(direct_fd);
+            return 0;
+        }
+#endif
+    }
+    ec_sha256_final_bytes(&digest, out);
+    struct stat regular_after, direct_after;
+    const int stable =
+        fstat(regular_fd, &regular_after) == 0 &&
+        fstat(direct_fd, &direct_after) == 0 &&
+        cuda_expert_slab_stable(&regular_before, &regular_after) &&
+        cuda_expert_slab_stable(&regular_before, &direct_after);
+    free(raw);
+    (void)close(direct_fd);
+    return stable;
+#else
+    (void)regular_fd;
+    (void)file_size;
+    (void)align;
+    (void)out;
+    return 0;
+#endif
+}
+
+static int cuda_expert_slab_hash_model_fd(const void *model_map,
+                                          uint64_t model_size,
+                                          uint8_t out[32]) {
+#if defined(__linux__) && defined(O_DIRECT)
+    if (!model_map || model_size == 0 || g_model_fd < 0 ||
+        g_model_direct_fd < 0 || g_model_fd_host_base != model_map ||
+        g_model_file_size != model_size) {
+        return 0;
+    }
+    return cuda_expert_slab_hash_direct_fd(
+        g_model_fd, model_size, g_model_direct_align, out);
+#else
+    (void)model_map;
+    (void)model_size;
+    (void)out;
+    return 0;
+#endif
+}
+
+static void cuda_expert_slab_window_max(std::atomic<uint32_t> *target,
+                                        uint32_t value) {
+    uint32_t current = target->load();
+    while (current < value &&
+           !target->compare_exchange_weak(current, value)) {}
+}
+
+static void cuda_expert_slab_window_min(std::atomic<uint64_t> *target,
+                                        uint64_t value) {
+    uint64_t current = target->load();
+    while ((current == 0 || value < current) &&
+           !target->compare_exchange_weak(current, value)) {}
+}
+
+static void cuda_expert_slab_window_max64(std::atomic<uint64_t> *target,
+                                          uint64_t value) {
+    uint64_t current = target->load();
+    while (current < value &&
+           !target->compare_exchange_weak(current, value)) {}
+}
+
+static void cuda_expert_slab_model_probe(const void *model_map,
+                                         uint64_t model_size,
+                                         uint8_t out[32]) {
+    const uint64_t probe_bytes = 1u << 20;
+    const uint64_t first = model_size < probe_bytes ? model_size : probe_bytes;
+    ec_sha256 digest;
+    ec_sha256_init(&digest);
+    ec_sha256_update(&digest, &model_size, sizeof(model_size));
+    ec_sha256_update(&digest, model_map, (size_t)first);
+    if (model_size > probe_bytes) {
+        ec_sha256_update(&digest,
+                         (const uint8_t *)model_map + model_size - probe_bytes,
+                         (size_t)probe_bytes);
+    }
+    ec_sha256_final_bytes(&digest, out);
+}
+
+static int cuda_expert_slab_fail(const char *reason) {
+    const int previous = g_expert_slab.state.exchange(-1);
+    if (previous == -1) return -1;
+    /* An active fd may still be inside another worker's pread. Never close it
+     * here: closing and reusing the descriptor number would let that worker
+     * read an unrelated file. The process owns this one fd until teardown. */
+    if (previous == 0 && g_expert_slab.fd >= 0) {
+        (void)close(g_expert_slab.fd);
+        g_expert_slab.fd = -1;
+    }
+    fprintf(stderr, "ds4: CUDA contiguous expert slab disabled: %s\n",
+            reason ? reason : "invalid sidecar");
+    return -1;
+}
+
+static int cuda_expert_slab_init(const ds4_gpu_stream_expert_table *table) {
+    std::lock_guard<std::mutex> lock(g_expert_slab_init_mu);
+    const int current_state = g_expert_slab.state.load();
+    if (current_state != 0) {
+        if (current_state == 1 &&
+            g_expert_slab.model_generation != g_model_load_generation) {
+            return cuda_expert_slab_fail("model load generation changed");
+        }
+        return current_state == 1 ? 1 : (current_state == 2 ? 0 : -1);
+    }
+    g_expert_slab.fd = -1;
+    const char *path = getenv("DS4_CUDA_EXPERT_SLAB_PATH");
+    if (!path || !path[0]) {
+        g_expert_slab.state.store(2);
+        fprintf(stderr, "ds4: CUDA contiguous expert slab disabled (default)\n");
+        return 0;
+    }
+    if (!table || !table->model_map || table->model_size == 0) {
+        return cuda_expert_slab_fail("missing model identity");
+    }
+    uint8_t expected_slab[32], expected_model[32];
+    const char *slab_sha = getenv("DS4_CUDA_EXPERT_SLAB_SHA256");
+    const char *model_sha = getenv("DS4_CUDA_EXPERT_SLAB_MODEL_SHA256");
+    if (!cuda_expert_slab_hex(slab_sha, expected_slab) ||
+        !cuda_expert_slab_hex(model_sha, expected_model)) {
+        return cuda_expert_slab_fail("missing or malformed frozen digest");
+    }
+    int open_flags = O_RDONLY | O_CLOEXEC;
+#if defined(O_NOFOLLOW)
+    open_flags |= O_NOFOLLOW;
+#endif
+    int index_fd = open(path, open_flags);
+    if (index_fd < 0) return cuda_expert_slab_fail("open failed");
+    struct stat st, after_hash;
+    if (fstat(index_fd, &st) != 0 || !S_ISREG(st.st_mode) ||
+        (st.st_mode & 022) != 0 || st.st_size < 0 ||
+        (uint64_t)st.st_size < sizeof(cuda_expert_slab_header) ||
+        !cuda_pread_full(index_fd, &g_expert_slab.header,
+                         sizeof(g_expert_slab.header), 0)) {
+        (void)close(index_fd);
+        return cuda_expert_slab_fail("header read failed");
+    }
+    const cuda_expert_slab_header &h = g_expert_slab.header;
+    const uint8_t magic[8] = {'G','L','M','5','2','S','L','B'};
+    if (memcmp(h.magic, magic, sizeof(magic)) != 0 || h.version != 2 ||
+        h.alignment != 4096 || h.record_size != sizeof(cuda_expert_slab_record) ||
+        h.record_count == 0 || h.record_count > 80u * 256u ||
+        h.model_size != table->model_size) {
+        (void)close(index_fd);
+        return cuda_expert_slab_fail("header or model size mismatch");
+    }
+    const uint64_t index_bytes =
+        (uint64_t)h.record_count * sizeof(cuda_expert_slab_record);
+    const uint64_t expected_data = cuda_expert_slab_align_up(
+        sizeof(cuda_expert_slab_header) + index_bytes, h.alignment);
+    if (expected_data == 0 || h.data_offset != expected_data ||
+        h.data_offset > (uint64_t)st.st_size) {
+        (void)close(index_fd);
+        return cuda_expert_slab_fail("index geometry mismatch");
+    }
+    uint8_t probe[32];
+    cuda_expert_slab_model_probe(table->model_map, table->model_size, probe);
+    if (memcmp(probe, h.model_probe_sha256, sizeof(probe)) != 0) {
+        (void)close(index_fd);
+        fprintf(stderr, "ds4: expert slab model identity mismatch\n");
+        return cuda_expert_slab_fail("model identity mismatch");
+    }
+    if (memcmp(expected_model, h.model_sha256, sizeof(expected_model)) != 0) {
+        (void)close(index_fd);
+        return cuda_expert_slab_fail("frozen full-model identity mismatch");
+    }
+    uint8_t actual_model[32];
+    struct stat model_before;
+    if (g_model_fd < 0 || fstat(g_model_fd, &model_before) != 0 ||
+        !S_ISREG(model_before.st_mode) || model_before.st_size < 0 ||
+        (uint64_t)model_before.st_size != table->model_size ||
+        !cuda_expert_slab_hash_model_fd(table->model_map, table->model_size,
+                                        actual_model) ||
+        memcmp(expected_model, actual_model, sizeof(expected_model)) != 0) {
+        (void)close(index_fd);
+        return cuda_expert_slab_fail("direct full-model identity mismatch");
+    }
+    struct stat model_after;
+    if (fstat(g_model_fd, &model_after) != 0 ||
+        !cuda_expert_slab_stable(&model_before, &model_after)) {
+        (void)close(index_fd);
+        return cuda_expert_slab_fail("model changed during identity hash");
+    }
+    fprintf(stderr,
+            "ds4: expert slab full-model identity verified via O_DIRECT "
+            "bytes=%llu\n", (unsigned long long)table->model_size);
+    uint8_t actual_slab[32];
+    if (!cuda_expert_slab_hash_direct_fd(
+            index_fd, (uint64_t)st.st_size, h.alignment, actual_slab) ||
+        fstat(index_fd, &after_hash) != 0 ||
+        !cuda_expert_slab_stable(&st, &after_hash) ||
+        memcmp(expected_slab, actual_slab, sizeof(expected_slab)) != 0) {
+        (void)close(index_fd);
+        return cuda_expert_slab_fail("frozen full-sidecar identity mismatch");
+    }
+    fprintf(stderr,
+            "ds4: expert slab full-sidecar identity verified via O_DIRECT "
+            "bytes=%llu\n", (unsigned long long)st.st_size);
+    try {
+        g_expert_slab.records.resize(h.record_count);
+        g_expert_slab.by_key.reserve((size_t)h.record_count * 2u);
+    } catch (...) {
+        (void)close(index_fd);
+        return cuda_expert_slab_fail("index allocation failed");
+    }
+    if (!cuda_pread_full(index_fd, g_expert_slab.records.data(), index_bytes,
+                         sizeof(cuda_expert_slab_header))) {
+        (void)close(index_fd);
+        return cuda_expert_slab_fail("index read failed");
+    }
+    struct stat after_index;
+    if (fstat(index_fd, &after_index) != 0 ||
+        !cuda_expert_slab_stable(&st, &after_index)) {
+        (void)close(index_fd);
+        return cuda_expert_slab_fail("sidecar changed during index load");
+    }
+    (void)close(index_fd);
+    g_expert_slab.file_size = (uint64_t)st.st_size;
+    for (size_t i = 0; i < g_expert_slab.records.size(); i++) {
+        const cuda_expert_slab_record &r = g_expert_slab.records[i];
+        const uint64_t key = ((uint64_t)r.layer << 32) | r.expert;
+        const uint64_t read_bytes = cuda_expert_slab_align_up(
+            r.payload_bytes, h.alignment);
+        uint8_t reserved_or = 0;
+        for (size_t j = 0; j < sizeof(r.reserved); j++) reserved_or |= r.reserved[j];
+        if (r.layer >= 80u || r.expert >= 256u || reserved_or != 0 ||
+            r.gate_bytes > (UINT64_MAX - r.down_bytes) / 2u ||
+            r.expert_slab_offset < h.data_offset ||
+            r.expert_slab_offset % h.alignment != 0 || read_bytes == 0 ||
+            r.expert_slab_offset > g_expert_slab.file_size ||
+            read_bytes > g_expert_slab.file_size - r.expert_slab_offset ||
+            r.payload_bytes != 2u * r.gate_bytes + r.down_bytes ||
+            !g_expert_slab.by_key.emplace(key, i).second) {
+            return cuda_expert_slab_fail("invalid or duplicate index record");
+        }
+    }
+#if defined(__linux__) && defined(O_DIRECT)
+    g_expert_slab.fd = open(path, open_flags | O_DIRECT);
+#else
+    g_expert_slab.fd = -1;
+#endif
+    if (g_expert_slab.fd < 0) {
+        return cuda_expert_slab_fail("O_DIRECT open failed");
+    }
+    struct stat direct_st;
+    if (fstat(g_expert_slab.fd, &direct_st) != 0 ||
+        !cuda_expert_slab_stable(&st, &direct_st)) {
+        return cuda_expert_slab_fail("validated/direct descriptor mismatch");
+    }
+    g_expert_slab.device = st.st_dev;
+    g_expert_slab.inode = st.st_ino;
+    g_expert_slab.mtime = st.st_mtim;
+    g_expert_slab.ctime = st.st_ctim;
+    g_expert_slab.model_generation = g_model_load_generation;
+    g_expert_slab.reads.store(0);
+    g_expert_slab.bytes.store(0);
+    g_expert_slab.active_readers.store(0);
+    g_expert_slab.state.store(1);
+    fprintf(stderr,
+            "ds4: CUDA contiguous expert slab enabled records=%u path=%s "
+            "slab_sha256=%.12s model_sha256=%.12s inode=%llu\n",
+            h.record_count, path, slab_sha, model_sha,
+            (unsigned long long)st.st_ino);
+    return 1;
+}
+
+static int cuda_expert_slab_read(uint32_t layer, uint32_t expert,
+                                 uint64_t gate_bytes, uint64_t down_bytes,
+                                 void *buffer, uint64_t buffer_bytes,
+                                 const uint8_t **payload_out,
+                                 cuda_expert_slab_window *window,
+                                 int worker_id) {
+    if (g_expert_slab.state.load() != 1) return 0;
+    g_expert_slab.active_readers.fetch_add(1);
+    if (g_expert_slab.state.load() != 1) {
+        g_expert_slab.active_readers.fetch_sub(1);
+        return 0;
+    }
+    auto release_reader = []() { g_expert_slab.active_readers.fetch_sub(1); };
+    const uint64_t key = ((uint64_t)layer << 32) | expert;
