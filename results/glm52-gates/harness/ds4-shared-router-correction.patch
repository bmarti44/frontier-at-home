+static bool glm_union_probe_dump_triplet(
+        ds4_gpu_tensor *norm,
+        ds4_gpu_tensor *logits,
+        ds4_gpu_tensor *selected,
+        const float    *bias,
+        uint32_t        n_tokens,
+        uint32_t        il,
+        uint32_t        pos) {
+    const char *norm_name = "glm_indexed_ffn_norm";
+    const char *logits_name = "glm_indexed_router_logits";
+    const char *selected_name = "glm_indexed_router_selected";
+    const char *bias_name = "glm_indexed_router_bias";
+    const bool want_norm = metal_graph_debug_wants(norm_name, il, pos);
+    const bool want_logits = metal_graph_debug_wants(logits_name, il, pos);
+    const bool want_selected = metal_graph_debug_wants(selected_name, il, pos);
+    const bool want_bias = metal_graph_debug_wants(bias_name, il, pos);
+    if (!want_norm && !want_logits && !want_selected && !want_bias) return true;
+    if (!want_norm || !want_logits || !want_selected || !want_bias || !norm || !logits ||
+        !selected || !bias || n_tokens == 0 ||
+        (uint64_t)n_tokens * DS4_N_EMBD > SIZE_MAX / sizeof(float) ||
+        (uint64_t)n_tokens * DS4_N_EXPERT > SIZE_MAX / sizeof(float) ||
+        (uint64_t)n_tokens * DS4_N_EXPERT_USED > SIZE_MAX / sizeof(int32_t)) {
+        fprintf(stderr, "GLM_UNION_TRACE_ERROR stage=validate layer=%u pos=%u\n",
+                il, pos);
+        return false;
+    }
+
+    const size_t norm_bytes =
+        (size_t)n_tokens * DS4_N_EMBD * sizeof(float);
+    const size_t logits_bytes =
+        (size_t)n_tokens * DS4_N_EXPERT * sizeof(float);
+    const size_t selected_bytes =
+        (size_t)n_tokens * DS4_N_EXPERT_USED * sizeof(int32_t);
+    float *norm_buf = xmalloc(norm_bytes);
+    float *logits_buf = xmalloc(logits_bytes);
+    int32_t *selected_buf = xmalloc(selected_bytes);
+
+    const bool ended = ds4_gpu_end_commands() != 0;
+    const bool read_norm = ended &&
+        ds4_gpu_tensor_read(norm, 0, norm_buf, norm_bytes) != 0;
+    const bool read_logits = read_norm &&
+        ds4_gpu_tensor_read(logits, 0, logits_buf, logits_bytes) != 0;
+    const bool read_selected = read_logits &&
+        ds4_gpu_tensor_read(selected, 0, selected_buf, selected_bytes) != 0;
+    const bool restarted = ds4_gpu_begin_commands() != 0;
+    bool ok = ended && read_norm && read_logits && read_selected && restarted;
+
+    char norm_path[1024], logits_path[1024], selected_path[1024], bias_path[1024];
+    const char *prefix = metal_graph_debug_prefix_for(norm_name, il, pos);
+    if (ok) {
+        ok = prefix &&
+            snprintf(norm_path, sizeof(norm_path), "%s_%s-%u_pos%u.f32",
+                     prefix, norm_name, il, pos) < (int)sizeof(norm_path) &&
+            snprintf(logits_path, sizeof(logits_path), "%s_%s-%u_pos%u.f32",
+                     prefix, logits_name, il, pos) < (int)sizeof(logits_path) &&
+            snprintf(selected_path, sizeof(selected_path), "%s_%s-%u_pos%u.i32",
+                     prefix, selected_name, il, pos) < (int)sizeof(selected_path) &&
+            snprintf(bias_path, sizeof(bias_path), "%s_%s-%u_pos%u.f32",
+                     prefix, bias_name, il, pos) < (int)sizeof(bias_path);
+    }
+    if (ok) ok = glm_union_trace_write_exclusive(norm_path, norm_buf, norm_bytes);
+    if (ok) ok = glm_union_trace_write_exclusive(logits_path, logits_buf, logits_bytes);
+    if (ok) ok = glm_union_trace_write_exclusive(selected_path, selected_buf, selected_bytes);
+    if (ok) ok = glm_union_trace_write_exclusive(
+        bias_path, bias, (size_t)DS4_N_EXPERT * sizeof(float));
+    free(selected_buf);
+    free(logits_buf);
+    free(norm_buf);
+
+    if (!ok) {
+        fprintf(stderr,
+                "GLM_UNION_TRACE_ERROR stage=capture layer=%u pos=%u rows=%u\n",
+                il, pos, n_tokens);
+        return false;
+    }
+    fprintf(stderr,
+            "GLM_UNION_TRACE_OK path=full_indexed_batch_ffn layer=%u pos=%u rows=%u\n",
+            il, pos, n_tokens);
+    return true;
+}
