+/* Default-off, fail-closed capture for the R0b union-probe corpus.  A trace
+ * attempt owns a fresh prefix; exclusive atomic publication prevents a later
+ * request from silently replacing an earlier event with the same layer/pos. */
+static bool glm_union_trace_write_exclusive(
+        const char *path, const void *data, size_t nbytes) {
+    char tmp[1100];
+    if (snprintf(tmp, sizeof(tmp), "%s.tmp.%ld", path, (long)getpid()) >=
+        (int)sizeof(tmp)) {
+        return false;
+    }
+    const int fd = open(tmp, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+    if (fd < 0) return false;
+
+    const uint8_t *src = data;
+    size_t off = 0;
+    bool ok = true;
+    while (off < nbytes) {
+        const ssize_t nw = write(fd, src + off, nbytes - off);
+        if (nw < 0 && errno == EINTR) continue;
+        if (nw <= 0) {
+            ok = false;
+            break;
+        }
+        off += (size_t)nw;
+    }
+    if (ok && fsync(fd) != 0) ok = false;
+    if (close(fd) != 0) ok = false;
+    if (ok && link(tmp, path) != 0) ok = false;
+    if (unlink(tmp) != 0 && errno != ENOENT) ok = false;
+    return ok;
+}
