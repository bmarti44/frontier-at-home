diff --git a/ds4_cuda.cu b/ds4_cuda.cu
index bf3672f..1fecac9 100644
--- a/ds4_cuda.cu
+++ b/ds4_cuda.cu
@@ -99,6 +99,83 @@ static uint64_t g_model_direct_align = 1;
  * The persistent expert cache flushes when it observes a new generation —
  * immune to mmap address reuse (sol G4a round-3). */
 static uint64_t g_model_load_generation = 0;
+
+/* The model-map setters below used to bump g_model_load_generation
+ * unconditionally, BEFORE the "same map, nothing changed" early-return.
+ * Every span install (token embedding, static decode, per layer, decode
+ * layer, output head) therefore looked like a model RELOAD, and
+ * cuda_expert_cache_flush_for_model() -- called on every selected-expert
+ * load -- wiped the entire persistent host expert cache. Measured on a
+ * GLM-5.2 serving run: 331 full flushes, hit rate stuck at 20%, resident
+ * slots collapsing 5566 -> 245 mid-request. The cache never got to do its
+ * job. Only bump when the mapping actually changes.
+ *
+ * DS4_CUDA_MODEL_GEN_ALWAYS_BUMP=1 restores the old behaviour so the fix
+ * can be A/B'd from a single binary. */
+static int cuda_model_gen_always_bump(void) {
+    static int v = -1;
+    if (v < 0) v = getenv("DS4_CUDA_MODEL_GEN_ALWAYS_BUMP") != NULL;
+    return v;
+}
+
+/* Model identity for cache-invalidation purposes.
+ *
+ * Pointer+size equality alone is NOT a safe "same model" test (sol review):
+ * a munmap followed by an mmap of a different GGUF can reuse the address and
+ * length, and the persistent expert cache would then serve model A's slabs
+ * for model B -- its lookup only checks (layer, expert) plus tensor offsets,
+ * not content. The prefetch pool has the same exposure through its private
+ * fd. The original unconditional bump avoided all of this by treating every
+ * call as a reload, at the cost of flushing the whole cache on every span
+ * install (measured: 452 flushes in one long-prompt run, cache never warm).
+ *
+ * So identity here is (host pointer, size, GGUF header fingerprint, model
+ * fd). The header hash covers magic, version, tensor count, kv count and the
+ * first metadata entries (name, architecture); the fd catches a re-open of
+ * different backing storage even if the header were somehow identical.
+ * cuda_model_gen_note_fd_change() is called from ds4_gpu_set_model_fd so a
+ * new fd forces a bump on the next setter call.
+ *
+ * DS4_CUDA_MODEL_GEN_ALWAYS_BUMP=1 restores the old always-flush behaviour
+ * for A/B measurement from a single binary. */
+static const void *g_model_gen_last_map = NULL;
+static uint64_t     g_model_gen_last_size = 0;
+static uint64_t     g_model_gen_last_fp = 0;
+static int          g_model_gen_last_fd = -2;   /* -2: nothing observed yet */
+
+static uint64_t cuda_model_map_fingerprint(const void *model_map,
+                                           uint64_t model_size) {
+    if (!model_map || model_size == 0) return 0;
+    const unsigned char *p = (const unsigned char *)model_map;
+    const uint64_t n = model_size < 4096u ? model_size : 4096u;
+    uint64_t h = 1469598103934665603ULL;          /* FNV-1a 64 */
+    for (uint64_t i = 0; i < n; i++) {
+        h ^= (uint64_t)p[i];
+        h *= 1099511628211ULL;
+    }
+    h ^= model_size;
+    h *= 1099511628211ULL;
+    return h ? h : 1ULL;
+}
+
+static void cuda_model_gen_bump_if_changed(const void *model_map,
+                                           uint64_t model_size) {
+    const uint64_t fp = cuda_model_map_fingerprint(model_map, model_size);
+    if (cuda_model_gen_always_bump() ||
+        g_model_gen_last_map != model_map ||
+        g_model_gen_last_size != model_size ||
+        g_model_gen_last_fp != fp ||
+        g_model_gen_last_fd != g_model_fd) {
+        g_model_load_generation++;
+    }
+    /* Shadow state, deliberately NOT g_model_host_base: the setters update
+     * that later and one of them calls another, so reusing it would make the
+     * decision order-dependent and double-bump a genuine change. */
+    g_model_gen_last_map = model_map;
+    g_model_gen_last_size = model_size;
+    g_model_gen_last_fp = fp;
+    g_model_gen_last_fd = g_model_fd;
+}
 static uint64_t g_model_file_size;
 static int g_model_cache_full;
 static cudaStream_t g_model_prefetch_stream;
@@ -3131,7 +3208,7 @@ extern "C" int ds4_gpu_end_commands(void) {
 extern "C" int ds4_gpu_synchronize(void) { return cuda_ok(cudaDeviceSynchronize(), "synchronize"); }
 
 extern "C" int ds4_gpu_set_model_map(const void *model_map, uint64_t model_size) {
-    g_model_load_generation++;
+    cuda_model_gen_bump_if_changed(model_map, model_size);
     if (!model_map || model_size == 0) return 0;
