     if (getenv("DS4_CUDA_COPY_MODEL_CHUNKED") != NULL &&
@@ -3229,7 +3307,7 @@ extern "C" int ds4_gpu_set_model_map_range(const void *model_map, uint64_t model
  * for the host pointer plus cudaHostRegister, but skipping the
