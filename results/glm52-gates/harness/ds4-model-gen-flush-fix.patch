diff --git a/ds4_cuda.cu b/ds4_cuda.cu
index bf3672f..fae4924 100644
--- a/ds4_cuda.cu
+++ b/ds4_cuda.cu
@@ -99,6 +99,32 @@ static uint64_t g_model_direct_align = 1;
  * The persistent expert cache flushes when it observes a new generation —
  * immune to mmap address reuse (sol G4a round-3). */
 static uint64_t g_model_load_generation = 0;
+
+/* The model-map setters below used to bump g_model_load_generation
+ * unconditionally, BEFORE the "same map, nothing changed" early-return.
+ * Every span install (token embedding, static decode, per layer, decode
+ * layer, output head) therefore looked like a model RELOAD, and
+ * cuda_expert_cache_flush_for_model() -- called on every selected-expert
+ * load -- wiped the entire persistent host expert cache. Measured on a
+ * GLM-5.2 serving run: 331 full flushes, hit rate stuck at 20%, resident
+ * slots collapsing 5566 -> 245 mid-request. The cache never got to do its
+ * job. Only bump when the mapping actually changes.
+ *
+ * DS4_CUDA_MODEL_GEN_ALWAYS_BUMP=1 restores the old behaviour so the fix
+ * can be A/B'd from a single binary. */
+static int cuda_model_gen_always_bump(void) {
+    static int v = -1;
+    if (v < 0) v = getenv("DS4_CUDA_MODEL_GEN_ALWAYS_BUMP") != NULL;
+    return v;
+}
+static void cuda_model_gen_bump_if_changed(const void *model_map,
+                                           uint64_t model_size) {
+    if (cuda_model_gen_always_bump() ||
+        g_model_host_base != model_map ||
+        g_model_registered_size != model_size) {
+        g_model_load_generation++;
+    }
+}
 static uint64_t g_model_file_size;
 static int g_model_cache_full;
 static cudaStream_t g_model_prefetch_stream;
@@ -3131,7 +3157,7 @@ extern "C" int ds4_gpu_end_commands(void) {
