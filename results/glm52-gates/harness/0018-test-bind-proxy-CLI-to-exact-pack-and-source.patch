     int out = mkstemp(path);
     if (out < 0) return -1;
     int in = open(source, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
-    if (in < 0 || ioctl(out, FICLONE, in) != 0) {
+    uint8_t header[49152];
+    if (in < 0 || pread(in, header, sizeof(header), 0) != (ssize_t)sizeof(header) ||
+        write(out, header, sizeof(header)) != (ssize_t)sizeof(header)) {
         if (in >= 0) close(in);
         close(out);
         unlink(path);
@@ -391,7 +391,7 @@ static void test_exact_compact_pack_and_mutations(void) {
                                       inventory_sha, &receipt) != 0,
           "wrong expected whole-pack digest accepted");
     char mutation[128];
-    CHECK(reflink_mutation(pack, mutation, 16) == 0,
+    CHECK(short_header_mutation(pack, mutation, 16) == 0,
           "could not create header mutation: %s", strerror(errno));
     CHECK(ds4_glm_mtp_proxy_pack_open(mutation, pack_sha, model_sha,
                                       inventory_sha, &receipt) != 0,
@@ -510,6 +510,8 @@ static void test_default_off_cli_dispatch(void) {
           mode == 1, "complete candidate environment rejected");
     CHECK(ds4_glm_mtp_proxy_cli_contract_select("out", "pack", "state", "router", &mode) == 0 &&
           mode == 1, "known fault stage rejected");
+    CHECK(ds4_glm_mtp_proxy_cli_contract_select("out", "pack", "state", "source", &mode) == 0 &&
+          mode == 1, "source-boundary fault stage rejected");
     CHECK(ds4_glm_mtp_proxy_cli_contract_select("out", "pack", "state", "unknown", &mode) != 0,
           "unknown fault stage accepted");
 }
