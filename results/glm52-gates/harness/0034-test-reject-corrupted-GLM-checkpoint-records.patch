@@ -17126,6 +17126,64 @@ static void test_kv_cache_lookup_rejects_stale_payload_abi(void) {
     rmdir(dir);
 }
 
+static FILE *test_kv_integrity_record(const uint8_t payload[16],
+                                      ds4_kvstore_entry *entry,
+                                      uint32_t *text_bytes) {
+    static const char text[] = "bound prompt";
+    FILE *fp = tmpfile();
+    TEST_ASSERT(fp != NULL);
+    if (!fp) return NULL;
+    uint8_t h[KV_CACHE_FIXED_HEADER];
+    ds4_kvstore_fill_header(h, 1, 2, KV_REASON_COLD, 0, 4, 0,
+                            32768, 100, 100, 16);
+    uint8_t tb[4];
+    le_put32(tb, (uint32_t)(sizeof(text) - 1));
+    TEST_ASSERT(fwrite(h, 1, sizeof(h), fp) == sizeof(h));
+    TEST_ASSERT(fwrite(tb, 1, sizeof(tb), fp) == sizeof(tb));
+    TEST_ASSERT(fwrite(text, 1, sizeof(text) - 1, fp) == sizeof(text) - 1);
+    TEST_ASSERT(fwrite(payload, 1, 16, fp) == 16);
+    TEST_ASSERT(fflush(fp) == 0);
+    TEST_ASSERT(ds4_kvstore_seal_record(fp, (uint32_t)(sizeof(text) - 1), 16));
+    TEST_ASSERT(fseeko(fp, 0, SEEK_SET) == 0);
+    TEST_ASSERT(ds4_kvstore_read_header(fp, entry, text_bytes));
+    TEST_ASSERT(fseeko(fp, (off_t)*text_bytes, SEEK_CUR) == 0);
+    TEST_ASSERT(ds4_kvstore_verify_record(fp, entry, *text_bytes));
+    return fp;
+}
+
+static void test_kv_cache_integrity_rejects_payload_mutations(void) {
+    const uint8_t original[16] = {
+        1, 0, 0, 0, 2, 0, 0, 0, 3, 4, 5, 6, 7, 8, 9, 10,
+    };
+    const uint8_t replacement[16] = {
+        9, 0, 0, 0, 8, 0, 0, 0, 7, 6, 5, 4, 3, 2, 1, 0,
+    };
+    const off_t payload_offset =
+        (off_t)KV_CACHE_FIXED_HEADER + 4 + (off_t)strlen("bound prompt");
+
+    for (int mutation = 0; mutation < 3; mutation++) {
+        ds4_kvstore_entry entry = {0};
+        uint32_t text_bytes = 0;
+        FILE *fp = test_kv_integrity_record(original, &entry, &text_bytes);
+        if (!fp) continue;
+        if (mutation == 0) {
+            TEST_ASSERT(fseeko(fp, payload_offset, SEEK_SET) == 0);
+            TEST_ASSERT(fputc(11, fp) != EOF); /* saved-token byte */
+        } else if (mutation == 1) {
+            TEST_ASSERT(fseeko(fp, payload_offset + 12, SEEK_SET) == 0);
+            TEST_ASSERT(fputc(11, fp) != EOF); /* tensor/state byte */
+        } else {
+            TEST_ASSERT(fseeko(fp, payload_offset, SEEK_SET) == 0);
+            TEST_ASSERT(fwrite(replacement, 1, sizeof(replacement), fp) ==
+                        sizeof(replacement)); /* equal-size payload swap */
+        }
+        TEST_ASSERT(fflush(fp) == 0);
+        TEST_ASSERT(fseeko(fp, payload_offset, SEEK_SET) == 0);
+        TEST_ASSERT(!ds4_kvstore_verify_record(fp, &entry, text_bytes));
+        TEST_ASSERT(fclose(fp) == 0);
+    }
+}
+
