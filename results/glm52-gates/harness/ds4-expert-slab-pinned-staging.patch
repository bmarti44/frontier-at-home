+/* O_DIRECT buffers must also be CUDA page-locked.  Pageable per-layer
+ * buffers make cudaMemcpy perform an implicit registration/staging cycle on
+ * every expert miss; the live RED arm measured 2--9 ms reads inside 50--70 ms
+ * fetch windows.  Retain a small, bounded pool across layer visits instead. */
+static struct {
+    std::mutex mu;
+    std::vector<void *> allocations;
+    std::vector<uint8_t *> buffers;
+    uint64_t buffer_bytes;
+    uint64_t alignment;
+} g_expert_slab_staging;
+
 typedef struct {
     std::atomic<uint64_t> reads;
     std::atomic<uint64_t> logical_bytes;
@@ -23748,6 +23760,55 @@ static uint64_t cuda_expert_slab_align_up(uint64_t value, uint64_t alignment) {
     return (value + alignment - 1) / alignment * alignment;
 }
 
+static void cuda_expert_slab_staging_release(void) {
+    for (void *allocation : g_expert_slab_staging.allocations) {
+        if (allocation) (void)cudaFreeHost(allocation);
+    }
+    g_expert_slab_staging.allocations.clear();
+    g_expert_slab_staging.buffers.clear();
+    g_expert_slab_staging.buffer_bytes = 0;
+    g_expert_slab_staging.alignment = 0;
+}
+
+static int cuda_expert_slab_staging_ensure(uint32_t count,
+                                           uint64_t buffer_bytes,
+                                           uint64_t alignment) {
+    if (count == 0 || count > 32 || buffer_bytes == 0 || alignment < 512 ||
+        (alignment & (alignment - 1u)) != 0 ||
+        buffer_bytes > UINT64_MAX - alignment) {
+        return 0;
+    }
+    if (g_expert_slab_staging.buffers.size() >= count &&
+        g_expert_slab_staging.buffer_bytes >= buffer_bytes &&
+        g_expert_slab_staging.alignment == alignment) {
+        return 1;
+    }
+    cuda_expert_slab_staging_release();
+    try {
+        g_expert_slab_staging.allocations.reserve(count);
+        g_expert_slab_staging.buffers.reserve(count);
+    } catch (...) {
+        cuda_expert_slab_staging_release();
+        return 0;
+    }
+    for (uint32_t i = 0; i < count; i++) {
+        void *allocation = NULL;
+        if (cudaHostAlloc(&allocation, (size_t)(buffer_bytes + alignment),
+                          cudaHostAllocPortable) != cudaSuccess || !allocation) {
+            (void)cudaGetLastError();
+            cuda_expert_slab_staging_release();
+            return 0;
+        }
+        const uintptr_t raw = (uintptr_t)allocation;
+        const uintptr_t aligned = (raw + alignment - 1u) & ~(alignment - 1u);
+        g_expert_slab_staging.allocations.push_back(allocation);
+        g_expert_slab_staging.buffers.push_back((uint8_t *)aligned);
+    }
+    g_expert_slab_staging.buffer_bytes = buffer_bytes;
+    g_expert_slab_staging.alignment = alignment;
+    return 1;
+}
