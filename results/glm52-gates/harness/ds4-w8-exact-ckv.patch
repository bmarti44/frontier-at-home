+static void test_batch_selection_coalesces_records(void) {
+    char path[] = "/tmp/ds4-ckvstore-batch.XXXXXX";
+    int seed_fd = mkstemp(path);
+    CHECK(seed_fd >= 0, "mkstemp batch selection");
+    if (seed_fd < 0) return;
+    close(seed_fd);
+    unlink(path);
+
+    ds4_ckvstore_config cfg = test_config();
+    cfg.max_cached_records = 4;
+    ds4_ckvstore *store = NULL;
+    char err[256] = {0};
+    CHECK(ds4_ckvstore_open(&store, path, &cfg, true, err, sizeof(err)) == 0,
+          "create batched selection fixture");
+    if (!store) goto cleanup;
+
+    uint8_t payload[4 * 8];
+    for (uint32_t first = 0; first < 16; first += 4) {
+        fill_payload(payload, first, 4, 1, 8);
+        CHECK(ds4_ckvstore_put(store, 12, first, 4, 1, payload,
+                               sizeof(payload), err, sizeof(err)) == 0,
+              "append batched selection record");
+    }
+
+    /* Query-major input deliberately revisits every physical record from the
+     * second query.  The acceptance formula is exactly four physical record
+     * reads, rather than four reads per query, while preserving every output
+     * row and duplicate in query-major order. */
+    const uint32_t selected[2][5] = {
+        {0, 4, 8, 12, 0},
+        {1, 5, 9, 13, 1},
+    };
+    uint8_t got[2 * 5 * 8];
+    ds4_ckvstore_stats before = {0}, after = {0};
+    ds4_ckvstore_get_stats(store, &before);
+    CHECK(ds4_ckvstore_read_selected_batch(
+              store, 12, 0, &selected[0][0], 2, 5, got, sizeof(got),
+              err, sizeof(err)) == DS4_CKVSTORE_OK,
+          "read two query selections as one bounded batch");
+    ds4_ckvstore_get_stats(store, &after);
+    CHECK(after.physical_read_bytes - before.physical_read_bytes ==
+              4u * (DS4_CKVSTORE_HEADER_BYTES + sizeof(payload)),
+          "batched queries load each unique physical record once");
+    for (uint32_t query = 0; query < 2; query++) {
+        for (uint32_t slot = 0; slot < 5; slot++) {
+            uint8_t want[8];
+            expected_row(want, 0, selected[query][slot], sizeof(want));
+            CHECK(memcmp(got + ((uint64_t)query * 5u + slot) * 8u,
+                         want, sizeof(want)) == 0,
+                  "batched selection is byte exact and query-major");
+        }
+    }
+
+cleanup:
+    if (store) ds4_ckvstore_close(store);
+    unlink(path);
+}
