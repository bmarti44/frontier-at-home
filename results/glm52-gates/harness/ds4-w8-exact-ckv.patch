+/* Exact W8 direct-slot attention separates the logical token position used
+ * by RoPE from the physical row in the bounded selected-row stage.  The score,
+ * softmax, latent accumulation, and value projection keep the resident F32
+ * path's operation order. */
+template <typename CT>
+__global__ static void glm_attention_decode_weights_direct_kernel(
+        float *weights,
+        float *denom,
+        const float *q,
+        const float *qk_low,
+        const CT *kv_lora_stage,
+        const CT *k_rope_stage,
+        const uint32_t *logical_selected,
+        uint32_t n_selected,
+        uint32_t stage_cap,
+        uint32_t logical_cap,
+        uint32_t n_head,
+        uint32_t kv_lora_dim,
+        uint32_t qk_nope,
+        uint32_t qk_rope,
+        float scale,
+        uint32_t n_ctx_orig,
+        float freq_base,
+        float freq_scale,
+        float ext_factor,
+        float attn_factor,
+        float beta_fast,
+        float beta_slow,
+        bool score_vec2) {
+    const uint32_t head = blockIdx.x;
+    const uint32_t tid = threadIdx.x;
+    const uint32_t nth = blockDim.x;
+    if (head >= n_head || n_selected == 0u) return;
+    const uint32_t qk_dim = qk_nope + qk_rope;
+    extern __shared__ float sh[];
+    float *red = sh;
+    float *scores = sh + 256u;
+    const float *qh = q + (uint64_t)head * qk_dim;
+    const float *low = qk_low + (uint64_t)head * kv_lora_dim;
+    float corr_dims[2] = {0.0f, 0.0f};
+    if (ext_factor != 0.0f) {
+        corr_dims[0] = fmaxf(0.0f,
+            floorf(glm_rope_yarn_corr_factor_dev((int)qk_rope,
+                    (int)n_ctx_orig, beta_fast, freq_base)));
+        corr_dims[1] = fminf((float)qk_rope - 1.0f,
+            ceilf(glm_rope_yarn_corr_factor_dev((int)qk_rope,
+                    (int)n_ctx_orig, beta_slow, freq_base)));
+    }
+    float local_max = -FLT_MAX;
+    for (uint32_t s = tid; s < n_selected; s += nth) {
+        const uint32_t logical_row = logical_selected[s];
+        const uint32_t physical_row = s;
+        float score = -FLT_MAX;
+        if (logical_row < logical_cap && physical_row < stage_cap) {
+            float dotv = 0.0f;
+            const uint64_t lora_base =
+                (uint64_t)physical_row * kv_lora_dim;
+            if (score_vec2) {
+                for (uint32_t j = 0; j < kv_lora_dim; j += 2u) {
+                    const float2 x = *(const float2 *)(low + j);
+                    const float2 y = glm_cache_value_pair_dev(
+                        kv_lora_stage + lora_base + j);
+                    dotv += x.x * y.x;
+                    dotv += x.y * y.y;
+                }
+            } else {
+                for (uint32_t j = 0; j < kv_lora_dim; j++) {
+                    dotv += low[j] *
+                        (float)kv_lora_stage[lora_base + j];
+                }
+            }
+            const uint64_t rope_base =
+                (uint64_t)physical_row * qk_rope;
+            for (uint32_t r = 0; r < qk_rope; r += 2u) {
+                const float2 y = glm_cache_rope_pair_f16_dev<CT>(
+                    k_rope_stage, rope_base, r, logical_row, qk_rope,
+                    freq_base, freq_scale, ext_factor, attn_factor,
+                    corr_dims);
+                dotv += qh[qk_nope + r] * y.x +
+                        qh[qk_nope + r + 1u] * y.y;
+            }
+            score = dotv * scale;
+        }
+        scores[s] = score;
+        local_max = fmaxf(local_max, score);
+    }
+    red[tid] = local_max;
+    __syncthreads();
+    for (uint32_t step = nth >> 1; step > 0; step >>= 1) {
+        if (tid < step) red[tid] = fmaxf(red[tid], red[tid + step]);
+        __syncthreads();
+    }
+    const float max_score = red[0];
+    __syncthreads();
+    float local_sum = 0.0f;
+    for (uint32_t s = tid; s < n_selected; s += nth) {
+        const float w = expf(scores[s] - max_score);
+        scores[s] = w;
+        local_sum += w;
+    }
+    red[tid] = local_sum;
+    __syncthreads();
+    for (uint32_t step = nth >> 1; step > 0; step >>= 1) {
+        if (tid < step) red[tid] += red[tid + step];
+        __syncthreads();
+    }
+    if (tid == 0u) denom[head] = fmaxf(red[0], 1.0e-20f);
+    float *head_weights = weights + (uint64_t)head * n_selected;
+    for (uint32_t s = tid; s < n_selected; s += nth) {
+        head_weights[s] = scores[s];
+    }
+}
+
+template <typename CT>
+__global__ static void glm_attention_decode_lora_direct_kernel(
+        float *lora_sum,
+        const float *scores,
+        const float *denom,
+        const CT *kv_lora_stage,
+        uint32_t n_selected,
+        uint32_t stage_cap,
+        uint32_t n_head,
+        uint32_t kv_lora_dim) {
+    const uint32_t head = blockIdx.y;
+    const uint32_t pair = blockIdx.x * blockDim.x + threadIdx.x;
+    const uint32_t j = pair * 2u;
+    if (head >= n_head || j >= kv_lora_dim) return;
+    const float *head_scores = scores + (uint64_t)head * n_selected;
+    float acc0 = 0.0f;
+    float acc1 = 0.0f;
+    for (uint32_t s = 0; s < n_selected && s < stage_cap; s++) {
+        const float2 v = glm_cache_value_pair_dev(
+            kv_lora_stage + (uint64_t)s * kv_lora_dim + j);
+        const float w = head_scores[s];
+        acc0 += w * v.x;
+        acc1 += w * v.y;
+    }
+    float *out = lora_sum + (uint64_t)head * kv_lora_dim + j;
+    out[0] = acc0 / denom[head];
+    out[1] = acc1 / denom[head];
+}
+
