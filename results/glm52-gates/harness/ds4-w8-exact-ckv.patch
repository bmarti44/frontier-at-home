+static void test_indexed_lookup_cost(void) {
+    char path[] = "/tmp/ds4-ckvstore-index.XXXXXX";
+    int seed_fd = mkstemp(path);
+    CHECK(seed_fd >= 0, "mkstemp index");
+    if (seed_fd < 0) return;
+    close(seed_fd);
+    unlink(path);
+
+    ds4_ckvstore_config cfg = test_config();
+    cfg.rows_per_record = 1;
+    cfg.max_cached_records = 2;
+    ds4_ckvstore *store = NULL;
+    char err[256] = {0};
+    CHECK(ds4_ckvstore_open(&store, path, &cfg, true, err, sizeof(err)) == 0,
+          "create indexed lookup fixture");
+    if (!store) goto cleanup;
+
+    uint8_t payload[8];
+    for (uint32_t row = 0; row < 257; row++) {
+        fill_payload(payload, row, 1, 1, sizeof(payload));
+        CHECK(ds4_ckvstore_put(store, 11, row, 1, 1, payload,
+                               sizeof(payload), err, sizeof(err)) == 0,
+              "append ordered indexed record");
+    }
+    const uint32_t selected[] = {256, 128, 0, 255};
+    uint8_t got[sizeof(selected) / sizeof(selected[0]) * sizeof(payload)];
+    CHECK(ds4_ckvstore_read_selected(store, 11, 0, selected, 4, got,
+                                     sizeof(got), err, sizeof(err)) == 0,
+          "look up dispersed rows through epoch index");
+    ds4_ckvstore_stats stats = {0};
+    ds4_ckvstore_get_stats(store, &stats);
+    CHECK(stats.lookup_comparisons > 0,
+          "lookup comparison accounting is production-derived");
+    CHECK(stats.lookup_comparisons <= 40,
+          "dispersed lookup cost is logarithmic, not a full-record scan");
+
+cleanup:
+    if (store) ds4_ckvstore_close(store);
+    unlink(path);
+}
