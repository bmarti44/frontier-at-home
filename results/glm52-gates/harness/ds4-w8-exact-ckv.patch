+#include "ds4_gpu.h"
+
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(c, m) do { if (!(c)) {                                        \
+    fprintf(stderr, "FAIL: %s (line %d)\n", (m), __LINE__); goto cleanup;  \
+} } while (0)
+
+static void make_q8(uint8_t *model, uint32_t rows, uint32_t cols) {
+    for (uint32_t row = 0; row < rows; row++) {
+        for (uint32_t block = 0; block < cols / 32u; block++) {
+            uint8_t *dst = model +
+                ((uint64_t)row * (cols / 32u) + block) * 34u;
+            const uint16_t one = 0x3c00u;
+            memcpy(dst, &one, 2);
+            for (uint32_t i = 0; i < 32; i++) {
+                ((int8_t *)(dst + 2))[i] =
+                    (int8_t)((int)((row * 3u + block + i) % 7u) - 3);
+            }
+        }
+    }
+}
+
+int main(void) {
+    const uint32_t cap = 4096, nsel = 2048, latent = 512, rope = 64;
+    const uint32_t q_nope = 64, q_dim = q_nope + rope;
+    const uint32_t nhead = 1, value_dim = 4;
+    const uint64_t latent_bytes = (uint64_t)cap * latent * sizeof(float);
+    const uint64_t rope_bytes = (uint64_t)cap * rope * sizeof(float);
+    const uint64_t stage_bytes = (uint64_t)nsel * latent * sizeof(float);
+    const uint64_t stage_rope_bytes = (uint64_t)nsel * rope * sizeof(float);
+    const uint64_t model_bytes = (uint64_t)value_dim * (latent / 32u) * 34u;
+    float *resident = malloc((size_t)latent_bytes);
+    float *ropes = malloc((size_t)rope_bytes);
+    float *stage = malloc((size_t)stage_bytes);
+    float *stage_ropes = malloc((size_t)stage_rope_bytes);
+    float *q = calloc(q_dim, sizeof(float));
+    float *low = calloc(latent, sizeof(float));
+    uint32_t *ids = calloc(nsel, sizeof(uint32_t));
+    uint8_t *model = calloc((size_t)model_bytes, 1);
+    float baseline[4] = {0}, direct[4] = {0};
+    int rc = 1;
+    ds4_gpu_tensor *resident_t = NULL, *rope_t = NULL, *stage_t = NULL;
+    ds4_gpu_tensor *stage_rope_t = NULL, *short_t = NULL, *q_t = NULL;
+    ds4_gpu_tensor *low_t = NULL, *ids_t = NULL, *base_t = NULL;
+    ds4_gpu_tensor *direct_t = NULL;
+
+    CHECK(resident && ropes && stage && stage_ropes && q && low && ids && model,
+          "host allocations");
+    for (uint32_t row = 0; row < cap; row++) {
+        for (uint32_t i = 0; i < latent; i++) {
+            resident[(uint64_t)row * latent + i] =
+                (float)((int)((row * 19u + i * 11u) % 113u) - 56) / 37.0f;
+        }
+        for (uint32_t i = 0; i < rope; i++) {
+            ropes[(uint64_t)row * rope + i] =
+                (float)((int)((row * 7u + i * 5u) % 67u) - 33) / 29.0f;
+        }
+    }
+    for (uint32_t i = 0; i < q_dim; i++) q[i] = (float)((int)(i % 17u) - 8) / 31.0f;
+    for (uint32_t i = 0; i < latent; i++) low[i] = (float)((int)((i * 13u) % 43u) - 21) / 47.0f;
+    for (uint32_t i = 0; i < nsel; i++) ids[i] = (i * 2053u + 17u) % cap;
+    ids[0] = cap - 1u; ids[1] = 0u; ids[2] = 64u; ids[127] = ids[0];
+    for (uint32_t slot = 0; slot < nsel; slot++) {
+        memcpy(stage + (uint64_t)slot * latent,
+               resident + (uint64_t)ids[slot] * latent,
+               latent * sizeof(float));
+        memcpy(stage_ropes + (uint64_t)slot * rope,
+               ropes + (uint64_t)ids[slot] * rope,
+               rope * sizeof(float));
+    }
+    make_q8(model, value_dim, latent);
+
+    CHECK(ds4_gpu_init(), "CUDA init");
+    CHECK(ds4_gpu_set_model_map(model, model_bytes), "model map");
+    resident_t = ds4_gpu_tensor_alloc(latent_bytes);
+    rope_t = ds4_gpu_tensor_alloc(rope_bytes);
+    stage_t = ds4_gpu_tensor_alloc(stage_bytes);
+    stage_rope_t = ds4_gpu_tensor_alloc(stage_rope_bytes);
+    short_t = ds4_gpu_tensor_alloc(stage_bytes - 1u);
+    q_t = ds4_gpu_tensor_alloc(q_dim * sizeof(float));
+    low_t = ds4_gpu_tensor_alloc(latent * sizeof(float));
+    ids_t = ds4_gpu_tensor_alloc(nsel * sizeof(uint32_t));
+    base_t = ds4_gpu_tensor_alloc(value_dim * sizeof(float));
+    direct_t = ds4_gpu_tensor_alloc(value_dim * sizeof(float));
+    CHECK(resident_t && rope_t && stage_t && stage_rope_t && short_t && q_t &&
+          low_t && ids_t && base_t && direct_t, "device allocations");
+    CHECK(ds4_gpu_tensor_write(resident_t, 0, resident, latent_bytes) &&
+          ds4_gpu_tensor_write(rope_t, 0, ropes, rope_bytes) &&
+          ds4_gpu_tensor_write(stage_t, 0, stage, stage_bytes) &&
+          ds4_gpu_tensor_write(stage_rope_t, 0, stage_ropes, stage_rope_bytes) &&
+          ds4_gpu_tensor_write(q_t, 0, q, q_dim * sizeof(float)) &&
+          ds4_gpu_tensor_write(low_t, 0, low, latent * sizeof(float)) &&
+          ds4_gpu_tensor_write(ids_t, 0, ids, nsel * sizeof(uint32_t)),
+          "fixture uploads");
+    CHECK(ds4_gpu_glm_attention_indexed_decode_typed_tensor(
+          base_t, q_t, low_t, resident_t, rope_t, model, model_bytes, 0, 8,
+          ids_t, nsel, cap, false, nhead, latent, q_nope, rope, value_dim,
+          0, 8000000.f, 1.f, 0.f, 1.f, 32.f, 1.f), "resident reference");
+    CHECK(ds4_gpu_glm_attention_indexed_decode_direct_typed_tensor(
+          direct_t, q_t, low_t, stage_t, stage_rope_t, model, model_bytes,
+          0, 8, ids_t, ids, nsel, nsel, cap, false, nhead, latent, q_nope, rope,
+          value_dim, 0, 8000000.f, 1.f, 0.f, 1.f, 32.f, 1.f),
+          "exact direct slots");
+    CHECK(ds4_gpu_synchronize() &&
+          ds4_gpu_tensor_read(base_t, 0, baseline, sizeof(baseline)) &&
+          ds4_gpu_tensor_read(direct_t, 0, direct, sizeof(direct)), "outputs");
+    CHECK(memcmp(baseline, direct, sizeof(baseline)) == 0,
+          "byte-identical output with logical RoPE positions");
+    for (uint32_t i = 0; i < value_dim; i++) CHECK(isfinite(direct[i]), "finite output");
+    CHECK(!ds4_gpu_glm_attention_indexed_decode_direct_typed_tensor(
+          direct_t, q_t, low_t, short_t, stage_rope_t, model, model_bytes,
+          0, 8, ids_t, ids, nsel, nsel, cap, false, nhead, latent, q_nope, rope,
+          value_dim, 0, 8000000.f, 1.f, 0.f, 1.f, 32.f, 1.f),
+          "undersized stage rejected");
+    ids[17] = cap;
+    CHECK(ds4_gpu_tensor_write(ids_t, 0, ids, nsel * sizeof(uint32_t)), "invalid ID upload");
+    CHECK(!ds4_gpu_glm_attention_indexed_decode_direct_typed_tensor(
+          direct_t, q_t, low_t, stage_t, stage_rope_t, model, model_bytes,
+          0, 8, ids_t, ids, nsel, nsel, cap, false, nhead, latent, q_nope, rope,
+          value_dim, 0, 8000000.f, 1.f, 0.f, 1.f, 32.f, 1.f),
+          "invalid logical ID rejected");
+    rc = 0;
+cleanup:
+    ds4_gpu_tensor_free(resident_t); ds4_gpu_tensor_free(rope_t);
+    ds4_gpu_tensor_free(stage_t); ds4_gpu_tensor_free(stage_rope_t);
+    ds4_gpu_tensor_free(short_t); ds4_gpu_tensor_free(q_t);
+    ds4_gpu_tensor_free(low_t); ds4_gpu_tensor_free(ids_t);
+    ds4_gpu_tensor_free(base_t); ds4_gpu_tensor_free(direct_t);
+    ds4_gpu_cleanup();
+    free(resident); free(ropes); free(stage); free(stage_ropes);
+    free(q); free(low); free(ids); free(model);
+    if (!rc) fprintf(stderr, "test_glm_ckv_exact_direct_cuda: PASS\n");
+    return rc;
+}
diff --git a/tests/test_glm_ckv_exact_source.py b/tests/test_glm_ckv_exact_source.py
new file mode 100644
index 0000000..24dd5fd
--- /dev/null
+++ b/tests/test_glm_ckv_exact_source.py
@@ -0,0 +1,95 @@
+#!/usr/bin/env python3
+"""Production-path contract for exact, default-off GLM cKV offload.
+
+Acceptance is deliberately representation-free: when enabled, the graph must
+write the unmodified F32 latent and RoPE rows to a checksummed request store,
+keep the full indexer resident, retrieve the exact top-k row IDs in their
+original order (including duplicates), and run attention from a bounded
+2,048-row stage.  When disabled, allocation and execution remain the reviewed
+resident W7 path.  Runtime unit and model-backed tests prove the byte equality;
+this guard binds those properties to the production call graph.
+"""
+
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE = (ROOT / "ds4.c").read_text(encoding="utf-8")
+MAKEFILE = (ROOT / "Makefile").read_text(encoding="utf-8")
+
+
+def require(label: str, needle: str, haystack: str = SOURCE) -> None:
+    assert needle in haystack, f"missing production behavior: {label}"
+
+
+require("exact default-off environment gate", 'getenv("DS4_GLM_CKV_NVME_EXACT")')
+require("exact graph mode", "bool ckv_nvme_exact;")
+require("checksummed request store", "ds4_ckvstore *ckv_store;")
+require("bounded exact write stage", "ckv_exact_write_rows")
+require("bounded exact selected stage", "ckv_exact_selected_rows")
+require("2,048-row physical stage", "DS4_GLM_CKV_EXACT_SELECTED_CAP 2048u")
+require("exact F32 format binding", '"glm-ckv-exact-f32-v1"')
+require("selected-row store read", "ds4_ckvstore_read_selected")
+require("selected IDs copied without normalization", "ckv_selected_ids_host")
+require("production selected-row staging", "glm_graph_stage_ckv_exact_selected")
+require("request lineage rotation", "glm_graph_ckv_exact_reset_lineage")
+require("persistent pinned host staging", "ds4_gpu_host_alloc_pinned")
+require("pinned staging ownership", "ckv_io_host_pinned")
+require("store linked into every backend", "ds4_ckvstore.o", MAKEFILE)
+require("one-million exact store default", "uint64_t gib = 192u;")
+require("row-store index memory admission", "ckv_record_index_bytes")
+require("row-store tail memory admission", "ckv_tail_memory_bytes")
+require("request success telemetry", "ds4: W8 exact request complete")
+require("appended-row counter", "ckv_appended_rows")
+require("selected-row counter", "ckv_selected_rows")
+require("direct-slot invocation counter", "ckv_direct_slot_calls")
+require("checksum validation telemetry", "checksum_validations")
+
+assert re.search(
+    r"if \(!g->ckv_nvme_exact\) \{\s*"
+    r"DS4_GLM_GRAPH_ALLOC_TENSOR_TIER\(g->layer_kv_lora_cache\[il\]",
+    SOURCE,
+), "resident exact cKV allocation is not gated off in NVMe mode"
+
+assert re.search(
+    r"glm_graph_store_ckv_exact_rows\([^;]+\).*?"
+    r"ds4_ckvstore_put\(",
+    SOURCE,
+    re.S,
+), "production F32 rows do not reach the checksummed request store"
+
+assert re.search(
+    r"glm_graph_stage_ckv_exact_selected\([^;]+\).*?"
+    r"ds4_gpu_glm_attention_indexed_decode_direct_typed_tensor",
+    SOURCE,
+    re.S,
+), "indexed attention is not fed by the bounded exact selected-row stage"
+
+CUDA_SOURCE = (ROOT / "ds4_cuda.cu").read_text(encoding="utf-8")
+direct_start = CUDA_SOURCE.index(
+    'extern "C" int ds4_gpu_glm_attention_indexed_decode_direct_typed_tensor'
+)
+direct_end = CUDA_SOURCE.index(
+    'extern "C" int ds4_gpu_glm_build_kv_cache_flash_tensor',
+    direct_start,
+)
+direct_body = CUDA_SOURCE[direct_start:direct_end]
+assert "const uint32_t       *logical_selected_host" in direct_body, (
+    "exact direct-slot validation does not consume the staged host IDs"
+)
+assert "cudaMemcpy" not in direct_body, (
+    "exact direct-slot validation repeats a synchronous selected-ID readback"
+)
+
+# Exact W8 is fidelity-free.  Its format declaration and row-store bridge must
+# never silently inherit the retired affine/int8 representation.
+exact_section = SOURCE[
+    SOURCE.index("glm_graph_ckv_exact_open") :
+    SOURCE.index("glm_graph_ckv_exact_reset_lineage")
+]
+for forbidden in ("affine", "int8", "e4m3", "fp4"):
+    assert forbidden not in exact_section.lower(), (
+        f"lossy representation leaked into exact cKV bridge: {forbidden}"
+    )
+
+print("test_glm_ckv_exact_source: PASS")
diff --git a/tests/test_glm_ckvstore.c b/tests/test_glm_ckvstore.c
new file mode 100644
index 0000000..eb40db7
--- /dev/null
+++ b/tests/test_glm_ckvstore.c
@@ -0,0 +1,690 @@
+#include "ds4_ckvstore.h"
+
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static int failed;
+
+#define CHECK(cond, msg) do {                                                \
+    if (!(cond)) {                                                           \
+        fprintf(stderr, "FAIL: %s (line %d)\n", (msg), __LINE__);          \
+        failed++;                                                            \
+    }                                                                        \
+} while (0)
+
+static void fill_payload(uint8_t *dst, uint32_t first_row,
+                         uint32_t rows, uint16_t layers, uint32_t row_bytes) {
+    for (uint16_t layer = 0; layer < layers; layer++) {
+        for (uint32_t row = 0; row < rows; row++) {
+            for (uint32_t byte = 0; byte < row_bytes; byte++) {
+                *dst++ = (uint8_t)(17u * layer + 7u * (first_row + row) + byte);
+            }
+        }
+    }
+}
+
+static void expected_row(uint8_t *dst, uint16_t layer, uint32_t row,
+                         uint32_t row_bytes) {
+    for (uint32_t byte = 0; byte < row_bytes; byte++)
+        dst[byte] = (uint8_t)(17u * layer + 7u * row + byte);
+}
+
+static ds4_ckvstore_config test_config(void) {
+    ds4_ckvstore_config cfg = {
+        .row_bytes = 8,
+        .rows_per_record = 4,
+        .max_cached_records = 1,
+        .max_epochs = 4,
+        .generation = 7,
+        .max_file_bytes = 1024 * 1024,
+        .sync_interval_bytes =
+            2u * (DS4_CKVSTORE_HEADER_BYTES + 3u * 4u * 8u),
+    };
+    for (size_t i = 0; i < sizeof(cfg.model_binding); i++) {
+        cfg.model_binding[i] = (uint8_t)(0x10 + i);
+        cfg.format_binding[i] = (uint8_t)(0x80 + i);
+    }
+    for (size_t i = 0; i < sizeof(cfg.session_id); i++)
+        cfg.session_id[i] = (uint8_t)(0x40 + i);
+    return cfg;
+}
+
+static void test_cache_is_partitioned_by_epoch(void) {
+    char path[] = "/tmp/ds4-ckvstore-cache-partition.XXXXXX";
+    int seed_fd = mkstemp(path);
+    CHECK(seed_fd >= 0, "mkstemp cache partition");
+    if (seed_fd < 0) return;
+    close(seed_fd);
+    unlink(path);
+    ds4_ckvstore_config cfg = test_config();
+    cfg.rows_per_record = 1;
+    cfg.max_cached_records = 1;
+    cfg.max_epochs = 2;
+    ds4_ckvstore *store = NULL;
+    char err[256] = {0};
+    CHECK(ds4_ckvstore_open(&store, path, &cfg, true, err, sizeof(err)) == 0,
+          "create partitioned cache fixture");
+    if (!store) goto cleanup;
+    uint8_t row[8];
+    fill_payload(row, 0, 1, 1, sizeof(row));
+    CHECK(ds4_ckvstore_put(store, 20, 0, 1, 1, row, sizeof(row),
+                           err, sizeof(err)) == 0,
+          "write first layer block");
+    fill_payload(row, 0, 1, 1, sizeof(row));
+    CHECK(ds4_ckvstore_put(store, 21, 0, 1, 1, row, sizeof(row),
+                           err, sizeof(err)) == 0,
+          "write second layer block");
+    const uint32_t selected[] = {0};
+    uint8_t output[8];
+    CHECK(ds4_ckvstore_read_selected(store, 20, 0, selected, 1, output,
+                                     sizeof(output), err, sizeof(err)) == 0,
+          "warm first layer block");
+    CHECK(ds4_ckvstore_read_selected(store, 21, 0, selected, 1, output,
+                                     sizeof(output), err, sizeof(err)) == 0,
+          "warm second layer block");
+    ds4_ckvstore_stats before = {0}, after = {0};
+    ds4_ckvstore_get_stats(store, &before);
+    CHECK(ds4_ckvstore_read_selected(store, 20, 0, selected, 1, output,
+                                     sizeof(output), err, sizeof(err)) == 0,
+          "revisit first layer block");
+    ds4_ckvstore_get_stats(store, &after);
+    CHECK(after.cache_hits == before.cache_hits + 1,
+          "another layer cannot evict this layer's cache partition");
+    CHECK(after.physical_read_bytes == before.physical_read_bytes,
+          "partitioned cache avoids a repeated physical read");
+cleanup:
+    if (store) ds4_ckvstore_close(store);
+    unlink(path);
+}
+
+static void test_buffered_decode_tail(void) {
+    char path[] = "/tmp/ds4-ckvstore-tail.XXXXXX";
+    int seed_fd = mkstemp(path);
+    CHECK(seed_fd >= 0, "mkstemp buffered tail");
+    if (seed_fd < 0) return;
+    close(seed_fd);
+    unlink(path);
+    ds4_ckvstore_config cfg = test_config();
+    cfg.rows_per_record = 4;
+    cfg.max_epochs = 2;
+    cfg.buffer_tail_rows = true;
+    ds4_ckvstore *store = NULL;
+    char err[256] = {0};
+    CHECK(ds4_ckvstore_open(&store, path, &cfg, true, err, sizeof(err)) == 0,
+          "create buffered-tail fixture");
+    if (!store) goto cleanup;
+    uint8_t rows[4 * 8];
+    fill_payload(rows, 0, 3, 1, 8);
+    CHECK(ds4_ckvstore_put(store, 30, 0, 3, 1, rows, 3 * 8,
+                           err, sizeof(err)) == 0,
+          "buffer partial prefill tail");
+    ds4_ckvstore_stats stats = {0};
+    ds4_ckvstore_get_stats(store, &stats);
+    CHECK(stats.records == 0 && stats.pending_rows == 3,
+          "partial tail is bounded in memory without a short disk record");
+    CHECK(stats.pending_row_bytes == 3 * 8,
+          "pending tail memory is measured exactly");
+    const uint32_t selected_tail[] = {2, 0, 2};
+    uint8_t output[3 * 8];
+    CHECK(ds4_ckvstore_read_selected(store, 30, 0, selected_tail, 3,
+                                     output, sizeof(output), err,
+                                     sizeof(err)) == 0,
+          "pending tail rows are immediately selectable");
+    ds4_ckvstore_get_stats(store, &stats);
+    CHECK(stats.physical_read_bytes == 0,
+          "pending tail selection performs no physical read");
+    for (uint32_t i = 0; i < 3; i++) {
+        uint8_t want[8];
+        expected_row(want, 0, selected_tail[i], sizeof(want));
+        CHECK(memcmp(output + i * 8, want, 8) == 0,
+              "pending tail selection remains byte exact");
+    }
+    fill_payload(rows, 3, 1, 1, 8);
+    CHECK(ds4_ckvstore_put(store, 30, 3, 1, 1, rows, 8,
+                           err, sizeof(err)) == 0,
+          "append decode row to partial tail");
+    ds4_ckvstore_get_stats(store, &stats);
+    CHECK(stats.records == 1 && stats.pending_rows == 0,
+          "full tail publishes one immutable checksummed record");
+    const uint32_t selected_full[] = {3, 1};
+    CHECK(ds4_ckvstore_read_selected(store, 30, 0, selected_full, 2,
+                                     output, 2 * 8, err, sizeof(err)) == 0,
+          "flushed tail remains selectable");
+cleanup:
+    if (store) ds4_ckvstore_close(store);
+    unlink(path);
+}
+
+static void test_production_width_buffered_prefill(void) {
+    enum { PREFILL_ROWS = 4096, EXTRA_ROWS = 65, ROW_BYTES = 8 };
+    char path[] = "/tmp/ds4-ckvstore-prefill-width.XXXXXX";
+    int seed_fd = mkstemp(path);
+    CHECK(seed_fd >= 0, "mkstemp production-width prefill");
+    if (seed_fd < 0) return;
+    close(seed_fd);
+    unlink(path);
+    ds4_ckvstore_config cfg = test_config();
+    cfg.rows_per_record = 64;
+    cfg.max_cached_records = 64;
+    cfg.max_epochs = 1;
+    cfg.sync_interval_bytes = cfg.max_file_bytes;
+    cfg.buffer_tail_rows = true;
+    ds4_ckvstore *store = NULL;
+    uint8_t *payload = malloc((PREFILL_ROWS + EXTRA_ROWS) * ROW_BYTES);
+    char err[256] = {0};
+    CHECK(payload != NULL, "allocate production-width payload");
+    CHECK(ds4_ckvstore_open(&store, path, &cfg, true, err, sizeof(err)) == 0,
+          "create production-width prefill fixture");
+    if (!store || !payload) goto cleanup;
+
+    fill_payload(payload, 0, PREFILL_ROWS, 1, ROW_BYTES);
+    const int prefill_rc = ds4_ckvstore_put(
+        store, 44, 0, PREFILL_ROWS, 1, payload,
+        PREFILL_ROWS * ROW_BYTES, err, sizeof(err));
+    CHECK(prefill_rc == 0,
+          "split one 4096-row production prefill call into records");
+    if (prefill_rc != 0) goto cleanup;
+    ds4_ckvstore_stats stats = {0};
+    ds4_ckvstore_get_stats(store, &stats);
+    CHECK(stats.records == PREFILL_ROWS / cfg.rows_per_record &&
+              stats.pending_rows == 0,
+          "production prefill publishes ordered 64-row records");
+
+    const uint32_t boundary_rows[] = {0, 63, 64, 2047, 2048, 4095, 64};
+    uint8_t output[sizeof(boundary_rows) / sizeof(boundary_rows[0]) * ROW_BYTES];
+    CHECK(ds4_ckvstore_read_selected(
+              store, 44, 0, boundary_rows,
+              (uint32_t)(sizeof(boundary_rows) / sizeof(boundary_rows[0])),
+              output, sizeof(output), err, sizeof(err)) == 0,
+          "read exact rows across split-record boundaries and duplicates");
+    for (uint32_t i = 0;
+         i < sizeof(boundary_rows) / sizeof(boundary_rows[0]); i++) {
+        uint8_t want[ROW_BYTES];
+        expected_row(want, 0, boundary_rows[i], ROW_BYTES);
+        CHECK(memcmp(output + (size_t)i * ROW_BYTES, want, ROW_BYTES) == 0,
+              "production prefill boundary row remains byte exact");
+    }
+
+    fill_payload(payload, PREFILL_ROWS, EXTRA_ROWS, 1, ROW_BYTES);
+    CHECK(ds4_ckvstore_put(store, 44, PREFILL_ROWS, EXTRA_ROWS, 1, payload,
+                           EXTRA_ROWS * ROW_BYTES, err, sizeof(err)) == 0,
+          "split full records while retaining one bounded decode tail row");
+    ds4_ckvstore_get_stats(store, &stats);
+    CHECK(stats.records == PREFILL_ROWS / cfg.rows_per_record + 1 &&
+              stats.pending_rows == 1,
+          "production-width append leaves only the incomplete tail resident");
+    const uint32_t tail_rows[] = {4095, 4096, 4159, 4160, 4160};
+    CHECK(ds4_ckvstore_read_selected(
+              store, 44, 0, tail_rows,
+              (uint32_t)(sizeof(tail_rows) / sizeof(tail_rows[0])),
+              output, sizeof(tail_rows) / sizeof(tail_rows[0]) * ROW_BYTES,
+              err, sizeof(err)) == 0,
+          "read both immutable records and the pending tail");
+    for (uint32_t i = 0; i < sizeof(tail_rows) / sizeof(tail_rows[0]); i++) {
+        uint8_t want[ROW_BYTES];
+        expected_row(want, 0, tail_rows[i], ROW_BYTES);
+        CHECK(memcmp(output + (size_t)i * ROW_BYTES, want, ROW_BYTES) == 0,
+              "split prefill and pending-tail reads remain byte exact");
+    }
+
+cleanup:
+    free(payload);
+    if (store) ds4_ckvstore_close(store);
+    unlink(path);
+}
+
+static void test_dynamic_exact_selected_rows(void) {
+    char path[] = "/tmp/ds4-ckvstore-test.XXXXXX";
+    int seed_fd = mkstemp(path);
+    CHECK(seed_fd >= 0, "mkstemp");
+    if (seed_fd < 0) return;
+    close(seed_fd);
+    unlink(path);
+
+    ds4_ckvstore_config cfg = test_config();
+    ds4_ckvstore *store = NULL;
+    char err[256] = {0};
+    CHECK(ds4_ckvstore_open(&store, path, &cfg, true, err, sizeof(err)) ==
+              DS4_CKVSTORE_OK,
+          "create dynamic request store");
+    if (!store) goto cleanup;
+
+    uint8_t payload[3 * 4 * 8];
+    fill_payload(payload, 0, 4, 3, 8);
+    CHECK(ds4_ckvstore_put(store, 2, 0, 4, 3, payload, sizeof(payload),
+                           err, sizeof(err)) == DS4_CKVSTORE_OK,
+          "append first request-owned record");
+    static const uint8_t expected_sha256[32] = {
+        0x37,0xce,0x45,0xb7,0x21,0xb2,0x52,0x1a,
+        0x68,0x27,0x1c,0xe1,0x71,0x35,0x63,0x68,
+        0x75,0xb8,0xe4,0x90,0x3a,0xa7,0xeb,0x8f,
+        0xc3,0x3e,0xed,0x8d,0x64,0x57,0x15,0xce,
+    };
+    int verify_fd = open(path, O_RDONLY);
+    uint8_t stored_sha256[32];
+    CHECK(verify_fd >= 0, "open record for public SHA-256 vector");
+    if (verify_fd >= 0) {
+        CHECK(pread(verify_fd, stored_sha256, sizeof(stored_sha256), 152) ==
+                  (ssize_t)sizeof(stored_sha256),
+              "read payload SHA-256");
+        CHECK(memcmp(stored_sha256, expected_sha256,
+                     sizeof(expected_sha256)) == 0,
+              "payload digest matches the public SHA-256 algorithm");
+        close(verify_fd);
+    }
+    fill_payload(payload, 4, 4, 3, 8);
+    CHECK(ds4_ckvstore_put(store, 2, 4, 4, 3, payload, sizeof(payload),
+                           err, sizeof(err)) == DS4_CKVSTORE_OK,
+          "grow store with context");
+    fill_payload(payload, 8, 1, 3, 8);
+    CHECK(ds4_ckvstore_put(store, 2, 8, 1, 3, payload, 3 * 8,
+                           err, sizeof(err)) == DS4_CKVSTORE_OK,
+          "append first decode row after a prefill block");
+    fill_payload(payload, 9, 1, 3, 8);
+    CHECK(ds4_ckvstore_put(store, 2, 9, 1, 3, payload, 3 * 8,
+                           err, sizeof(err)) == DS4_CKVSTORE_OK,
+          "append unaligned decode row without rewriting prior records");
+
+    const uint32_t selected[] = {6, 1, 6, 4, 0};
+    uint8_t got[sizeof(selected) / sizeof(selected[0]) * 8];
+    CHECK(ds4_ckvstore_read_selected(store, 2, 1, selected, 5, got,
+                                     sizeof(got), err, sizeof(err)) ==
+              DS4_CKVSTORE_OK,
+          "read selected rows across records");
+    for (size_t i = 0; i < 5; i++) {
+        uint8_t want[8];
+        expected_row(want, 1, selected[i], sizeof(want));
+        CHECK(memcmp(got + i * sizeof(want), want, sizeof(want)) == 0,
+              "selection order and duplicates are byte exact");
+    }
+
+    ds4_ckvstore_stats stats = {0};
+    ds4_ckvstore_get_stats(store, &stats);
+    CHECK(stats.records == 4, "file grows only with written context records");
+    CHECK(stats.cache_records <= 1, "resident block cache obeys hard bound");
+    CHECK(stats.cache_bytes <= sizeof(payload), "resident bytes obey hard bound");
+    CHECK(stats.physical_read_bytes ==
+              2u * (DS4_CKVSTORE_HEADER_BYTES + 3u * 4u * 8u),
+          "one selection reads each required record exactly once");
+    CHECK(stats.sync_calls == 1,
+          "bounded group commit replaces per-record durability barriers");
+    CHECK(stats.pending_write_bytes < cfg.sync_interval_bytes,
+          "unsynchronized write bytes stay below the configured bound");
+
+    const uint32_t absent[] = {10};
+    CHECK(ds4_ckvstore_read_selected(store, 2, 0, absent, 1, got, 8,
+                                     err, sizeof(err)) ==
+              DS4_CKVSTORE_ERR_NOT_FOUND,
+          "unwritten context row fails closed");
+    ds4_ckvstore_close(store);
+    store = NULL;
+
+    struct stat st;
+    CHECK(stat(path, &st) == 0, "stat request store");
+    CHECK((st.st_mode & 0777) == 0600, "request cache is owner-only");
+
+    CHECK(ds4_ckvstore_open(&store, path, &cfg, false, err, sizeof(err)) ==
+              DS4_CKVSTORE_OK,
+          "reopen durable request store");
+    CHECK(ds4_ckvstore_read_selected(store, 2, 2, selected, 5, got,
+                                     sizeof(got), err, sizeof(err)) ==
+              DS4_CKVSTORE_OK,
+          "durable index reconstructs exact rows");
+    ds4_ckvstore_close(store);
+    store = NULL;
+
+    ds4_ckvstore_config stale = cfg;
+    stale.generation++;
+    CHECK(ds4_ckvstore_open(&store, path, &stale, false, err, sizeof(err)) ==
+              DS4_CKVSTORE_ERR_IDENTITY,
+          "stale request generation cannot be reopened");
+    CHECK(store == NULL, "identity mismatch returns no usable store");
+
+cleanup:
+    if (store) ds4_ckvstore_close(store);
+    unlink(path);
+}
