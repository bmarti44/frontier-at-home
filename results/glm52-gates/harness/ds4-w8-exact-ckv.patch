+static void test_request_file_lifecycle(void) {
+    char dir[] = "/tmp/ds4-ckvstore-requests.XXXXXX";
+    CHECK(mkdtemp(dir) != NULL, "create private request directory");
+    if (access(dir, F_OK) != 0) return;
+    CHECK(chmod(dir, 0700) == 0, "set private request directory mode");
+
+    ds4_ckvstore_config first_cfg = test_config();
+    ds4_ckvstore_config second_cfg = test_config();
+    second_cfg.session_id[0] ^= 0x5a;
+    ds4_ckvstore *first = NULL, *second = NULL;
+    char first_path[512] = {0}, second_path[512] = {0}, err[256] = {0};
+    CHECK(ds4_ckvstore_create_request(&first, dir, &first_cfg,
+                                      first_path, sizeof(first_path),
+                                      err, sizeof(err)) == DS4_CKVSTORE_OK,
+          "create first isolated request file");
+    CHECK(ds4_ckvstore_create_request(&second, dir, &second_cfg,
+                                      second_path, sizeof(second_path),
+                                      err, sizeof(err)) == DS4_CKVSTORE_OK,
+          "create concurrent isolated request file");
+    CHECK(first && second, "both concurrent request stores are usable");
+    CHECK(strcmp(first_path, second_path) != 0,
+          "request lineage produces a unique file name");
+    CHECK(access(first_path, F_OK) != 0 && access(second_path, F_OK) != 0,
+          "request stores are unlinked immediately after their owners open them");
+
+    ds4_ckvstore_close(first);
+    first = NULL;
+    CHECK(access(first_path, F_OK) != 0,
+          "normal close removes the first request file");
+    CHECK(access(second_path, F_OK) != 0,
+          "another live request remains anonymous after its peer closes");
+    ds4_ckvstore_close(second);
+    second = NULL;
+    CHECK(access(second_path, F_OK) != 0,
+          "normal close removes the second request file");
+
+    CHECK(chmod(dir, 0755) == 0, "make request directory unsafe");
+    CHECK(ds4_ckvstore_create_request(&first, dir, &first_cfg,
+                                      first_path, sizeof(first_path),
+                                      err, sizeof(err)) == DS4_CKVSTORE_ERR_IO,
+          "shared request directory fails closed");
+    CHECK(first == NULL, "unsafe directory publishes no store");
+    CHECK(chmod(dir, 0700) == 0, "restore directory for cleanup");
+    CHECK(rmdir(dir) == 0, "request directory has no leaked files");
+}
