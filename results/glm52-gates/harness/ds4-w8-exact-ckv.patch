+extern "C" int ds4_gpu_glm_attention_indexed_decode_direct_typed_tensor(
+        ds4_gpu_tensor       *heads,
+        const ds4_gpu_tensor *q,
+        const ds4_gpu_tensor *qk_low,
+        const ds4_gpu_tensor *staged_kv_lora,
+        const ds4_gpu_tensor *staged_k_rope,
+        const void           *model_map,
+        uint64_t              model_size,
+        uint64_t              value_weight_offset,
+        uint32_t              value_weight_type,
+        const ds4_gpu_tensor *logical_selected,
+        const uint32_t       *logical_selected_host,
+        uint32_t              n_selected,
+        uint32_t              stage_cap,
+        uint32_t              logical_cap,
+        bool                  cache_f16,
+        uint32_t              n_head,
+        uint32_t              kv_lora_dim,
+        uint32_t              qk_nope,
+        uint32_t              qk_rope,
+        uint32_t              value_dim,
+        uint32_t              n_ctx_orig,
+        float                 freq_base,
+        float                 freq_scale,
+        float                 ext_factor,
+        float                 attn_factor,
+        float                 beta_fast,
+        float                 beta_slow) {
+    const uint32_t qk_dim = qk_nope + qk_rope;
+    const uint64_t cache_elem = cache_f16 ? sizeof(__half) : sizeof(float);
+    if (!heads || !q || !qk_low || !staged_kv_lora || !staged_k_rope ||
+        !model_map || !logical_selected || !logical_selected_host ||
+        value_weight_type != 8u ||
+        n_selected == 0u || n_selected > 2048u || stage_cap < n_selected ||
+        logical_cap == 0u || n_head == 0u || kv_lora_dim == 0u ||
+        (kv_lora_dim & 31u) != 0u || qk_nope == 0u || qk_rope == 0u ||
+        (qk_rope & 1u) != 0u || value_dim == 0u ||
+        heads->bytes < (uint64_t)n_head * value_dim * sizeof(float) ||
+        q->bytes < (uint64_t)n_head * qk_dim * sizeof(float) ||
+        qk_low->bytes < (uint64_t)n_head * kv_lora_dim * sizeof(float) ||
+        staged_kv_lora->bytes <
+            (uint64_t)stage_cap * kv_lora_dim * cache_elem ||
+        staged_k_rope->bytes <
+            (uint64_t)stage_cap * qk_rope * cache_elem ||
+        logical_selected->bytes <
+            (uint64_t)n_selected * sizeof(uint32_t)) {
+        return 0;
+    }
+    const uint64_t value_row_bytes =
+        ((uint64_t)kv_lora_dim / 32u) * 34u;
+    const uint64_t value_weight_bytes =
+        (uint64_t)n_head * value_dim * value_row_bytes;
+    if (value_weight_offset > model_size ||
+        value_weight_bytes > model_size - value_weight_offset) {
+        return 0;
+    }
+    for (uint32_t i = 0; i < n_selected; i++) {
+        if (logical_selected_host[i] >= logical_cap) {
+            fprintf(stderr,
+                    "ds4: GLM exact direct-slot row %u exceeds cap %u\n",
+                    logical_selected_host[i], logical_cap);
+            return 0;
+        }
+    }
+    const int logical_tier = cuda_current_tier();
+    const char *vw = cuda_resolve_weight_ptr(
+        model_map, value_weight_offset, value_weight_bytes, logical_tier,
+        "glm_v_b_exact_direct_slot");
+    if (!vw) return 0;
+    const uint64_t score_count = (uint64_t)n_head * n_selected;
+    const uint64_t lora_count = (uint64_t)n_head * kv_lora_dim;
+    if (score_count > UINT64_MAX - n_head - lora_count ||
+        score_count + n_head + lora_count > UINT64_MAX / sizeof(float)) {
+        return 0;
+    }
+    const uint64_t scratch_bytes =
+        (score_count + n_head + lora_count) * sizeof(float);
+    float *scratch = (float *)cuda_tmp_alloc_on(
+        ds4_tensor_device_idx(heads), scratch_bytes,
+        "glm exact direct-slot attention");
+    if (!scratch) return 0;
+    float *denom = scratch + score_count;
+    float *lora_sum = denom + n_head;
+    const float scale = 1.0f / sqrtf((float)qk_dim);
+    const bool score_vec2 = getenv("DS4_GLM_ATTN_NO_SCORE_VEC2") == NULL;
+    const uint32_t weight_shmem =
+        (256u + n_selected) * (uint32_t)sizeof(float);
+    if (cache_f16) {
+        glm_attention_decode_weights_direct_kernel<__half>
+            <<<n_head, 256, weight_shmem>>>(
+                scratch, denom, (const float *)q->ptr,
+                (const float *)qk_low->ptr,
+                (const __half *)staged_kv_lora->ptr,
+                (const __half *)staged_k_rope->ptr,
+                (const uint32_t *)logical_selected->ptr, n_selected,
+                stage_cap, logical_cap, n_head, kv_lora_dim, qk_nope,
+                qk_rope, scale, n_ctx_orig, freq_base, freq_scale,
+                ext_factor, attn_factor, beta_fast, beta_slow, score_vec2);
+    } else {
+        glm_attention_decode_weights_direct_kernel<float>
+            <<<n_head, 256, weight_shmem>>>(
+                scratch, denom, (const float *)q->ptr,
+                (const float *)qk_low->ptr,
+                (const float *)staged_kv_lora->ptr,
+                (const float *)staged_k_rope->ptr,
+                (const uint32_t *)logical_selected->ptr, n_selected,
+                stage_cap, logical_cap, n_head, kv_lora_dim, qk_nope,
+                qk_rope, scale, n_ctx_orig, freq_base, freq_scale,
+                ext_factor, attn_factor, beta_fast, beta_slow, score_vec2);
+    }
+    if (!cuda_ok(cudaGetLastError(),
+                 "glm exact direct-slot weights launch")) return 0;
+    const dim3 lora_grid((kv_lora_dim / 2u + 63u) / 64u, n_head, 1u);
+    if (cache_f16) {
+        glm_attention_decode_lora_direct_kernel<__half><<<lora_grid, 64>>>(
+            lora_sum, scratch, denom,
+            (const __half *)staged_kv_lora->ptr, n_selected, stage_cap,
+            n_head, kv_lora_dim);
+    } else {
+        glm_attention_decode_lora_direct_kernel<float><<<lora_grid, 64>>>(
+            lora_sum, scratch, denom,
+            (const float *)staged_kv_lora->ptr, n_selected, stage_cap,
+            n_head, kv_lora_dim);
+    }
+    if (!cuda_ok(cudaGetLastError(),
+                 "glm exact direct-slot lora launch")) return 0;
+    const dim3 value_grid((value_dim + 127u) / 128u, n_head, 1u);
+    glm_attention_decode_value_staged_kernel<false><<<value_grid, 128>>>(
+        (float *)heads->ptr, lora_sum, vw, n_head, kv_lora_dim, value_dim,
+        (uint32_t)value_row_bytes);
+    return cuda_ok(cudaGetLastError(),
+                   "glm exact direct-slot value launch");
+}
