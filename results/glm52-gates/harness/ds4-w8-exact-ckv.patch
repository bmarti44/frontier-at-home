+#include "ds4_ckvstore.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#ifndef O_CLOEXEC
+#define O_CLOEXEC 0
+#endif
+#ifndef O_NOFOLLOW
+#define O_NOFOLLOW 0
+#endif
+
+#define CKV_VERSION 1u
+#define CKV_PAYLOAD_DIGEST_OFFSET 152u
+#define CKV_HEADER_DIGEST_OFFSET 184u
+#define CKV_DIGEST_BYTES 32u
+
+static const uint8_t ckv_magic[8] = {'D','S','4','C','K','V','1',0};
+
+typedef struct {
+    uint32_t epoch;
+    uint32_t first_row;
+    uint32_t row_count;
+    uint16_t layer_count;
+    uint64_t offset;
+    uint64_t payload_bytes;
+} ckv_record;
+
+typedef struct {
+    size_t record_index;
+    uint8_t *payload;
+    uint64_t last_use;
+    bool valid;
+} ckv_cache_entry;
+
+typedef struct {
+    uint32_t epoch;
+    size_t cache_base;
+    size_t *record_ids;
+    size_t count;
+    size_t capacity;
+    uint32_t tail_first_row;
+    uint32_t tail_row_count;
+    uint8_t *tail_payload;
+} ckv_epoch_index;
+
+typedef struct {
+    size_t record_index;
+    uint32_t output_index;
+    uint32_t row;
+} ckv_selection_item;
+
+struct ds4_ckvstore {
+    int fd;
+    int cleanup_dirfd;
+    char *cleanup_name;
+    ds4_ckvstore_config config;
+    ckv_record *records;
+    size_t record_count;
+    size_t record_capacity;
+    ckv_epoch_index *epochs;
+    size_t epoch_count;
+    size_t epoch_capacity;
+    ckv_cache_entry *cache;
+    size_t cache_capacity;
+    uint64_t use_clock;
+    uint64_t file_bytes;
+    uint64_t cache_hits;
+    uint64_t cache_misses;
+    uint64_t lookup_comparisons;
+    uint64_t sync_calls;
+    uint64_t pending_write_bytes;
+    uint64_t last_advised_offset;
+    uint64_t physical_read_bytes;
+    uint64_t checksum_validations;
+    uint64_t checksum_failures;
+    uint64_t selected_rows;
+    bool failed;
+};
+
+static void set_error(char *err, size_t err_len, const char *fmt, ...) {
+    if (!err || err_len == 0) return;
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(err, err_len, fmt, ap);
+    va_end(ap);
+}
+
+static void put16(uint8_t *p, uint16_t v) {
+    p[0] = (uint8_t)v;
+    p[1] = (uint8_t)(v >> 8);
+}
+
+static uint16_t get16(const uint8_t *p) {
+    return (uint16_t)p[0] | ((uint16_t)p[1] << 8);
+}
+
+static void put32(uint8_t *p, uint32_t v) {
+    for (int i = 0; i < 4; i++) p[i] = (uint8_t)(v >> (8 * i));
+}
+
+static uint32_t get32(const uint8_t *p) {
+    uint32_t v = 0;
+    for (int i = 3; i >= 0; i--) v = (v << 8) | p[i];
+    return v;
+}
+
+static void put64(uint8_t *p, uint64_t v) {
+    for (int i = 0; i < 8; i++) p[i] = (uint8_t)(v >> (8 * i));
+}
+
+static uint64_t get64(const uint8_t *p) {
+    uint64_t v = 0;
+    for (int i = 7; i >= 0; i--) v = (v << 8) | p[i];
+    return v;
+}
+
+static bool mul_u64(uint64_t a, uint64_t b, uint64_t *out) {
+    if (a != 0 && b > UINT64_MAX / a) return false;
+    *out = a * b;
+    return true;
+}
+
+/* Small dependency-free SHA-256 used to bind immutable record metadata and
+ * payload bytes. Disk fields are encoded explicitly; no C struct is persisted. */
+typedef struct {
+    uint32_t h[8];
+    uint64_t bits;
+    uint8_t block[64];
+    size_t used;
+} sha256_ctx;
+
+static uint32_t ror32(uint32_t v, unsigned n) {
+    return (v >> n) | (v << (32 - n));
+}
+
+static void sha256_transform(sha256_ctx *c, const uint8_t b[64]) {
+    static const uint32_t k[64] = {
+        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
+    };
+    uint32_t w[64];
+    for (int i = 0; i < 16; i++)
+        w[i] = ((uint32_t)b[4*i] << 24) | ((uint32_t)b[4*i+1] << 16) |
+               ((uint32_t)b[4*i+2] << 8) | b[4*i+3];
+    for (int i = 16; i < 64; i++) {
+        uint32_t s0 = ror32(w[i-15],7) ^ ror32(w[i-15],18) ^ (w[i-15] >> 3);
+        uint32_t s1 = ror32(w[i-2],17) ^ ror32(w[i-2],19) ^ (w[i-2] >> 10);
+        w[i] = w[i-16] + s0 + w[i-7] + s1;
+    }
+    uint32_t a=c->h[0], d=c->h[3], e=c->h[4], f=c->h[5], g=c->h[6], h=c->h[7];
+    uint32_t bb=c->h[1], cc=c->h[2];
+    for (int i = 0; i < 64; i++) {
+        uint32_t s1=ror32(e,6)^ror32(e,11)^ror32(e,25);
+        uint32_t ch=(e&f)^((~e)&g);
+        uint32_t t1=h+s1+ch+k[i]+w[i];
+        uint32_t s0=ror32(a,2)^ror32(a,13)^ror32(a,22);
+        uint32_t maj=(a&bb)^(a&cc)^(bb&cc);
+        uint32_t t2=s0+maj;
+        h=g; g=f; f=e; e=d+t1; d=cc; cc=bb; bb=a; a=t1+t2;
+    }
+    c->h[0]+=a; c->h[1]+=bb; c->h[2]+=cc; c->h[3]+=d;
+    c->h[4]+=e; c->h[5]+=f; c->h[6]+=g; c->h[7]+=h;
+}
+
+static void sha256_init(sha256_ctx *c) {
+    static const uint32_t initial[8] = {
+        0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,
+        0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19
+    };
+    memcpy(c->h, initial, sizeof(initial));
+    c->bits = 0;
+    c->used = 0;
+}
+
+static void sha256_update(sha256_ctx *c, const void *data, size_t len) {
+    const uint8_t *p = data;
+    c->bits += (uint64_t)len * 8;
+    while (len) {
+        size_t n = 64 - c->used;
+        if (n > len) n = len;
+        memcpy(c->block + c->used, p, n);
+        c->used += n;
+        p += n;
+        len -= n;
+        if (c->used == 64) {
+            sha256_transform(c, c->block);
+            c->used = 0;
+        }
+    }
+}
+
+static void sha256_final(sha256_ctx *c, uint8_t out[32]) {
+    uint64_t bits = c->bits;
+    c->block[c->used++] = 0x80;
+    if (c->used > 56) {
+        memset(c->block + c->used, 0, 64 - c->used);
+        sha256_transform(c, c->block);
+        c->used = 0;
+    }
+    memset(c->block + c->used, 0, 56 - c->used);
+    for (int i = 0; i < 8; i++) c->block[63-i] = (uint8_t)(bits >> (8*i));
+    sha256_transform(c, c->block);
+    for (int i = 0; i < 8; i++) {
+        out[4*i]=(uint8_t)(c->h[i]>>24); out[4*i+1]=(uint8_t)(c->h[i]>>16);
+        out[4*i+2]=(uint8_t)(c->h[i]>>8); out[4*i+3]=(uint8_t)c->h[i];
+    }
+}
+
+static void payload_digest(const uint8_t *payload, size_t payload_bytes,
+                           uint8_t out[32]) {
+    sha256_ctx sha;
+    sha256_init(&sha);
+    sha256_update(&sha, payload, payload_bytes);
+    sha256_final(&sha, out);
+}
+
+static void header_digest(const uint8_t header[DS4_CKVSTORE_HEADER_BYTES],
+                          uint8_t out[32]) {
+    uint8_t copy[DS4_CKVSTORE_HEADER_BYTES];
+    memcpy(copy, header, sizeof(copy));
+    memset(copy + CKV_HEADER_DIGEST_OFFSET, 0, CKV_DIGEST_BYTES);
+    sha256_ctx sha;
+    sha256_init(&sha);
+    sha256_update(&sha, copy, sizeof(copy));
+    sha256_final(&sha, out);
+}
+
+static int pread_all(int fd, void *buf, size_t len, uint64_t off) {
+    uint8_t *p = buf;
+    while (len) {
+        ssize_t n = pread(fd, p, len, (off_t)off);
+        if (n < 0 && errno == EINTR) continue;
+        if (n < 0) return -1;
+        if (n == 0) return 1;
+        p += n; len -= (size_t)n; off += (uint64_t)n;
+    }
+    return 0;
+}
+
+static int pwrite_all(int fd, const void *buf, size_t len, uint64_t off) {
+    const uint8_t *p = buf;
+    while (len) {
+        ssize_t n = pwrite(fd, p, len, (off_t)off);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) return -1;
+        p += n; len -= (size_t)n; off += (uint64_t)n;
+    }
+    return 0;
+}
+
+static bool valid_config(const ds4_ckvstore_config *c) {
+    uint64_t n;
+    if (!c || !c->row_bytes || !c->rows_per_record ||
+        !c->max_cached_records || !c->max_epochs ||
+        !c->max_file_bytes) return false;
+    if (!mul_u64(c->max_cached_records, c->max_epochs, &n) ||
+        n > SIZE_MAX / sizeof(ckv_cache_entry)) return false;
+    if (!mul_u64(c->row_bytes, c->rows_per_record, &n)) return false;
+    if (!mul_u64(n, UINT16_MAX, &n)) return false;
+    return n <= SIZE_MAX && c->max_file_bytes >= DS4_CKVSTORE_HEADER_BYTES;
+}
+
+static ckv_epoch_index *find_epoch(ds4_ckvstore *s, uint32_t epoch) {
+    for (size_t i = 0; i < s->epoch_count; i++)
+        if (s->epochs[i].epoch == epoch) return &s->epochs[i];
+    return NULL;
+}
+
+static ckv_epoch_index *ensure_epoch(ds4_ckvstore *s, uint32_t epoch_value,
+                                     char *err, size_t err_len) {
+    ckv_epoch_index *epoch = find_epoch(s, epoch_value);
+    if (epoch) return epoch;
+    if (s->epoch_count >= s->config.max_epochs) {
+        set_error(err, err_len, "cKV epoch bound reached");
+        return NULL;
+    }
+    if (s->epoch_count == s->epoch_capacity) {
+        size_t cap = s->epoch_capacity ? s->epoch_capacity * 2 : 16;
+        if (cap < s->epoch_capacity || cap > SIZE_MAX / sizeof(*s->epochs))
+            return NULL;
+        void *p = realloc(s->epochs, cap * sizeof(*s->epochs));
+        if (!p) return NULL;
+        s->epochs = p;
+        s->epoch_capacity = cap;
+    }
+    epoch = &s->epochs[s->epoch_count];
+    memset(epoch, 0, sizeof(*epoch));
+    epoch->epoch = epoch_value;
+    epoch->cache_base = s->epoch_count * s->config.max_cached_records;
+    s->epoch_count++;
+    return epoch;
+}
+
+static int add_record(ds4_ckvstore *s, const ckv_record *r,
+                      char *err, size_t err_len) {
+    if (s->record_count == s->record_capacity) {
+        size_t cap = s->record_capacity ? s->record_capacity * 2 : 64;
+        if (cap < s->record_capacity || cap > SIZE_MAX / sizeof(*s->records))
+            return -1;
+        void *p = realloc(s->records, cap * sizeof(*s->records));
+        if (!p) return -1;
+        s->records = p;
+        s->record_capacity = cap;
+    }
+    ckv_epoch_index *epoch = ensure_epoch(s, r->epoch, err, err_len);
+    if (!epoch) return s->epoch_count >= s->config.max_epochs ? -3 : -1;
+    if (epoch->count) {
+        const ckv_record *last = &s->records[epoch->record_ids[epoch->count - 1]];
+        uint64_t last_end = (uint64_t)last->first_row + last->row_count;
+        if (r->first_row < last_end) {
+            set_error(err, err_len,
+                      "cKV records must be non-overlapping and ordered per epoch");
+            return -2;
+        }
+    }
+    if (epoch->count == epoch->capacity) {
+        size_t cap = epoch->capacity ? epoch->capacity * 2 : 64;
+        if (cap < epoch->capacity || cap > SIZE_MAX / sizeof(*epoch->record_ids))
+            return -1;
+        void *p = realloc(epoch->record_ids, cap * sizeof(*epoch->record_ids));
+        if (!p) return -1;
+        epoch->record_ids = p;
+        epoch->capacity = cap;
+    }
+    epoch->record_ids[epoch->count++] = s->record_count;
+    s->records[s->record_count++] = *r;
+    return 0;
+}
+
+static void encode_header(const ds4_ckvstore *s, const ckv_record *r,
+                          uint8_t h[DS4_CKVSTORE_HEADER_BYTES]) {
+    memset(h, 0, DS4_CKVSTORE_HEADER_BYTES);
+    memcpy(h, ckv_magic, sizeof(ckv_magic));
+    put32(h+8, CKV_VERSION); put32(h+12, DS4_CKVSTORE_HEADER_BYTES);
+    put32(h+16, r->epoch); put32(h+20, r->first_row);
+    put32(h+24, r->row_count); put16(h+28, r->layer_count);
+    put32(h+32, s->config.row_bytes);
+    put32(h+36, s->config.rows_per_record);
+    put64(h+40, s->config.generation); put64(h+48, r->payload_bytes);
+    put64(h+56, DS4_CKVSTORE_HEADER_BYTES + r->payload_bytes);
+    memcpy(h+64, s->config.model_binding, 32);
+    memcpy(h+96, s->config.format_binding, 32);
+    memcpy(h+128, s->config.session_id, 16);
+    put64(h+144, (uint64_t)r->first_row + r->row_count);
+}
+
+static int decode_header(ds4_ckvstore *s, const uint8_t *h, uint64_t off,
+                         ckv_record *r, char *err, size_t err_len) {
+    uint8_t digest[CKV_DIGEST_BYTES];
+    header_digest(h, digest);
+    if (memcmp(h + CKV_HEADER_DIGEST_OFFSET, digest, sizeof(digest))) {
+        set_error(err, err_len, "cKV record header checksum mismatch at byte %llu",
+                  (unsigned long long)off);
+        return DS4_CKVSTORE_ERR_CHECKSUM;
+    }
+    if (memcmp(h, ckv_magic, 8) || get32(h+8) != CKV_VERSION ||
+        get32(h+12) != DS4_CKVSTORE_HEADER_BYTES) {
+        set_error(err, err_len, "invalid record header at byte %llu",
+                  (unsigned long long)off);
+        return DS4_CKVSTORE_ERR_INVALID;
+    }
+    if (get32(h+32) != s->config.row_bytes ||
+        get32(h+36) != s->config.rows_per_record ||
+        get64(h+40) != s->config.generation ||
+        memcmp(h+64, s->config.model_binding, 32) ||
+        memcmp(h+96, s->config.format_binding, 32) ||
+        memcmp(h+128, s->config.session_id, 16)) {
+        set_error(err, err_len, "record identity mismatch at byte %llu",
+                  (unsigned long long)off);
+        return DS4_CKVSTORE_ERR_IDENTITY;
+    }
+    r->epoch=get32(h+16); r->first_row=get32(h+20);
+    r->row_count=get32(h+24); r->layer_count=get16(h+28);
+    r->offset=off; r->payload_bytes=get64(h+48);
+    uint64_t expected;
+    if (!r->row_count || r->row_count > s->config.rows_per_record ||
+        !r->layer_count ||
+        (uint64_t)r->first_row + r->row_count > UINT32_MAX ||
+        get64(h+144) != (uint64_t)r->first_row + r->row_count ||
+        !mul_u64(r->row_count, r->layer_count, &expected) ||
+        !mul_u64(expected, s->config.row_bytes, &expected) ||
+        expected != r->payload_bytes ||
+        get64(h+56) != DS4_CKVSTORE_HEADER_BYTES + expected) {
+        set_error(err, err_len, "unsafe record shape at byte %llu",
+                  (unsigned long long)off);
+        return DS4_CKVSTORE_ERR_INVALID;
+    }
+    return DS4_CKVSTORE_OK;
+}
+
+static void invalidate(ds4_ckvstore *s) {
+    s->failed = true;
+    for (size_t i = 0; i < s->cache_capacity; i++) {
+        free(s->cache[i].payload);
+        memset(&s->cache[i], 0, sizeof(s->cache[i]));
+    }
+}
+
+static int ds4_ckvstore_open_impl(ds4_ckvstore **out, int dirfd,
+                                  const char *path,
+                                  const ds4_ckvstore_config *config,
+                                  bool create, char *err, size_t err_len) {
+    if (out) *out = NULL;
+    if (!out || !path || !valid_config(config)) {
+        set_error(err, err_len, "invalid cKV store configuration");
+        return DS4_CKVSTORE_ERR_INVALID;
+    }
+    int flags = O_RDWR | O_CLOEXEC | O_NOFOLLOW;
+    if (create) flags |= O_CREAT | O_EXCL;
+    int fd = dirfd >= 0 ? openat(dirfd, path, flags, 0600)
+                        : open(path, flags, 0600);
+    if (fd < 0) {
+        set_error(err, err_len, "open: %s", strerror(errno));
+        return DS4_CKVSTORE_ERR_IO;
+    }
+    struct stat st;
+    if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode) || st.st_uid != geteuid() ||
+        st.st_nlink != 1 || (st.st_mode & 077) != 0 || st.st_size < 0) {
+        set_error(err, err_len, "unsafe cKV backing file");
+        close(fd);
+        return DS4_CKVSTORE_ERR_IO;
+    }
+    if ((uint64_t)st.st_size > config->max_file_bytes) {
+        set_error(err, err_len, "cKV file exceeds configured bound");
+        close(fd);
+        return DS4_CKVSTORE_ERR_LIMIT;
+    }
+    ds4_ckvstore *s = calloc(1, sizeof(*s));
+    if (!s) { close(fd); return DS4_CKVSTORE_ERR_IO; }
+    s->fd = fd; s->cleanup_dirfd = -1;
+    s->config = *config; s->file_bytes = (uint64_t)st.st_size;
+    s->cache_capacity =
+        (size_t)config->max_cached_records * config->max_epochs;
+    s->cache = calloc(s->cache_capacity, sizeof(*s->cache));
+    if (!s->cache) { ds4_ckvstore_close(s); return DS4_CKVSTORE_ERR_IO; }
+
+    uint64_t off = 0;
+    while (off < s->file_bytes) {
+        if (s->file_bytes - off < DS4_CKVSTORE_HEADER_BYTES) {
+            set_error(err, err_len, "truncated record header");
+            ds4_ckvstore_close(s); return DS4_CKVSTORE_ERR_TRUNCATED;
+        }
+        uint8_t h[DS4_CKVSTORE_HEADER_BYTES];
+        int rr = pread_all(fd, h, sizeof(h), off);
+        if (rr != 0) { ds4_ckvstore_close(s); return rr > 0 ? DS4_CKVSTORE_ERR_TRUNCATED : DS4_CKVSTORE_ERR_IO; }
+        ckv_record r;
+        int rc = decode_header(s, h, off, &r, err, err_len);
+        if (rc != 0) { ds4_ckvstore_close(s); return rc; }
+        uint64_t end = off + DS4_CKVSTORE_HEADER_BYTES + r.payload_bytes;
+        if (end < off || end > s->file_bytes) {
+            set_error(err, err_len, "truncated record payload");
+            ds4_ckvstore_close(s); return DS4_CKVSTORE_ERR_TRUNCATED;
+        }
+        int ar = add_record(s, &r, err, err_len);
+        if (ar != 0) {
+            ds4_ckvstore_close(s);
+            return ar == -2 ? DS4_CKVSTORE_ERR_INVALID :
+                   ar == -3 ? DS4_CKVSTORE_ERR_LIMIT : DS4_CKVSTORE_ERR_IO;
+        }
+        off = end;
+    }
+    *out = s;
+    return DS4_CKVSTORE_OK;
+}
+
+int ds4_ckvstore_open(ds4_ckvstore **out, const char *path,
+                      const ds4_ckvstore_config *config, bool create,
+                      char *err, size_t err_len) {
+    return ds4_ckvstore_open_impl(out, -1, path, config, create,
+                                  err, err_len);
+}
+
+int ds4_ckvstore_create_request(ds4_ckvstore **out, const char *directory,
+                                const ds4_ckvstore_config *config,
+                                char *created_path, size_t created_path_len,
+                                char *err, size_t err_len) {
+    if (out) *out = NULL;
+    if (created_path && created_path_len) created_path[0] = '\0';
+    if (!out || !directory || !directory[0] || !created_path ||
+        !created_path_len || !valid_config(config)) {
+        set_error(err, err_len, "invalid request-store configuration");
+        return DS4_CKVSTORE_ERR_INVALID;
+    }
+    int dirfd = open(directory, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_DIRECTORY);
+    if (dirfd < 0) {
+        set_error(err, err_len, "open request directory: %s", strerror(errno));
+        return DS4_CKVSTORE_ERR_IO;
+    }
+    struct stat st;
+    if (fstat(dirfd, &st) != 0 || !S_ISDIR(st.st_mode) ||
+        st.st_uid != geteuid() || (st.st_mode & 077) != 0) {
+        set_error(err, err_len, "unsafe cKV request directory");
+        close(dirfd);
+        return DS4_CKVSTORE_ERR_IO;
+    }
+    static const char hex[] = "0123456789abcdef";
+    char name[4 + 2 * sizeof(config->session_id) + 5];
+    memcpy(name, "ckv-", 4);
+    for (size_t i = 0; i < sizeof(config->session_id); i++) {
+        name[4 + 2 * i] = hex[config->session_id[i] >> 4];
+        name[5 + 2 * i] = hex[config->session_id[i] & 15u];
+    }
+    memcpy(name + 4 + 2 * sizeof(config->session_id), ".bin", 5);
+    int n = snprintf(created_path, created_path_len, "%s/%s", directory, name);
+    if (n < 0 || (size_t)n >= created_path_len) {
+        set_error(err, err_len, "request-store path is too long");
+        created_path[0] = '\0';
+        close(dirfd);
+        return DS4_CKVSTORE_ERR_INVALID;
+    }
+    int rc = ds4_ckvstore_open_impl(out, dirfd, name, config, true,
+                                    err, err_len);
+    if (rc != DS4_CKVSTORE_OK) {
+        created_path[0] = '\0';
+        close(dirfd);
+        return rc;
+    }
+    /* The request store is ephemeral working state, not evidence.  Remove its
+     * directory entry immediately while retaining the open descriptor.  The
+     * kernel then reclaims it on normal close, SIGKILL, or process crash, and
+     * no later pathname cleanup can race or target an unrelated file. */
+    if (unlinkat(dirfd, name, 0) != 0) {
+        set_error(err, err_len, "anonymize request store: %s", strerror(errno));
+        ds4_ckvstore_close(*out);
+        *out = NULL;
+        (void)unlinkat(dirfd, name, 0);
+        close(dirfd);
+        created_path[0] = '\0';
+        return DS4_CKVSTORE_ERR_IO;
+    }
+    close(dirfd);
+    return DS4_CKVSTORE_OK;
+}
+
+static int put_record(ds4_ckvstore *s, uint32_t epoch,
+                      uint32_t first_row, uint32_t row_count,
+                      uint16_t layer_count, const void *payload,
+                      size_t payload_bytes, char *err, size_t err_len) {
+    if (!s || s->failed) return DS4_CKVSTORE_ERR_FAILED;
+    ckv_record r = {.epoch=epoch,.first_row=first_row,.row_count=row_count,
+                    .layer_count=layer_count,.offset=s->file_bytes,
+                    .payload_bytes=payload_bytes};
+    uint64_t expected;
+    if (!payload || !row_count || row_count > s->config.rows_per_record ||
+        !layer_count ||
+        (uint64_t)first_row + row_count > UINT32_MAX ||
+        !mul_u64(row_count, layer_count, &expected) ||
+        !mul_u64(expected, s->config.row_bytes, &expected) ||
+        expected != payload_bytes) {
+        set_error(err, err_len, "invalid cKV record shape");
+        return DS4_CKVSTORE_ERR_INVALID;
+    }
+    ckv_epoch_index *epoch_index = find_epoch(s, epoch);
+    if (epoch_index && epoch_index->count) {
+        const ckv_record *last =
+            &s->records[epoch_index->record_ids[epoch_index->count - 1]];
+        if (first_row < (uint64_t)last->first_row + last->row_count) {
+            set_error(err, err_len,
+                      "cKV records must be non-overlapping and ordered per epoch");
+            return DS4_CKVSTORE_ERR_INVALID;
+        }
+    }
+    uint64_t record_bytes=DS4_CKVSTORE_HEADER_BYTES+expected;
+    if (record_bytes < expected || record_bytes > s->config.max_file_bytes ||
+        s->file_bytes > s->config.max_file_bytes-record_bytes) {
+        set_error(err, err_len, "cKV file bound reached");
+        return DS4_CKVSTORE_ERR_LIMIT;
+    }
+    uint8_t h[DS4_CKVSTORE_HEADER_BYTES], digest[32];
+    encode_header(s, &r, h);
+    payload_digest(payload, payload_bytes, digest);
+    memcpy(h+CKV_PAYLOAD_DIGEST_OFFSET, digest, sizeof(digest));
+    header_digest(h, digest);
+    memcpy(h+CKV_HEADER_DIGEST_OFFSET, digest, sizeof(digest));
+    if (pwrite_all(s->fd, h, sizeof(h), s->file_bytes) != 0 ||
+        pwrite_all(s->fd, payload, payload_bytes,
+                   s->file_bytes+DS4_CKVSTORE_HEADER_BYTES) != 0) {
+        set_error(err, err_len, "cKV append failed: %s", strerror(errno));
+        invalidate(s);
+        return DS4_CKVSTORE_ERR_IO;
+    }
+    const uint64_t new_file_bytes = s->file_bytes + record_bytes;
+    if (s->pending_write_bytes > UINT64_MAX - record_bytes) {
+        set_error(err, err_len, "cKV pending-write accounting overflow");
+        invalidate(s);
+        return DS4_CKVSTORE_ERR_LIMIT;
+    }
+    s->pending_write_bytes += record_bytes;
+    if (s->config.sync_interval_bytes == 0 ||
+        s->pending_write_bytes >= s->config.sync_interval_bytes) {
+        if (fdatasync(s->fd) != 0) {
+            set_error(err, err_len, "cKV group commit failed: %s",
+                      strerror(errno));
+            invalidate(s);
+            return DS4_CKVSTORE_ERR_IO;
+        }
+        s->sync_calls++;
+#ifdef POSIX_FADV_DONTNEED
+        if (new_file_bytes > s->last_advised_offset) {
+            (void)posix_fadvise(s->fd, (off_t)s->last_advised_offset,
+                                (off_t)(new_file_bytes - s->last_advised_offset),
+                                POSIX_FADV_DONTNEED);
+        }
+#endif
+        s->last_advised_offset = new_file_bytes;
+        s->pending_write_bytes = 0;
+    }
+    int ar = add_record(s, &r, err, err_len);
+    if (ar != 0) {
+        if (ar == -2) return DS4_CKVSTORE_ERR_INVALID;
+        if (ar == -3) return DS4_CKVSTORE_ERR_LIMIT;
+        invalidate(s); return DS4_CKVSTORE_ERR_IO;
+    }
+    s->file_bytes += record_bytes;
+    return DS4_CKVSTORE_OK;
+}
+
+int ds4_ckvstore_put(ds4_ckvstore *s, uint32_t epoch,
+                     uint32_t first_row, uint32_t row_count,
+                     uint16_t layer_count, const void *payload,
+                     size_t payload_bytes, char *err, size_t err_len) {
+    if (!s || s->failed) return DS4_CKVSTORE_ERR_FAILED;
+    if (!s->config.buffer_tail_rows)
+        return put_record(s, epoch, first_row, row_count, layer_count,
+                          payload, payload_bytes, err, err_len);
+    uint64_t expected;
+    if (!payload || !row_count ||
+        layer_count != 1u ||
+        (uint64_t)first_row + row_count > UINT32_MAX ||
+        !mul_u64(row_count, s->config.row_bytes, &expected) ||
+        expected != payload_bytes) {
+        set_error(err, err_len, "invalid buffered cKV row shape");
+        return DS4_CKVSTORE_ERR_INVALID;
+    }
+    ckv_epoch_index *index = ensure_epoch(s, epoch, err, err_len);
+    if (!index) return s->epoch_count >= s->config.max_epochs
+        ? DS4_CKVSTORE_ERR_LIMIT : DS4_CKVSTORE_ERR_IO;
+    uint64_t expected_first = first_row;
+    if (index->tail_row_count) {
+        expected_first = (uint64_t)index->tail_first_row + index->tail_row_count;
+    } else if (index->count) {
+        const ckv_record *last =
+            &s->records[index->record_ids[index->count - 1]];
+        expected_first = (uint64_t)last->first_row + last->row_count;
+    }
+    if (first_row != expected_first) {
+        set_error(err, err_len, "buffered cKV rows must be contiguous");
+        return DS4_CKVSTORE_ERR_INVALID;
+    }
+    if (!index->tail_payload) {
+        uint64_t capacity_bytes;
+        if (!mul_u64(s->config.rows_per_record, s->config.row_bytes,
+                     &capacity_bytes) || capacity_bytes > SIZE_MAX) {
+            return DS4_CKVSTORE_ERR_INVALID;
+        }
+        index->tail_payload = malloc((size_t)capacity_bytes);
+        if (!index->tail_payload) return DS4_CKVSTORE_ERR_IO;
+    }
+    const uint8_t *source = payload;
+    uint32_t consumed = 0;
+    while (consumed < row_count) {
+        if (index->tail_row_count == 0)
+            index->tail_first_row = first_row + consumed;
+        uint32_t take = s->config.rows_per_record - index->tail_row_count;
+        if (take > row_count - consumed) take = row_count - consumed;
+        memcpy(index->tail_payload +
+                   (uint64_t)index->tail_row_count * s->config.row_bytes,
+               source + (uint64_t)consumed * s->config.row_bytes,
+               (size_t)((uint64_t)take * s->config.row_bytes));
+        index->tail_row_count += take;
+        consumed += take;
+        if (index->tail_row_count == s->config.rows_per_record) {
+            const size_t bytes =
+                (size_t)((uint64_t)index->tail_row_count * s->config.row_bytes);
+            int rc = put_record(s, epoch, index->tail_first_row,
+                                index->tail_row_count, 1u,
+                                index->tail_payload, bytes, err, err_len);
+            if (rc != DS4_CKVSTORE_OK) return rc;
+            index->tail_row_count = 0;
+        }
+    }
+    return DS4_CKVSTORE_OK;
+}
+
+static int load_record(ds4_ckvstore *s, size_t idx, uint8_t **out,
+                       char *err, size_t err_len) {
+    ckv_epoch_index *epoch = find_epoch(s, s->records[idx].epoch);
+    if (!epoch) return DS4_CKVSTORE_ERR_FAILED;
+    const size_t first = epoch->cache_base;
+    const size_t end = first + s->config.max_cached_records;
+    for (size_t i=first; i<end; i++) {
+        if (s->cache[i].valid && s->cache[i].record_index == idx) {
+            s->cache[i].last_use=++s->use_clock; s->cache_hits++; *out=s->cache[i].payload;
+            return DS4_CKVSTORE_OK;
+        }
+    }
+    s->cache_misses++;
+    ckv_record *r=&s->records[idx];
+    uint8_t h[DS4_CKVSTORE_HEADER_BYTES];
+    uint8_t *payload=malloc((size_t)r->payload_bytes);
+    if (!payload) return DS4_CKVSTORE_ERR_IO;
+    int rh=pread_all(s->fd,h,sizeof(h),r->offset);
+    int rp=rh ? rh : pread_all(s->fd,payload,(size_t)r->payload_bytes,
+                              r->offset+DS4_CKVSTORE_HEADER_BYTES);
+    if (rp != 0) {
+        free(payload); invalidate(s); set_error(err,err_len,"short or failed cKV read");
+        return rp > 0 ? DS4_CKVSTORE_ERR_TRUNCATED : DS4_CKVSTORE_ERR_IO;
+    }
+    s->physical_read_bytes += sizeof(h)+r->payload_bytes;
+    ckv_record current;
+    int rc=decode_header(s,h,r->offset,&current,err,err_len);
+    if (rc || current.epoch!=r->epoch || current.first_row!=r->first_row ||
+        current.row_count!=r->row_count || current.layer_count!=r->layer_count) {
+        free(payload); invalidate(s); return rc ? rc : DS4_CKVSTORE_ERR_IDENTITY;
+    }
+    uint8_t digest[32]; payload_digest(payload,(size_t)r->payload_bytes,digest);
+    if (memcmp(digest,h+CKV_PAYLOAD_DIGEST_OFFSET,32)) {
+        free(payload); s->checksum_failures++; invalidate(s);
+        set_error(err,err_len,"cKV record checksum mismatch");
+        return DS4_CKVSTORE_ERR_CHECKSUM;
+    }
+    s->checksum_validations++;
+    size_t victim=first;
+    for (size_t i=first;i<end;i++) {
+        if (!s->cache[i].valid) { victim=i; break; }
+        if (s->cache[i].last_use < s->cache[victim].last_use) victim=i;
+    }
+    free(s->cache[victim].payload);
+    s->cache[victim]=(ckv_cache_entry){.record_index=idx,.payload=payload,
+                                      .last_use=++s->use_clock,.valid=true};
+    *out=payload;
+    return DS4_CKVSTORE_OK;
+}
+
+static ssize_t find_record(ds4_ckvstore *s, uint32_t epoch, uint32_t row) {
+    ckv_epoch_index *index = find_epoch(s, epoch);
+    if (!index) return -1;
+    size_t lo = 0, hi = index->count;
+    while (lo < hi) {
+        size_t mid = lo + (hi - lo) / 2;
+        const ckv_record *r = &s->records[index->record_ids[mid]];
+        s->lookup_comparisons++;
+        if (row < r->first_row) {
+            hi = mid;
+        } else if ((uint64_t)row >= (uint64_t)r->first_row + r->row_count) {
+            lo = mid + 1;
+        } else {
+            return (ssize_t)index->record_ids[mid];
+        }
+    }
+    return -1;
+}
+
+static int compare_selection_items(const void *a, const void *b) {
+    const ckv_selection_item *aa = a;
+    const ckv_selection_item *bb = b;
+    if (aa->record_index < bb->record_index) return -1;
+    if (aa->record_index > bb->record_index) return 1;
+    if (aa->output_index < bb->output_index) return -1;
+    if (aa->output_index > bb->output_index) return 1;
+    return 0;
+}
+
+static int read_selected_flat(ds4_ckvstore *s, uint32_t epoch,
+                              uint16_t layer, const uint32_t *rows,
+                              uint32_t count, uint32_t max_count,
+                              void *output, size_t output_bytes,
+                              char *err, size_t err_len) {
+    if (!s || s->failed) return DS4_CKVSTORE_ERR_FAILED;
+    uint64_t needed;
+    if (!rows || !output || !count || count>max_count ||
+        !mul_u64(count,s->config.row_bytes,&needed) || needed>output_bytes) {
+        set_error(err,err_len,"invalid selected-row request");
+        return DS4_CKVSTORE_ERR_INVALID;
+    }
+    ckv_selection_item *items=malloc(count*sizeof(*items));
+    uint8_t *tmp=malloc((size_t)needed);
+    if (!items || !tmp) { free(items); free(tmp); return DS4_CKVSTORE_ERR_IO; }
+    ckv_epoch_index *epoch_index = find_epoch(s, epoch);
+    for (uint32_t i=0;i<count;i++) {
+        ssize_t record_id=find_record(s,epoch,rows[i]);
+        bool in_tail = record_id < 0 && epoch_index && layer == 0u &&
+            rows[i] >= epoch_index->tail_first_row &&
+            (uint64_t)rows[i] < (uint64_t)epoch_index->tail_first_row +
+                                epoch_index->tail_row_count;
+        if ((!in_tail && record_id<0) ||
+            (record_id>=0 && layer>=s->records[record_id].layer_count)) {
+            free(items); free(tmp); set_error(err,err_len,"required cKV row is absent");
+            return DS4_CKVSTORE_ERR_NOT_FOUND;
+        }
+        items[i]=(ckv_selection_item){.record_index=in_tail ? SIZE_MAX :
+                                                        (size_t)record_id,
+                                     .output_index=i,.row=rows[i]};
+    }
+    qsort(items,count,sizeof(*items),compare_selection_items);
+    for (uint32_t first=0;first<count;) {
+        uint32_t end=first+1;
+        while (end<count && items[end].record_index==items[first].record_index)
+            end++;
+        if (items[first].record_index == SIZE_MAX) {
+            for (uint32_t i=first;i<end;i++) {
+                uint64_t local =
+                    (uint64_t)(items[i].row - epoch_index->tail_first_row);
+                memcpy(tmp +
+                           (uint64_t)items[i].output_index * s->config.row_bytes,
+                       epoch_index->tail_payload + local * s->config.row_bytes,
+                       s->config.row_bytes);
+            }
+            first=end;
+            continue;
+        }
+        ckv_record *r=&s->records[items[first].record_index];
+        uint8_t *payload=NULL;
+        int rc=load_record(s,items[first].record_index,&payload,err,err_len);
+        if (rc) { free(items); free(tmp); return rc; }
+        for (uint32_t i=first;i<end;i++) {
+            uint64_t local=(uint64_t)(items[i].row-r->first_row);
+            uint64_t source=((uint64_t)layer*r->row_count+local)*s->config.row_bytes;
+            memcpy(tmp+(uint64_t)items[i].output_index*s->config.row_bytes,
+                   payload+source,s->config.row_bytes);
+        }
+        first=end;
+    }
+    memcpy(output,tmp,(size_t)needed);
+    s->selected_rows += count;
+    free(items); free(tmp);
+    return DS4_CKVSTORE_OK;
+}
+
+int ds4_ckvstore_read_selected(ds4_ckvstore *s, uint32_t epoch,
+                               uint16_t layer, const uint32_t *rows,
+                               uint32_t count, void *output,
+                               size_t output_bytes, char *err,
+                               size_t err_len) {
+    return read_selected_flat(s, epoch, layer, rows, count,
+                              DS4_CKVSTORE_MAX_SELECTED_ROWS,
+                              output, output_bytes, err, err_len);
+}
+
+int ds4_ckvstore_read_selected_batch(ds4_ckvstore *s, uint32_t epoch,
+                                     uint16_t layer, const uint32_t *rows,
+                                     uint32_t query_count,
+                                     uint32_t rows_per_query,
+                                     void *output, size_t output_bytes,
+                                     char *err, size_t err_len) {
+    uint64_t count64;
+    if (!query_count || query_count > DS4_CKVSTORE_MAX_BATCH_QUERIES ||
+        !rows_per_query ||
+        rows_per_query > DS4_CKVSTORE_MAX_SELECTED_ROWS ||
+        !mul_u64(query_count, rows_per_query, &count64) ||
+        count64 > UINT32_MAX) {
+        set_error(err, err_len, "invalid batched selected-row request");
+        return DS4_CKVSTORE_ERR_INVALID;
+    }
+    return read_selected_flat(
+        s, epoch, layer, rows, (uint32_t)count64,
+        DS4_CKVSTORE_MAX_BATCH_QUERIES * DS4_CKVSTORE_MAX_SELECTED_ROWS,
+        output, output_bytes, err, err_len);
+}
+
+void ds4_ckvstore_get_stats(const ds4_ckvstore *s, ds4_ckvstore_stats *out) {
+    if (!out) return;
+    memset(out,0,sizeof(*out));
+    if (!s) return;
+    out->records=s->record_count; out->file_bytes=s->file_bytes;
+    out->cache_hits=s->cache_hits; out->cache_misses=s->cache_misses;
+    out->lookup_comparisons=s->lookup_comparisons;
+    out->sync_calls=s->sync_calls;
+    out->pending_write_bytes=s->pending_write_bytes;
+    out->physical_read_bytes=s->physical_read_bytes;
+    out->checksum_validations=s->checksum_validations;
+    out->checksum_failures=s->checksum_failures;
+    out->selected_rows=s->selected_rows;
+    for (size_t i=0;i<s->epoch_count;i++) {
+        out->pending_rows += s->epochs[i].tail_row_count;
+        out->pending_row_bytes +=
+            (uint64_t)s->epochs[i].tail_row_count * s->config.row_bytes;
+    }
+    for (size_t i=0;i<s->cache_capacity;i++) if (s->cache[i].valid) {
+        out->cache_records++;
+        out->cache_bytes+=s->records[s->cache[i].record_index].payload_bytes;
+    }
+}
+
+void ds4_ckvstore_close(ds4_ckvstore *s) {
+    if (!s) return;
+    if (s->fd>=0) close(s->fd);
+    if (s->cleanup_name && s->cleanup_dirfd >= 0)
+        (void)unlinkat(s->cleanup_dirfd, s->cleanup_name, 0);
+    if (s->cleanup_dirfd >= 0) close(s->cleanup_dirfd);
+    if (s->cache) for (size_t i=0;i<s->cache_capacity;i++)
+        free(s->cache[i].payload);
+    for (size_t i=0;i<s->epoch_count;i++) {
+        free(s->epochs[i].tail_payload);
+        free(s->epochs[i].record_ids);
+    }
+    free(s->cleanup_name); free(s->epochs); free(s->cache); free(s->records);
+    free(s);
+}
diff --git a/ds4_ckvstore.h b/ds4_ckvstore.h
new file mode 100644
index 0000000..23019bd
--- /dev/null
+++ b/ds4_ckvstore.h
@@ -0,0 +1,88 @@
+#ifndef DS4_CKVSTORE_H
+#define DS4_CKVSTORE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define DS4_CKVSTORE_HEADER_BYTES 256u
+#define DS4_CKVSTORE_MAX_SELECTED_ROWS 2048u
+#define DS4_CKVSTORE_MAX_BATCH_QUERIES 8u
+
+typedef enum {
+    DS4_CKVSTORE_OK = 0,
+    DS4_CKVSTORE_ERR_INVALID = -1,
+    DS4_CKVSTORE_ERR_IO = -2,
