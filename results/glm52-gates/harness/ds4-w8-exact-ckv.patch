+static void test_header_checksum_and_file_bound(void) {
+    char path[] = "/tmp/ds4-ckvstore-header.XXXXXX";
+    int seed_fd = mkstemp(path);
+    CHECK(seed_fd >= 0, "mkstemp header");
+    if (seed_fd < 0) return;
+    close(seed_fd);
+    unlink(path);
+
+    ds4_ckvstore_config cfg = test_config();
+    ds4_ckvstore *store = NULL;
+    char err[256] = {0};
+    uint8_t payload[2 * 4 * 8];
+    fill_payload(payload, 0, 4, 2, 8);
+    CHECK(ds4_ckvstore_open(&store, path, &cfg, true, err, sizeof(err)) == 0,
+          "create header fixture");
+    CHECK(ds4_ckvstore_put(store, 3, 0, 4, 2, payload, sizeof(payload),
+                           err, sizeof(err)) == 0,
+          "write header fixture");
+    ds4_ckvstore_close(store);
+    store = NULL;
+
+    int fd = open(path, O_RDWR);
+    CHECK(fd >= 0, "open header fixture to mutate");
+    uint8_t byte = 0;
+    CHECK(pread(fd, &byte, 1, 16) == 1, "read epoch header byte");
+    byte ^= 1;
+    CHECK(pwrite(fd, &byte, 1, 16) == 1, "mutate epoch header byte");
+    close(fd);
+    CHECK(ds4_ckvstore_open(&store, path, &cfg, false, err, sizeof(err)) ==
+              DS4_CKVSTORE_ERR_CHECKSUM,
+          "header corruption is detected without trusting its index fields");
+    CHECK(store == NULL, "corrupt header publishes no store");
+    unlink(path);
+
+    char limit_path[] = "/tmp/ds4-ckvstore-limit.XXXXXX";
+    seed_fd = mkstemp(limit_path);
+    CHECK(seed_fd >= 0, "mkstemp limit");
+    if (seed_fd < 0) return;
+    close(seed_fd);
+    unlink(limit_path);
+    cfg.max_file_bytes = DS4_CKVSTORE_HEADER_BYTES + sizeof(payload) - 1;
+    CHECK(ds4_ckvstore_open(&store, limit_path, &cfg, true,
+                            err, sizeof(err)) == 0,
+          "create tightly bounded fixture");
+    CHECK(ds4_ckvstore_put(store, 0, 0, 4, 2, payload, sizeof(payload),
+                           err, sizeof(err)) == DS4_CKVSTORE_ERR_LIMIT,
+          "record larger than maximum is rejected without unsigned wrap");
+    struct stat st;
+    CHECK(stat(limit_path, &st) == 0 && st.st_size == 0,
+          "rejected record writes no partial bytes");
+    ds4_ckvstore_close(store);
+    unlink(limit_path);
+}
