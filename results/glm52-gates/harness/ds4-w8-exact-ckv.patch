+    char err[256] = {0};
+    uint8_t payload[2 * 4 * 8];
+    uint8_t output[2 * 4 * 8];
+    uint32_t rows[] = {0, 1, 2, 3};
+    fill_payload(payload, 0, 4, 2, 8);
+    CHECK(ds4_ckvstore_open(&store, path, &cfg, true, err, sizeof(err)) == 0,
+          "create telemetry fixture");
+    CHECK(ds4_ckvstore_put(store, 0, 0, 4, 2, payload, sizeof(payload),
+                           err, sizeof(err)) == 0,
+          "publish telemetry fixture record");
+    CHECK(ds4_ckvstore_read_selected(store, 0, 0, rows, 4, output,
+                                     sizeof(output), err, sizeof(err)) == 0,
+          "read telemetry fixture rows");
+    ds4_ckvstore_stats stats;
+    ds4_ckvstore_get_stats(store, &stats);
+    CHECK(stats.records == 1, "telemetry counts published records");
+    CHECK(stats.selected_rows == 4, "telemetry counts selected rows");
+    CHECK(stats.checksum_validations == 1,
+          "telemetry counts successful checksum validation");
+    CHECK(stats.checksum_failures == 0, "telemetry retains zero failures");
+    ds4_ckvstore_close(store);
+    unlink(path);
+}
