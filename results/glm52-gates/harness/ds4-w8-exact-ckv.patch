+#include "ds4_ckvstore.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#define ROWS 1048576u
+#define ROW_BYTES 8u
+#define RECORD_ROWS 64u
+#define SELECTED 2048u
+
+static double seconds(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (double)ts.tv_sec + (double)ts.tv_nsec / 1.0e9;
+}
+
+int main(void) {
+    char path[] = "/tmp/ds4-ckvstore-1m.XXXXXX";
+    int seed_fd = mkstemp(path);
+    if (seed_fd < 0) return 2;
+    close(seed_fd);
+    unlink(path);
+    ds4_ckvstore_config cfg = {
+        .row_bytes = ROW_BYTES,
+        .rows_per_record = RECORD_ROWS,
+        .max_cached_records = 64,
+        .max_epochs = 1,
+        .generation = 1,
+        .max_file_bytes = 32u * 1024u * 1024u,
+        .sync_interval_bytes = 8u * 1024u * 1024u,
+    };
+    memset(cfg.model_binding, 0x31, sizeof(cfg.model_binding));
+    memset(cfg.format_binding, 0x52, sizeof(cfg.format_binding));
+    memset(cfg.session_id, 0x73, sizeof(cfg.session_id));
+    ds4_ckvstore *store = NULL;
+    char err[256] = {0};
+    if (ds4_ckvstore_open(&store, path, &cfg, true, err, sizeof(err)) != 0) {
+        fprintf(stderr, "open: %s\n", err);
+        return 1;
+    }
+    uint8_t payload[RECORD_ROWS * ROW_BYTES];
+    const double put_t0 = seconds();
+    for (uint32_t first = 0; first < ROWS; first += RECORD_ROWS) {
+        for (uint32_t row = 0; row < RECORD_ROWS; row++) {
+            uint64_t value = first + row;
+            memcpy(payload + row * ROW_BYTES, &value, sizeof(value));
+        }
+        if (ds4_ckvstore_put(store, 77, first, RECORD_ROWS, 1, payload,
+                             sizeof(payload), err, sizeof(err)) != 0) {
+            fprintf(stderr, "put row %u: %s\n", first, err);
+            return 1;
+        }
+    }
+    const double put_seconds = seconds() - put_t0;
+    uint32_t selected[SELECTED];
+    uint8_t output[SELECTED * ROW_BYTES];
+    for (uint32_t i = 0; i < SELECTED; i++) {
+        uint32_t block = (i * 8191u) % (ROWS / RECORD_ROWS);
+        selected[i] = block * RECORD_ROWS + (i % RECORD_ROWS);
+    }
+    const double read_t0 = seconds();
+    if (ds4_ckvstore_read_selected(store, 77, 0, selected, SELECTED,
+                                   output, sizeof(output), err,
+                                   sizeof(err)) != 0) {
+        fprintf(stderr, "read: %s\n", err);
+        return 1;
+    }
+    const double read_seconds = seconds() - read_t0;
+    for (uint32_t i = 0; i < SELECTED; i++) {
+        uint64_t value = UINT64_MAX;
+        memcpy(&value, output + i * ROW_BYTES, sizeof(value));
+        if (value != selected[i]) {
+            fprintf(stderr, "row mismatch at %u\n", i);
+            return 1;
+        }
+    }
+    ds4_ckvstore_stats stats = {0};
+    ds4_ckvstore_get_stats(store, &stats);
+    const uint64_t expected_reads =
+        (uint64_t)SELECTED * (DS4_CKVSTORE_HEADER_BYTES +
+                              RECORD_ROWS * ROW_BYTES);
+    const uint64_t comparison_bound = SELECTED * 15u;
+    int failed = stats.records != ROWS / RECORD_ROWS ||
+                 stats.physical_read_bytes != expected_reads ||
+                 stats.lookup_comparisons == 0 ||
+                 stats.lookup_comparisons > comparison_bound ||
+                 stats.cache_records > cfg.max_cached_records ||
+                 stats.pending_write_bytes >= cfg.sync_interval_bytes;
+    printf("{\"rows\":%u,\"records\":%llu,\"selected\":%u,"
+           "\"physical_read_bytes\":%llu,\"lookup_comparisons\":%llu,"
+           "\"sync_calls\":%llu,\"put_seconds\":%.9f,"
+           "\"read_seconds\":%.9f,\"verdict\":\"%s\"}\n",
+           ROWS, (unsigned long long)stats.records, SELECTED,
+           (unsigned long long)stats.physical_read_bytes,
+           (unsigned long long)stats.lookup_comparisons,
+           (unsigned long long)stats.sync_calls, put_seconds, read_seconds,
+           failed ? "FAIL" : "PASS");
+    ds4_ckvstore_close(store);
+    unlink(path);
+    return failed ? 1 : 0;
+}
