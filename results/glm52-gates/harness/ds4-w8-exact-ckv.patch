+static void test_success_telemetry_proves_exact_io(void) {
+    char path[] = "/tmp/ds4-ckvstore-telemetry.XXXXXX";
+    int seed_fd = mkstemp(path);
+    CHECK(seed_fd >= 0, "mkstemp telemetry");
+    if (seed_fd < 0) return;
+    close(seed_fd);
+    unlink(path);
+
+    ds4_ckvstore_config cfg = test_config();
