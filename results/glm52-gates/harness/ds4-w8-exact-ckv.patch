+    if (!g->ckv_store || !g->ckv_io_host || !g->ckv_record_host ||
+        !ds4_gpu_synchronize()) return false;
+    const uint64_t latent_row = glm_graph_compact_latent_row_bytes();
+    const uint64_t rope_row = glm_graph_compact_rope_row_bytes();
+    const uint64_t latent_bytes = (uint64_t)n_tokens * latent_row;
+    const uint64_t rope_bytes = (uint64_t)n_tokens * rope_row;
+    if (!ds4_gpu_tensor_read(lora, 0, g->ckv_io_host, latent_bytes) ||
+        !ds4_gpu_tensor_read(rope, 0, g->ckv_io_host + latent_bytes,
+                             rope_bytes)) return false;
+    for (uint32_t row = 0; row < n_tokens; row++) {
+        uint8_t *dst = g->ckv_record_host +
+            (uint64_t)row * (latent_row + rope_row);
+        memcpy(dst, g->ckv_io_host + (uint64_t)row * latent_row,
+               (size_t)latent_row);
+        memcpy(dst + latent_row,
+               g->ckv_io_host + latent_bytes + (uint64_t)row * rope_row,
+               (size_t)rope_row);
+    }
+    char err[256] = {0};
+    const int rc = ds4_ckvstore_put(
+        g->ckv_store, layer, pos0, n_tokens, 1u, g->ckv_record_host,
+        (size_t)(latent_bytes + rope_bytes), err, sizeof(err));
+    if (rc != DS4_CKVSTORE_OK) {
+        fprintf(stderr, "ds4: W8 cKV append failed layer=%u rows=[%u,%u): %s\n",
+                layer, pos0, pos0 + n_tokens, err);
+        return false;
+    }
+    g->ckv_append_calls++;
+    g->ckv_appended_rows += n_tokens;
+    return true;
+}
+
+static bool glm_graph_stage_ckv_exact_selected(
+        ds4_glm_gpu_graph *g, uint32_t layer,
+        const ds4_gpu_tensor *selected, uint64_t selected_offset,
+        uint32_t n_selected) {
+    if (!g || !g->ckv_nvme_exact || !g->ckv_store || !selected ||
+        !n_selected || n_selected > g->ckv_exact_selected_rows) return false;
+    if (!ds4_gpu_tensor_read(selected, selected_offset,
+                             g->ckv_selected_ids_host,
+                             (uint64_t)n_selected * sizeof(uint32_t))) return false;
+    char err[256] = {0};
+    const uint64_t latent_row = glm_graph_compact_latent_row_bytes();
+    const uint64_t rope_row = glm_graph_compact_rope_row_bytes();
+    const uint64_t latent_bytes = (uint64_t)n_selected * latent_row;
+    const int rc = ds4_ckvstore_read_selected(
+        g->ckv_store, layer, 0u, g->ckv_selected_ids_host, n_selected,
+        g->ckv_record_host, (size_t)((uint64_t)n_selected *
+            (latent_row + rope_row)), err, sizeof(err));
+    if (rc != DS4_CKVSTORE_OK) {
+        fprintf(stderr, "ds4: W8 selected-row read failed layer=%u: %s\n",
+                layer, err);
+        return false;
+    }
+    g->ckv_selected_read_calls++;
+    g->ckv_selected_rows += n_selected;
+    for (uint32_t row = 0; row < n_selected; row++) {
+        const uint8_t *src = g->ckv_record_host +
+            (uint64_t)row * (latent_row + rope_row);
+        memcpy(g->ckv_io_host + (uint64_t)row * latent_row,
+               src, (size_t)latent_row);
+        memcpy(g->ckv_io_host + latent_bytes + (uint64_t)row * rope_row,
+               src + latent_row, (size_t)rope_row);
+    }
+    return ds4_gpu_tensor_write(g->ckv_selected_lora, 0, g->ckv_io_host,
+                                latent_bytes) != 0 &&
+           ds4_gpu_tensor_write(g->ckv_selected_rope, 0,
+                                g->ckv_io_host + latent_bytes,
+                                (uint64_t)n_selected * rope_row) != 0;
+}
