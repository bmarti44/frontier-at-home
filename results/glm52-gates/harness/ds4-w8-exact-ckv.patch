+static void test_corruption_and_short_read_fail_closed(void) {
+    char path[] = "/tmp/ds4-ckvstore-corrupt.XXXXXX";
+    int seed_fd = mkstemp(path);
+    CHECK(seed_fd >= 0, "mkstemp corruption");
+    if (seed_fd < 0) return;
+    close(seed_fd);
+    unlink(path);
+
+    ds4_ckvstore_config cfg = test_config();
+    ds4_ckvstore *store = NULL;
+    char err[256] = {0};
+    uint8_t payload[2 * 4 * 8];
+    fill_payload(payload, 0, 4, 2, 8);
+    CHECK(ds4_ckvstore_open(&store, path, &cfg, true, err, sizeof(err)) == 0,
+          "create corrupt fixture");
+    CHECK(ds4_ckvstore_put(store, 0, 0, 4, 2, payload, sizeof(payload),
+                           err, sizeof(err)) == 0,
+          "write corrupt fixture");
+    ds4_ckvstore_close(store);
+    store = NULL;
+
+    int fd = open(path, O_RDWR);
+    CHECK(fd >= 0, "open fixture to mutate");
+    uint8_t byte = 0;
+    CHECK(pread(fd, &byte, 1, DS4_CKVSTORE_HEADER_BYTES + 7) == 1,
+          "read payload mutation byte");
+    byte ^= 0x80;
+    CHECK(pwrite(fd, &byte, 1, DS4_CKVSTORE_HEADER_BYTES + 7) == 1,
+          "mutate payload byte");
+    close(fd);
+
+    CHECK(ds4_ckvstore_open(&store, path, &cfg, false, err, sizeof(err)) == 0,
+          "metadata scan does not trust payload");
+    const uint32_t selected[] = {0};
+    uint8_t got[8];
+    CHECK(ds4_ckvstore_read_selected(store, 0, 0, selected, 1, got,
+                                     sizeof(got), err, sizeof(err)) ==
+              DS4_CKVSTORE_ERR_CHECKSUM,
+          "payload corruption fails closed");
+    CHECK(ds4_ckvstore_read_selected(store, 0, 0, selected, 1, got,
+                                     sizeof(got), err, sizeof(err)) ==
+              DS4_CKVSTORE_ERR_FAILED,
+          "corruption permanently invalidates request store");
+    ds4_ckvstore_close(store);
+    store = NULL;
+
+    fd = open(path, O_WRONLY);
+    CHECK(fd >= 0, "open fixture to truncate");
+    CHECK(ftruncate(fd, DS4_CKVSTORE_HEADER_BYTES + 3) == 0,
+          "truncate payload");
+    close(fd);
+    CHECK(ds4_ckvstore_open(&store, path, &cfg, false, err, sizeof(err)) ==
+              DS4_CKVSTORE_ERR_TRUNCATED,
+          "short record is rejected during reconstruction");
+    CHECK(store == NULL, "failed open returns no usable store");
+    unlink(path);
+}
