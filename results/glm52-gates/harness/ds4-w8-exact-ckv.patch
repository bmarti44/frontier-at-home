+static void test_rejects_unsafe_shapes_and_symlinks(void) {
+    char target[] = "/tmp/ds4-ckvstore-target.XXXXXX";
+    int fd = mkstemp(target);
+    CHECK(fd >= 0, "mkstemp symlink target");
+    if (fd < 0) return;
+    close(fd);
+    char linkpath[256];
+    snprintf(linkpath, sizeof(linkpath), "%s.link", target);
+    unlink(linkpath);
+    CHECK(symlink(target, linkpath) == 0, "create symlink fixture");
+
+    ds4_ckvstore_config cfg = test_config();
+    ds4_ckvstore *store = NULL;
+    char err[256] = {0};
+    CHECK(ds4_ckvstore_open(&store, linkpath, &cfg, false, err, sizeof(err)) ==
+              DS4_CKVSTORE_ERR_IO,
+          "cache path symlink is rejected");
+
+    cfg.row_bytes = UINT32_MAX;
+    cfg.rows_per_record = UINT32_MAX;
+    CHECK(ds4_ckvstore_open(&store, target, &cfg, true, err, sizeof(err)) ==
+              DS4_CKVSTORE_ERR_INVALID,
+          "overflowing record shape is rejected before allocation");
+    unlink(linkpath);
+    unlink(target);
+}
