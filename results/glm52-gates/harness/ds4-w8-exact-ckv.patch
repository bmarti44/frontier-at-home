+static int glm_graph_ckv_hex_nibble(char c) {
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+static bool glm_graph_ckv_parse_sha256(const char *hex, uint8_t out[32]) {
+    if (!hex || strlen(hex) != 64) return false;
+    for (uint32_t i = 0; i < 32; i++) {
+        const int hi = glm_graph_ckv_hex_nibble(hex[2u * i]);
+        const int lo = glm_graph_ckv_hex_nibble(hex[2u * i + 1u]);
+        if (hi < 0 || lo < 0) return false;
+        out[i] = (uint8_t)((hi << 4) | lo);
+    }
+    return true;
+}
+
+static bool glm_graph_ckv_random_bytes(void *ptr, size_t bytes) {
+    int fd = open("/dev/urandom", O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) return false;
+    uint8_t *p = ptr;
+    while (bytes) {
+        ssize_t n = read(fd, p, bytes);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) { close(fd); return false; }
+        p += n;
+        bytes -= (size_t)n;
+    }
+    return close(fd) == 0;
+}
+
+static uint64_t glm_graph_ckv_max_file_bytes(void) {
+    uint64_t gib = 192u;
+    const char *env = getenv("DS4_GLM_CKV_MAX_GIB");
+    if (env && env[0]) {
+        char *end = NULL;
+        errno = 0;
+        unsigned long long value = strtoull(env, &end, 10);
+        if (end == env || *end != '\0' || errno != 0 ||
+            value < 1u || value > 512u) return 0;
+        gib = value;
+    }
+    return gib * 1024ull * 1024ull * 1024ull;
+}
+
+static bool glm_graph_ckv_exact_open(ds4_glm_gpu_graph *g) {
+    if (!g || !g->ckv_nvme_exact) return true;
+    if (g->ckv_store) return false;
+    const char *directory = getenv("DS4_GLM_CKV_DIR");
+    const char *model_sha = getenv("DS4_GLM_CKV_MODEL_SHA256");
+    if (!directory || !directory[0] || !model_sha || !model_sha[0]) {
+        fprintf(stderr,
+                "ds4: W8 requires private DS4_GLM_CKV_DIR and "
+                "DS4_GLM_CKV_MODEL_SHA256\n");
+        return false;
+    }
+    ds4_ckvstore_config cfg = {
+        .row_bytes = (uint32_t)(glm_graph_compact_latent_row_bytes() +
+                                glm_graph_compact_rope_row_bytes()),
+        .rows_per_record = DS4_GLM_CKV_RECORD_ROWS,
+        .max_cached_records = DS4_GLM_CKV_CACHE_RECORDS,
+        .max_epochs = g->layer_count,
+        .generation = g->ckv_generation + 1u,
+        .max_file_bytes = glm_graph_ckv_max_file_bytes(),
+        .sync_interval_bytes = DS4_GLM_CKV_SYNC_INTERVAL_BYTES,
+        .buffer_tail_rows = true,
+    };
+    if (cfg.generation == 0) {
+        fprintf(stderr, "ds4: W8 request generation exhausted\n");
+        return false;
+    }
+    if (!cfg.max_file_bytes ||
+        !glm_graph_ckv_parse_sha256(model_sha, cfg.model_binding) ||
+        !glm_graph_ckv_random_bytes(cfg.session_id, sizeof(cfg.session_id))) {
+        fprintf(stderr, "ds4: invalid W8 identity or file-size configuration\n");
+        return false;
+    }
+    static const char format_binding[] = "glm-ckv-exact-f32-v1";
+    _Static_assert(sizeof(format_binding) <= sizeof(cfg.format_binding),
+                   "exact cKV format binding must fit the record header");
+    memcpy(cfg.format_binding, format_binding, sizeof(format_binding));
+    char err[256] = {0};
+    char created_path[PATH_MAX];
+    const int rc = ds4_ckvstore_create_request(
+        &g->ckv_store, directory, &cfg, created_path, sizeof(created_path),
+        err, sizeof(err));
+    if (rc != DS4_CKVSTORE_OK) {
+        fprintf(stderr, "ds4: failed to create W8 cKV store: %s\n", err);
+        return false;
+    }
+    free(g->ckv_path);
+    g->ckv_path = strdup(created_path);
+    g->ckv_host_rows = g->ckv_exact_write_rows > g->ckv_exact_selected_rows
+        ? g->ckv_exact_write_rows : g->ckv_exact_selected_rows;
+    const uint64_t host_bytes = g->ckv_host_rows * cfg.row_bytes;
+    const uint64_t selected_id_bytes =
+        (uint64_t)g->ckv_exact_selected_rows * sizeof(uint32_t);
+    if (!g->ckv_path || host_bytes > SIZE_MAX ||
+        selected_id_bytes > SIZE_MAX - host_bytes) return false;
+    const uint64_t host_alloc_bytes = host_bytes + selected_id_bytes;
+    if (!g->ckv_io_host) {
+#if defined(__APPLE__) || defined(DS4_ROCM_BUILD)
+        g->ckv_io_host = malloc((size_t)host_alloc_bytes);
+#else
+        if (!ds4_gpu_host_alloc_pinned((void **)&g->ckv_io_host,
+                                       host_alloc_bytes)) {
+            fprintf(stderr,
+                    "ds4: exact cKV requires persistent pinned staging\n");
+            return false;
+        }
+        g->ckv_io_host_pinned = true;
+#endif
+    }
+    g->ckv_selected_ids_host =
+        (uint32_t *)(g->ckv_io_host + host_bytes);
+    if (!g->ckv_record_host)
+        g->ckv_record_host = malloc((size_t)host_bytes);
+    if (!g->ckv_io_host || !g->ckv_record_host ||
+        !g->ckv_selected_ids_host) {
+        ds4_ckvstore_close(g->ckv_store);
+        g->ckv_store = NULL;
+        free(g->ckv_path);
+        g->ckv_path = NULL;
+        return false;
+    }
+    g->ckv_generation = cfg.generation;
+    fprintf(stderr,
+            "ds4: W8 request cKV store=%s write_rows=%u selected_rows=%u "
+            "host_buffers=%.2f MiB max_file=%.2f GiB\n",
+            g->ckv_path, g->ckv_exact_write_rows,
+            g->ckv_exact_selected_rows,
+            (double)(2u * host_bytes +
+                (uint64_t)g->ckv_exact_selected_rows * sizeof(uint32_t)) /
+                (1024.0 * 1024.0),
+            (double)cfg.max_file_bytes / (1024.0 * 1024.0 * 1024.0));
+    return true;
+}
+
+static bool glm_graph_ckv_exact_reset_lineage(ds4_glm_gpu_graph *g) {
+    if (!g || !g->ckv_nvme_exact) return true;
+    ds4_ckvstore_close(g->ckv_store);
+    g->ckv_store = NULL;
+    free(g->ckv_path);
+    g->ckv_path = NULL;
+    g->ckv_append_calls = 0;
+    g->ckv_appended_rows = 0;
+    g->ckv_selected_read_calls = 0;
+    g->ckv_selected_rows = 0;
+    g->ckv_direct_slot_calls = 0;
+    return glm_graph_ckv_exact_open(g);
+}
+
+static bool glm_graph_store_ckv_exact_rows(
+        ds4_glm_gpu_graph *g, uint32_t layer,
+        const ds4_gpu_tensor *kv_norm, const ds4_gpu_tensor *kv_raw,
+        uint32_t pos0, uint32_t n_tokens, uint32_t kv_raw_dim) {
+    if (!g || layer >= DS4_MAX_LAYER) return false;
+    ds4_gpu_tensor *lora = g->ckv_nvme_exact
+        ? g->ckv_write_lora : g->layer_kv_lora_cache[layer];
+    ds4_gpu_tensor *rope = g->ckv_nvme_exact
+        ? g->ckv_write_rope : g->layer_k_rope_cache[layer];
+    const uint32_t target_pos = g->ckv_nvme_exact ? 0u : pos0;
+    const uint32_t target_cap = g->ckv_nvme_exact
+        ? g->ckv_exact_write_rows : g->compact_cache_cap;
+    if (!lora || !rope || !n_tokens || n_tokens > target_cap) return false;
