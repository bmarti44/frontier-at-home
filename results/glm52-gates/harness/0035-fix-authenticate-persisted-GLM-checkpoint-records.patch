+static bool kv_record_digest(FILE *fp, uint32_t text_bytes,
+                             uint64_t payload_bytes, uint8_t out[32]) {
+    if (!fp || payload_bytes > UINT64_MAX - (uint64_t)text_bytes - 4u) return false;
+    if (pthread_once(&kv_crypto_once, kv_crypto_init_once) != 0 ||
+        !kv_crypto.available) return false;
+    const off_t saved = ftello(fp);
+    if (saved < 0 || fseeko(fp, 0, SEEK_SET) != 0) return false;
+
+    uint8_t header[DS4_KVSTORE_FIXED_HEADER];
+    uint8_t text_len[4];
+    bool ok = fread(header, 1, sizeof(header), fp) == sizeof(header) &&
+              fread(text_len, 1, sizeof(text_len), fp) == sizeof(text_len) &&
+              ds4_kvstore_le_get32(text_len) == text_bytes &&
+              kv_le_get64(header + 40) == payload_bytes;
+    void *ctx = ok ? kv_crypto.ctx_new() : NULL;
+    const void *algorithm = ctx ? kv_crypto.sha256() : NULL;
+    ok = ok && ctx && algorithm && kv_crypto.init(ctx, algorithm, NULL) == 1;
+    if (ok) {
+        /* These fields are mutable bookkeeping. Everything else, plus the
+         * text length, exact text, and exact payload, is immutable and bound. */
+        memset(header + 12, 0, 4); /* hit count */
+        memset(header + 32, 0, 8); /* last used */
+        memset(header + 48, 0, 32); /* stored digest */
+        ok = kv_crypto.update(ctx, header, sizeof(header)) == 1 &&
+             kv_crypto.update(ctx, text_len, sizeof(text_len)) == 1;
+    }
+    uint64_t remaining = (uint64_t)text_bytes + payload_bytes;
+    uint8_t buffer[64 * 1024];
+    while (ok && remaining != 0) {
+        size_t chunk = remaining < sizeof(buffer) ? (size_t)remaining : sizeof(buffer);
+        ok = fread(buffer, 1, chunk, fp) == chunk &&
+             kv_crypto.update(ctx, buffer, chunk) == 1;
+        remaining -= chunk;
+    }
+    unsigned int digest_bytes = 0;
+    ok = ok && kv_crypto.final(ctx, out, &digest_bytes) == 1 && digest_bytes == 32;
+    if (ctx) kv_crypto.ctx_free(ctx);
+    if (fseeko(fp, saved, SEEK_SET) != 0) ok = false;
+    return ok;
+}
