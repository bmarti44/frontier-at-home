+static pthread_once_t kv_crypto_once = PTHREAD_ONCE_INIT;
+
+static void kv_crypto_init_once(void) {
+    static const char *const libraries[] = {
+        "libcrypto.so.3", "libcrypto.so", "libcrypto.3.dylib", "libcrypto.dylib",
+    };
+    for (size_t i = 0; i < sizeof(libraries) / sizeof(libraries[0]); i++) {
+        void *handle = dlopen(libraries[i], RTLD_NOW | RTLD_LOCAL);
+        if (!handle) continue;
+#define KV_CRYPTO_SYMBOL(field, name) do { \
+            void *sym = dlsym(handle, name); \
+            memcpy(&kv_crypto.field, &sym, sizeof(kv_crypto.field)); \
+        } while (0)
+        KV_CRYPTO_SYMBOL(ctx_new, "EVP_MD_CTX_new");
+        KV_CRYPTO_SYMBOL(ctx_free, "EVP_MD_CTX_free");
+        KV_CRYPTO_SYMBOL(sha256, "EVP_sha256");
+        KV_CRYPTO_SYMBOL(init, "EVP_DigestInit_ex");
+        KV_CRYPTO_SYMBOL(update, "EVP_DigestUpdate");
+        KV_CRYPTO_SYMBOL(final, "EVP_DigestFinal_ex");
+#undef KV_CRYPTO_SYMBOL
+        if (kv_crypto.ctx_new && kv_crypto.ctx_free && kv_crypto.sha256 &&
+            kv_crypto.init && kv_crypto.update && kv_crypto.final) {
+            kv_crypto.handle = handle;
+            kv_crypto.available = true;
+            return;
+        }
+        memset(&kv_crypto, 0, sizeof(kv_crypto));
+        dlclose(handle);
+    }
+}
