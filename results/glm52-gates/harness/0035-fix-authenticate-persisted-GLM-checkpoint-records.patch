+static struct {
+    void *handle;
+    kv_md_ctx_new_fn ctx_new;
+    kv_md_ctx_free_fn ctx_free;
+    kv_evp_sha256_fn sha256;
+    kv_digest_init_fn init;
+    kv_digest_update_fn update;
+    kv_digest_final_fn final;
+    bool available;
