-    if (ok && shared_first && (pf_shared_correction || pf_pair_probe) &&
+    if (ok && shared_first &&
+        (pf_shared_correction || pf_pair_probe || pf_baseline_capture) &&
         il + 1u < normal_layers) {
         const ds4_layer_weights *lnext = l + 1;
         ds4_gpu_tensor *pf_corrected_state = g->batch_cur;
@@ -40668,6 +40769,11 @@ static bool glm_graph_encode_sparse_ffn_one(
         }
         bool corrected_restarted = ds4_gpu_begin_commands() != 0;
         corrected_ok = corrected_ok && corrected_ended && corrected_restarted;
+        if (corrected_ok && pf_baseline_capture) {
+            corrected_ok = glm_graph_baseline_capture_router(
+                g, g->batch_router_probs, g->batch_router_selected,
+                il + 1u, true);
+        }
         if (!corrected_ok) {
             ok = false;
         } else {
@@ -60491,6 +60597,263 @@ int ds4_session_eval(ds4_session *s, int token, char *err, size_t errlen) {
     return ds4_session_eval_probe_tp(s, token, probe_mtp, err, errlen);
 }
 
+#ifndef DS4_NO_GPU
+static bool glm_graph_baseline_capture_alloc(ds4_glm_gpu_graph *g) {
+    if (!g || g->baseline_capture_scores || g->baseline_capture_selected ||
+        g->baseline_capture_shared_scores || g->baseline_capture_shared_selected ||
+        g->baseline_capture_mtp_scores || g->baseline_capture_mtp_selected) {
+        return false;
+    }
+    const uint64_t score_rows = (uint64_t)DS4_N_LAYER * DS4_N_EXPERT;
+    const uint64_t selected_rows =
+        (uint64_t)DS4_N_LAYER * DS4_N_EXPERT_USED;
+    g->baseline_capture_scores = malloc(score_rows * sizeof(float));
+    g->baseline_capture_selected = malloc(selected_rows * sizeof(int32_t));
+    g->baseline_capture_shared_scores = malloc(score_rows * sizeof(float));
+    g->baseline_capture_shared_selected = malloc(selected_rows * sizeof(int32_t));
+    g->baseline_capture_mtp_scores = malloc(
+        DS4_GLM_BASELINE_MAX_K * score_rows * sizeof(float));
+    g->baseline_capture_mtp_selected = malloc(
+        DS4_GLM_BASELINE_MAX_K * selected_rows * sizeof(int32_t));
+    if (!g->baseline_capture_scores || !g->baseline_capture_selected ||
+        !g->baseline_capture_shared_scores || !g->baseline_capture_shared_selected ||
+        !g->baseline_capture_mtp_scores || !g->baseline_capture_mtp_selected) {
+        return false;
+    }
+    for (uint64_t i = 0; i < score_rows; i++) {
+        g->baseline_capture_scores[i] = NAN;
+        g->baseline_capture_shared_scores[i] = NAN;
+    }
+    for (uint64_t i = 0; i < selected_rows; i++) {
+        g->baseline_capture_selected[i] = -1;
+        g->baseline_capture_shared_selected[i] = -1;
+    }
+    for (uint64_t i = 0; i < DS4_GLM_BASELINE_MAX_K * score_rows; i++) {
+        g->baseline_capture_mtp_scores[i] = NAN;
+    }
+    for (uint64_t i = 0; i < DS4_GLM_BASELINE_MAX_K * selected_rows; i++) {
+        g->baseline_capture_mtp_selected[i] = -1;
+    }
+    g->baseline_capture_step = 0;
+    g->baseline_capture_active = false;
+    g->baseline_capture_failed = false;
+    return true;
+}
+
+static bool glm_graph_baseline_capture_complete(const ds4_glm_gpu_graph *g) {
+    if (!g || g->baseline_capture_failed) return false;
+    for (uint32_t il = 4; il <= 77; il++) {
+        for (uint32_t expert = 0; expert < DS4_N_EXPERT; expert++) {
+            const uint64_t offset = (uint64_t)il * DS4_N_EXPERT + expert;
+            if (!isfinite(g->baseline_capture_scores[offset]) ||
+                !isfinite(g->baseline_capture_shared_scores[offset])) {
+                return false;
+            }
+            for (uint32_t step = 0; step < DS4_GLM_BASELINE_MAX_K; step++) {
+                const uint64_t mtp_offset =
+                    ((uint64_t)step * DS4_N_LAYER + il) * DS4_N_EXPERT + expert;
+                if (!isfinite(g->baseline_capture_mtp_scores[mtp_offset])) return false;
+            }
+        }
+        for (uint32_t rank = 0; rank < DS4_N_EXPERT_USED; rank++) {
+            const uint64_t offset = (uint64_t)il * DS4_N_EXPERT_USED + rank;
+            if (g->baseline_capture_selected[offset] < 0 ||
+                g->baseline_capture_shared_selected[offset] < 0) return false;
+            for (uint32_t step = 0; step < DS4_GLM_BASELINE_MAX_K; step++) {
+                const uint64_t mtp_offset =
+                    ((uint64_t)step * DS4_N_LAYER + il) * DS4_N_EXPERT_USED + rank;
+                if (g->baseline_capture_mtp_selected[mtp_offset] < 0) return false;
+            }
+        }
+    }
+    return true;
+}
+
+static bool glm_baseline_capture_publish(
+        const char *directory,
+        uint32_t source_pos,
+        uint32_t token_count,
+        const int predicted[DS4_GLM_BASELINE_MAX_K],
+        double elapsed_ms,
+        const ds4_glm_gpu_graph *g) {
+    char base[1024];
+    if (!directory || !g ||
+        snprintf(base, sizeof(base), "%s/source-%08u", directory, source_pos) >=
+            (int)sizeof(base)) return false;
+    struct artifact {
+        const char *suffix;
+        const void *data;
+        size_t bytes;
+    } artifacts[] = {
+        {"-gate-scores.f32", g->baseline_capture_scores,
+         (size_t)DS4_N_LAYER * DS4_N_EXPERT * sizeof(float)},
+        {"-gate-selected.i32", g->baseline_capture_selected,
+         (size_t)DS4_N_LAYER * DS4_N_EXPERT_USED * sizeof(int32_t)},
+        {"-shared-scores.f32", g->baseline_capture_shared_scores,
+         (size_t)DS4_N_LAYER * DS4_N_EXPERT * sizeof(float)},
+        {"-shared-selected.i32", g->baseline_capture_shared_selected,
+         (size_t)DS4_N_LAYER * DS4_N_EXPERT_USED * sizeof(int32_t)},
+        {"-mtp-scores.f32", g->baseline_capture_mtp_scores,
+         (size_t)DS4_GLM_BASELINE_MAX_K * DS4_N_LAYER * DS4_N_EXPERT * sizeof(float)},
+        {"-mtp-selected.i32", g->baseline_capture_mtp_selected,
+         (size_t)DS4_GLM_BASELINE_MAX_K * DS4_N_LAYER * DS4_N_EXPERT_USED * sizeof(int32_t)},
+        {"-predicted.i32", predicted,
+         (size_t)DS4_GLM_BASELINE_MAX_K * sizeof(int32_t)},
+    };
+    char path[1100];
+    for (size_t i = 0; i < sizeof(artifacts) / sizeof(artifacts[0]); i++) {
+        if (snprintf(path, sizeof(path), "%s%s", base, artifacts[i].suffix) >=
+                (int)sizeof(path) ||
+            !glm_union_trace_write_exclusive(path, artifacts[i].data,
+                                              artifacts[i].bytes)) {
+            return false;
+        }
+    }
+    char metadata[2048];
+    const int length = snprintf(
+        metadata, sizeof(metadata),
+        "{\"format\":\"glm52-p1-baseline-source-v1\","
+        "\"source_position\":%u,\"prompt_tokens\":%u,"
+        "\"layers_first\":4,\"layers_last\":77,"
+        "\"experts\":%u,\"selected\":%u,\"K\":8,"
+        "\"elapsed_ms\":%.17g,"
+        "\"predicted_tokens\":[%d,%d,%d,%d,%d,%d,%d,%d]}\n",
+        source_pos, token_count, (unsigned)DS4_N_EXPERT,
+        (unsigned)DS4_N_EXPERT_USED, elapsed_ms,
+        predicted[0], predicted[1], predicted[2], predicted[3],
+        predicted[4], predicted[5], predicted[6], predicted[7]);
+    if (length <= 0 || length >= (int)sizeof(metadata) ||
+        snprintf(path, sizeof(path), "%s.json", base) >= (int)sizeof(path) ||
+        !glm_union_trace_write_exclusive(path, metadata, (size_t)length)) {
+        return false;
+    }
+    return true;
+}
+#endif
