+int ds4_session_glm_baseline_capture(
+        ds4_engine *engine,
+        const ds4_tokens *tokens,
+        int ctx_size,
+        const char *directory,
+        char *err,
+        size_t errlen) {
+    /* Publication uses glm_union_trace_write_exclusive (O_EXCL + fsync),
+     * followed by an fsync of the newly created directory below. */
+    if (!engine || !tokens || !directory || !directory[0] ||
+        tokens->len < 16 || ctx_size < tokens->len + (int)DS4_GLM_BASELINE_MAX_K + 1) {
+        if (errlen) snprintf(err, errlen, "invalid GLM baseline capture input");
+        return 1;
+    }
+#ifdef DS4_NO_GPU
+    if (errlen) snprintf(err, errlen, "GLM baseline capture requires GPU support");
+    return 1;
+#else
+    if (DS4_MODEL_FAMILY != DS4_MODEL_FAMILY_GLM_DSA ||
+        !ds4_engine_glm_mtp_spec_enabled(engine)) {
+        if (errlen) snprintf(err, errlen, "GLM baseline capture precondition failed");
+        return 1;
+    }
+    const char *cache_gb = getenv("DS4_CUDA_EXPERT_CACHE_GB");
+    if ((cache_gb && cache_gb[0] && strtod(cache_gb, NULL) > 0.0) ||
+        mkdir(directory, 0700) != 0) {
+        if (errlen) snprintf(err, errlen,
+                            "GLM baseline capture requires a fresh cache-disabled directory");
+        return 1;
+    }
+    const uint32_t token_count = (uint32_t)tokens->len;
+    const uint32_t first_source = token_count - 16u;
+    const uint32_t last_source = token_count - 9u;
+    const uint32_t source_count = last_source - first_source + 1u;
+    if (source_count != 8u || token_count < 16u) {
+        if (errlen) snprintf(err, errlen, "GLM baseline structural source count differs");
+        return 1;
+    }
+    bool baseline_capture_failed = false;
+    for (uint32_t source_pos = first_source;
+         !baseline_capture_failed && source_pos <= last_source;
+         source_pos++) {
+        ds4_session *session = NULL;
+        ds4_tokens prefix = {0};
+        int predicted[DS4_GLM_BASELINE_MAX_K] = {0};
+        float *hidden = NULL;
+        const double started = now_sec();
+        if (ds4_session_create(&session, engine, ctx_size) != 0 || !session ||
+            !session->glm_graph_ready ||
+            !glm_graph_baseline_capture_alloc(&session->glm_graph)) {
+            baseline_capture_failed = true;
+        }
+        for (uint32_t i = 0; !baseline_capture_failed && i < source_pos; i++) {
+            ds4_tokens_push(&prefix, tokens->v[i]);
+        }
+        if (!baseline_capture_failed &&
+            ds4_session_sync(session, &prefix, err, errlen) != 0) {
+            baseline_capture_failed = true;
+        }
+        ds4_glm_gpu_graph *g = session ? &session->glm_graph : NULL;
+        if (!baseline_capture_failed) {
+            g->baseline_capture_step = 0u;
+            g->baseline_capture_active = true;
+            if (ds4_session_eval(session, tokens->v[source_pos], err, errlen) != 0) {
+                baseline_capture_failed = true;
+            }
+            g->baseline_capture_active = false;
+        }
+        if (!baseline_capture_failed) {
+            predicted[0] = glm_session_logits_argmax(session->logits);
+            hidden = malloc((size_t)DS4_N_EMBD * sizeof(float));
+            if (!hidden) baseline_capture_failed = true;
+        }
+        for (uint32_t step = 1u;
+             !baseline_capture_failed && step <= DS4_GLM_BASELINE_MAX_K;
+             step++) {
+            if (step < DS4_GLM_BASELINE_MAX_K) {
+                int next = -1;
+                if (ds4_gpu_tensor_read(g->cur, 0, hidden,
+                                        (uint64_t)DS4_N_EMBD * sizeof(float)) == 0 ||
+                    !glm_graph_mtp_step(g, &engine->model, &engine->weights,
+                                        predicted[step - 1u],
+                                        source_pos + step - 1u,
+                                        source_pos, &next) ||
+                    ds4_gpu_tensor_write(g->cur, 0, hidden,
+                                         (uint64_t)DS4_N_EMBD * sizeof(float)) == 0) {
+                    baseline_capture_failed = true;
+                    break;
+                }
+                predicted[step] = next;
+            }
+            g->baseline_capture_step = step;
+            g->baseline_capture_active = true;
+            if (ds4_session_eval(session, predicted[step - 1u], err, errlen) != 0) {
+                baseline_capture_failed = true;
+            }
+            g->baseline_capture_active = false;
+        }
+        if (!baseline_capture_failed &&
+            (!glm_graph_baseline_capture_complete(g) ||
+             !glm_baseline_capture_publish(
+                 directory, source_pos, token_count, predicted,
+                 (now_sec() - started) * 1000.0, g))) {
+            baseline_capture_failed = true;
+        }
+        free(hidden);
+        ds4_tokens_free(&prefix);
+        ds4_session_free(session);
+    }
+    const int directory_fd = open(directory, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (directory_fd < 0 || fsync(directory_fd) != 0) baseline_capture_failed = true;
+    if (directory_fd >= 0 && close(directory_fd) != 0) baseline_capture_failed = true;
+    if (baseline_capture_failed) {
+        if (errlen && (!err || !err[0])) snprintf(err, errlen, "GLM baseline capture failed");
+        return 1;
+    }
+    fprintf(stderr,
+            "ds4: GLM baseline capture completed sources=%u token_count=%u directory=%s\n",
+            source_count, token_count, directory);
+    return 0;
+#endif
+}
