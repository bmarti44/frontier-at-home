+static bool glm_graph_baseline_capture_router(
+        ds4_glm_gpu_graph *g,
+        ds4_gpu_tensor    *scores,
+        ds4_gpu_tensor    *selected,
+        uint32_t           il,
+        bool               shared) {
+    if (!g || !g->baseline_capture_active) return true;
+    if (!scores || !selected || il >= DS4_MAX_LAYER || il >= DS4_N_LAYER) {
+        if (g) g->baseline_capture_failed = true;
+        return false;
+    }
+    const uint32_t step = g->baseline_capture_step;
+    float *score_dst = NULL;
+    int32_t *selected_dst = NULL;
+    if (shared) {
+        if (step != 0u || !g->baseline_capture_shared_scores ||
+            !g->baseline_capture_shared_selected) {
+            g->baseline_capture_failed = true;
+            return false;
+        }
+        score_dst = g->baseline_capture_shared_scores +
+            (uint64_t)il * DS4_GLM_BASELINE_N_EXPERT;
+        selected_dst = g->baseline_capture_shared_selected +
+            (uint64_t)il * DS4_N_EXPERT_USED;
+    } else if (step == 0u) {
+        if (!g->baseline_capture_scores || !g->baseline_capture_selected) {
+            g->baseline_capture_failed = true;
+            return false;
+        }
+        score_dst = g->baseline_capture_scores +
+            (uint64_t)il * DS4_GLM_BASELINE_N_EXPERT;
+        selected_dst = g->baseline_capture_selected +
+            (uint64_t)il * DS4_N_EXPERT_USED;
+    } else if (step <= DS4_GLM_BASELINE_MAX_K) {
+        if (!g->baseline_capture_mtp_scores || !g->baseline_capture_mtp_selected) {
+            g->baseline_capture_failed = true;
+            return false;
+        }
+        const uint64_t layer_index =
+            ((uint64_t)(step - 1u) * DS4_N_LAYER + il);
+        score_dst = g->baseline_capture_mtp_scores +
+            layer_index * DS4_GLM_BASELINE_N_EXPERT;
+        selected_dst = g->baseline_capture_mtp_selected +
+            layer_index * DS4_N_EXPERT_USED;
+    } else {
+        g->baseline_capture_failed = true;
+        return false;
+    }
+
+    const bool ended = ds4_gpu_end_commands() != 0;
+    const bool read_scores = ended && ds4_gpu_tensor_read(
+        scores, 0, score_dst,
+        (uint64_t)DS4_N_EXPERT * sizeof(float)) != 0;
+    const bool read_selected = read_scores && ds4_gpu_tensor_read(
+        selected, 0, selected_dst,
+        (uint64_t)DS4_N_EXPERT_USED * sizeof(int32_t)) != 0;
+    const bool restarted = ds4_gpu_begin_commands() != 0;
+    bool ok = ended && read_scores && read_selected && restarted;
+    for (uint32_t i = 0; ok && i < DS4_N_EXPERT; i++) {
+        if (!isfinite(score_dst[i])) ok = false;
+    }
+    for (uint32_t i = 0; ok && i < DS4_N_EXPERT_USED; i++) {
+        if (selected_dst[i] < 0 || selected_dst[i] >= (int32_t)DS4_N_EXPERT) {
+            ok = false;
+            break;
+        }
+        for (uint32_t j = 0; j < i; j++) {
+            if (selected_dst[i] == selected_dst[j]) ok = false;
+        }
+    }
+    if (!ok) g->baseline_capture_failed = true;
+    return ok;
+}
