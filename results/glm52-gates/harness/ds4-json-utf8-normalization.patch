+static void test_generated_json_replaces_invalid_utf8(void) {
+    const char raw[] = {
+        (char)0xe5, (char)0xae, (char)0x86,
+        (char)0xe8, (char)0x81, ',', ' ', 'a', 'n', 'd', 0,
+    };
+    const char expected[] = {
+        '"', (char)0xe5, (char)0xae, (char)0x86,
+        (char)0xef, (char)0xbf, (char)0xbd,
+        ',', ' ', 'a', 'n', 'd', '"', 0,
+    };
+    const char valid[] = {
+        'A', (char)0xf0, (char)0x9f, (char)0x9a, (char)0xa9, 'Z', 0,
+    };
+    const char valid_expected[] = {
+        '"', 'A', (char)0xf0, (char)0x9f, (char)0x9a, (char)0xa9, 'Z', '"', 0,
+    };
+    const char embedded_nul[] = {'A', 0, 'B'};
+    const char truncated[] = {(char)0xf0, (char)0x9f};
+    const char bad_continuation[] = {(char)0xe8, 'A'};
+    const char stray_continuation[] = {(char)0x80};
+    const char overlong[] = {(char)0xc0, (char)0xaf};
+    const char surrogate[] = {(char)0xed, (char)0xa0, (char)0x80};
+    const char above_unicode[] = {(char)0xf4, (char)0x90, (char)0x80, (char)0x80};
+    const char e0_bad_short[] = {(char)0xe0, (char)0x80, 'A'};
+    const char ed_bad_short[] = {(char)0xed, (char)0xa0, 'A'};
+    const char f0_bad_short[] = {(char)0xf0, (char)0x80, (char)0x80, 'A'};
+    const char f4_bad_short[] = {(char)0xf4, (char)0x90, (char)0x80, 'A'};
+    const char replacement[] = {(char)0xef, (char)0xbf, (char)0xbd, 0};
+    struct {
+        const char *bytes;
+        size_t len;
+        int replacements;
+        const char *ascii_tail;
+    } invalid_cases[] = {
+        {truncated, sizeof(truncated), 1, NULL},
+        {bad_continuation, sizeof(bad_continuation), 1, "A\""},
+        {stray_continuation, sizeof(stray_continuation), 1, NULL},
+        {overlong, sizeof(overlong), 2, NULL},
+        {surrogate, sizeof(surrogate), 3, NULL},
+        {above_unicode, sizeof(above_unicode), 4, NULL},
+        {e0_bad_short, sizeof(e0_bad_short), 2, "A\""},
+        {ed_bad_short, sizeof(ed_bad_short), 2, "A\""},
+        {f0_bad_short, sizeof(f0_bad_short), 3, "A\""},
+        {f4_bad_short, sizeof(f4_bad_short), 3, "A\""},
+    };
+
+    TEST_ASSERT(unsetenv("DS4_JSON_REPLACE_INVALID_UTF8") == 0);
+    buf legacy = {0};
+    json_escape_n(&legacy, raw, sizeof(raw) - 1);
+    TEST_ASSERT(legacy.len == sizeof(raw) + 1);
+    TEST_ASSERT(legacy.ptr[0] == '"' && legacy.ptr[legacy.len - 1] == '"');
+    TEST_ASSERT(!memcmp(legacy.ptr + 1, raw, sizeof(raw) - 1));
+    buf_free(&legacy);
+
+    TEST_ASSERT(setenv("DS4_JSON_REPLACE_INVALID_UTF8", "1", 1) == 0);
+    buf normalized = {0};
+    json_escape_n(&normalized, raw, sizeof(raw) - 1);
+    TEST_ASSERT(normalized.ptr && !strcmp(normalized.ptr, expected));
+    buf_free(&normalized);
+
+    buf preserved = {0};
+    json_escape_n(&preserved, valid, sizeof(valid) - 1);
+    TEST_ASSERT(preserved.ptr && !strcmp(preserved.ptr, valid_expected));
+    buf_free(&preserved);
+
+    buf binary = {0};
+    json_escape_n(&binary, embedded_nul, sizeof(embedded_nul));
+    TEST_ASSERT(binary.ptr && !strcmp(binary.ptr, "\"A\\u0000B\""));
+    buf_free(&binary);
+
+    for (size_t ci = 0; ci < sizeof(invalid_cases) / sizeof(invalid_cases[0]); ci++) {
+        buf encoded = {0};
+        json_escape_n(&encoded, invalid_cases[ci].bytes, invalid_cases[ci].len);
+        int seen = 0;
+        for (const char *p = encoded.ptr; p && (p = strstr(p, replacement)); p += 3) seen++;
+        TEST_ASSERT(seen == invalid_cases[ci].replacements);
+        TEST_ASSERT(!invalid_cases[ci].ascii_tail ||
+                    strstr(encoded.ptr, invalid_cases[ci].ascii_tail) != NULL);
+        buf_free(&encoded);
+    }
+    TEST_ASSERT(unsetenv("DS4_JSON_REPLACE_INVALID_UTF8") == 0);
+}
+
+static void test_assert_strict_json_wire(const char *wire, bool sse) {
+    size_t n = strlen(wire);
+    for (size_t i = 0; i < n;) {
+        unsigned char c = (unsigned char)wire[i];
+        size_t valid = c < 0x80 ? 1 :
+            json_utf8_sequence_len((const unsigned char *)wire + i, n - i);
+        TEST_ASSERT(valid > 0);
+        if (!valid) return;
+        i += valid;
+    }
+    if (!sse) {
+        const char *body = strstr(wire, "\r\n\r\n");
+        TEST_ASSERT(body != NULL);
+        if (!body) return;
+        body += 4;
+        const char *p = body;
+        TEST_ASSERT(json_skip_value(&p));
+        json_ws(&p);
+        TEST_ASSERT(*p == '\0');
+        return;
+    }
+    for (const char *line = wire; (line = strstr(line, "data: ")) != NULL;) {
+        line += 6;
+        const char *end = strchr(line, '\n');
+        TEST_ASSERT(end != NULL);
+        if (!end) return;
+        if ((size_t)(end - line) != strlen("[DONE]") ||
+            memcmp(line, "[DONE]", strlen("[DONE]"))) {
+            char *payload = xstrndup(line, (size_t)(end - line));
+            const char *p = payload;
+            TEST_ASSERT(json_skip_value(&p));
+            json_ws(&p);
+            TEST_ASSERT(*p == '\0');
+            free(payload);
+        }
+        line = end;
+    }
+}
