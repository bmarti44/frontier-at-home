+static void test_openai_stream_replaces_invalid_utf8(void) {
+    int sv[2];
+    TEST_ASSERT(socketpair(AF_UNIX, SOCK_STREAM, 0, sv) == 0);
+    if (sv[0] < 0 || sv[1] < 0) return;
+    TEST_ASSERT(setenv("DS4_JSON_REPLACE_INVALID_UTF8", "1", 1) == 0);
+
+    request r;
+    request_init(&r, REQ_CHAT, 128);
+    r.api = API_OPENAI;
+    r.stream = true;
+    r.think_mode = DS4_THINK_NONE;
+    openai_stream st;
+    openai_stream_start(&r, &st);
+    const char raw[] = {
+        (char)0xe5, (char)0xae, (char)0x86,
+        (char)0xe8, (char)0x81, ',', ' ', 'a', 'n', 'd', 0,
+    };
+    TEST_ASSERT(openai_sse_stream_update(sv[0], NULL, &r, "chatcmpl_invalid_utf8",
+                                         &st, raw, sizeof(raw) - 1, false));
+    shutdown(sv[0], SHUT_WR);
+    char *out = read_socket_text(sv[1]);
+    const char visible[] = {
+        (char)0xe5, (char)0xae, (char)0x86,
+        (char)0xef, (char)0xbf, (char)0xbd,
+        ',', ' ', 'a', 'n', 'd', 0,
+    };
+    TEST_ASSERT(strstr(out, visible) != NULL);
+    test_assert_strict_json_wire(out, true);
+
+    free(out);
+    openai_stream_free(&st);
+    request_free(&r);
+    close(sv[0]);
+    close(sv[1]);
+    TEST_ASSERT(unsetenv("DS4_JSON_REPLACE_INVALID_UTF8") == 0);
+}
