diff --git a/tests/test_union_trace_corpus_source.py b/tests/test_union_trace_corpus_source.py
new file mode 100644
index 0000000..d59855a
--- /dev/null
+++ b/tests/test_union_trace_corpus_source.py
@@ -0,0 +1,114 @@
+#!/usr/bin/env python3
+"""Source contract for default-off multi-request GLM union-trace capture."""
+
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+
+SOURCE = (Path(__file__).resolve().parents[1] / "ds4.c").read_text(encoding="utf-8")
+
+
+class UnionTraceCorpusSourceTests(unittest.TestCase):
+    def test_corpus_mode_is_default_off_and_request_scoped(self) -> None:
+        for marker in (
+            'getenv("DS4_GLM_UNION_TRACE_CORPUS")',
+            "glm_union_trace_request_id",
+            "DS4_N_LEADING_DENSE && pos == 0",
+            "__atomic_add_fetch",
+            'request=%llu layer=%u pos=%u rows=%u',
+        ):
+            self.assertIn(marker, SOURCE)
+
+    def test_request_state_executes_two_fresh_multichunk_requests(self) -> None:
+        start = SOURCE.index("static uint64_t glm_union_trace_request_id")
+        brace = SOURCE.index("{", start)
+        depth = 0
+        end = None
+        for offset in range(brace, len(SOURCE)):
+            if SOURCE[offset] == "{":
+                depth += 1
+            elif SOURCE[offset] == "}":
+                depth -= 1
+                if depth == 0:
+                    end = offset + 1
+                    break
+        self.assertIsNotNone(end)
+        helper = SOURCE[start:end]
+        program = f"""
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#define DS4_N_LEADING_DENSE 4u
+{helper}
+int main(void) {{
+    uint64_t id;
+    unsetenv("DS4_GLM_UNION_TRACE_CORPUS");
+    assert(glm_union_trace_request_id(4, 0) == 0);
+    setenv("DS4_GLM_UNION_TRACE_CORPUS", "0", 1);
+    assert(glm_union_trace_request_id(4, 0) == 0);
+    setenv("DS4_GLM_UNION_TRACE_CORPUS", "1", 1);
+    id = glm_union_trace_request_id(4, 0); assert(id == 1);
+    assert(glm_union_trace_request_id(5, 0) == id);
+    assert(glm_union_trace_request_id(4, 2048) == id);
+    assert(glm_union_trace_request_id(78, 2048) == id);
+    id = glm_union_trace_request_id(4, 0); assert(id == 2);
+    assert(glm_union_trace_request_id(5, 0) == id);
+    assert(glm_union_trace_request_id(4, 2048) == id);
+    return 0;
+}}
+"""
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            source = root / "state.c"
+            binary = root / "state"
+            source.write_text(program, encoding="utf-8")
+            subprocess.run(
+                ["cc", "-D_GNU_SOURCE", "-std=c99", "-Wall", "-Werror",
+                 str(source), "-o", str(binary)], check=True,
+            )
+            subprocess.run([str(binary)], check=True)
+
+    def test_dense_layers_are_ignored_before_router_validation(self) -> None:
+        capture = SOURCE.split("static bool glm_union_probe_dump_triplet", 1)[1].split(
+            "static bool metal_graph_needs_ffn_out", 1,
+        )[0]
+        self.assertIn("if (il < DS4_N_LEADING_DENSE) return true;", capture)
+        self.assertLess(
+            capture.index("if (il < DS4_N_LEADING_DENSE) return true;"),
+            capture.index("const size_t bias_bytes"),
+        )
+
+    def test_missing_corpus_boundary_fails_closed(self) -> None:
+        capture = SOURCE.split("static bool glm_union_probe_dump_triplet", 1)[1].split(
+            "static bool metal_graph_needs_ffn_out", 1,
+        )[0]
+        self.assertIn("GLM_UNION_TRACE_ERROR stage=request-boundary", capture)
+        self.assertIn("if (corpus_enabled && request_id == 0)", capture)
+
+    def test_corpus_files_include_request_identity(self) -> None:
+        capture = SOURCE.split("static bool glm_union_probe_dump_triplet", 1)[1].split(
+            "static bool metal_graph_needs_ffn_out", 1,
+        )[0]
+        for marker in (
+            '"%s_r%08llu_%s-%u_pos%u.f32"',
+            '"%s_r%08llu_%s-%u_pos%u.i32"',
+        ):
+            self.assertIn(marker, capture)
+
+    def test_non_corpus_names_and_events_remain_backward_compatible(self) -> None:
+        capture = SOURCE.split("static bool glm_union_probe_dump_triplet", 1)[1].split(
+            "static bool metal_graph_needs_ffn_out", 1,
+        )[0]
+        for marker in (
+            '"%s_%s-%u_pos%u.f32"',
+            '"%s_%s-%u_pos%u.i32"',
+            '"GLM_UNION_TRACE_OK path=full_indexed_batch_ffn layer=%u pos=%u rows=%u\\n"',
+        ):
+            self.assertIn(marker, capture)
+
+
+if __name__ == "__main__":
+    unittest.main()
