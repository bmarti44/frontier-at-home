+/* Corpus capture is deliberately separate from the one-request qualification
+ * format.  The default path remains byte-for-byte named as before.  In the
+ * explicit corpus mode, the first routed layer at position zero starts a new
+ * monotonically numbered request so sequential requests in one server cannot
+ * overwrite one another.  Corpus qualification requires a single request in
+ * flight; atomics make accidental overlap observable rather than a data race. */
+static uint64_t glm_union_trace_request_id(uint32_t il, uint32_t pos) {
+    static uint64_t next_request;
+    static uint64_t current_request;
+    const char *enabled = getenv("DS4_GLM_UNION_TRACE_CORPUS");
+    if (!enabled || !enabled[0] || strcmp(enabled, "0") == 0) return 0;
+    if (il == DS4_N_LEADING_DENSE && pos == 0) {
+        const uint64_t request = __atomic_add_fetch(
+            &next_request, 1u, __ATOMIC_SEQ_CST);
+        __atomic_store_n(&current_request, request, __ATOMIC_SEQ_CST);
+        return request;
+    }
+    return __atomic_load_n(&current_request, __ATOMIC_SEQ_CST);
+}
