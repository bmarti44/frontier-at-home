+static void test_default_off_cli_dispatch(void) {
+    CHECK(ds4_glm_mtp_proxy_cli_contract_select != NULL,
+          "production CLI selection entry point is absent");
+    int mode = -1;
+    CHECK(ds4_glm_mtp_proxy_cli_contract_select(NULL, NULL, NULL, NULL, &mode) == 0 &&
+          mode == 0, "empty environment did not select ordinary mode");
+    CHECK(ds4_glm_mtp_proxy_cli_contract_select("out", NULL, NULL, NULL, &mode) != 0,
+          "partial candidate environment accepted");
+    CHECK(ds4_glm_mtp_proxy_cli_contract_select("out", "pack", "state", NULL, &mode) == 0 &&
+          mode == 1, "complete candidate environment rejected");
+    CHECK(ds4_glm_mtp_proxy_cli_contract_select("out", "pack", "state", "router", &mode) == 0 &&
+          mode == 1, "known fault stage rejected");
+    CHECK(ds4_glm_mtp_proxy_cli_contract_select("out", "pack", "state", "unknown", &mode) != 0,
+          "unknown fault stage accepted");
+}
