+static int path_exists(const char *dir, const char *name) {
+    char path[512];
+    if (snprintf(path, sizeof(path), "%s/%s", dir, name) >= (int)sizeof(path)) return 0;
+    return access(path, F_OK) == 0;
+}
+
+static int file_equals(const char *dir, const char *name,
+                       const void *expected, size_t expected_size) {
+    char path[512];
+    if (snprintf(path, sizeof(path), "%s/%s", dir, name) >= (int)sizeof(path)) return 0;
+    int fd = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) return 0;
+    struct stat st;
+    int ok = fstat(fd, &st) == 0 && (uint64_t)st.st_size == expected_size;
+    uint8_t *buf = malloc(expected_size ? expected_size : 1u);
+    if (!buf) ok = 0;
+    size_t off = 0;
+    while (ok && off < expected_size) {
+        ssize_t got = read(fd, buf + off, expected_size - off);
+        if (got <= 0) ok = 0;
+        else off += (size_t)got;
+    }
+    if (ok) ok = memcmp(buf, expected, expected_size) == 0;
+    free(buf);
+    close(fd);
+    return ok;
+}
+
+static void remove_temp_dir(const char *dir) {
+    DIR *dp = opendir(dir);
+    if (dp) {
+        struct dirent *de;
+        while ((de = readdir(dp)) != NULL) {
+            if (!strcmp(de->d_name, ".") || !strcmp(de->d_name, "..")) continue;
+            char path[512];
+            if (snprintf(path, sizeof(path), "%s/%s", dir, de->d_name) < (int)sizeof(path))
+                unlink(path);
+        }
+        closedir(dp);
+    }
+    rmdir(dir);
+}
