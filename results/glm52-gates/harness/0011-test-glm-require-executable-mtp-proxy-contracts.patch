index 0000000..cb6a99c
--- /dev/null
+++ b/tests/test_glm_mtp_proxy_contract.c
@@ -0,0 +1,500 @@
+/* Executable RED contract for the default-off GLM MTP proxy candidate.
+ *
+ * The weak declarations let the unchanged production object link and run. Each
+ * missing entry point is then an independent behavioral RED, rather than a
+ * source-text or missing-file failure. The implementation must provide strong
+ * definitions in the production object; comments, dead code, and decoy names
+ * cannot satisfy this binary.
+ */
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#define PROXY_ABI 1u
+#define PROXY_STEPS 8u
+#define PROXY_FIRST_LAYER 3u
+#define PROXY_LAYER_COUNT 75u
+#define PROXY_EMBD 6144u
+#define PROXY_VOCAB 154880u
+#define PROXY_EXPERTS 256u
+
+typedef struct {
+    uint32_t abi_version;
+    uint32_t steps;
+    uint32_t first_layer;
+    uint32_t layer_count;
+    uint32_t n_embd;
+    uint32_t n_vocab;
+    uint32_t n_expert;
+    uint32_t source_position;
+    uint32_t min_position;
+    int32_t q1;
+} proxy_request;
+
+typedef struct {
+    uint32_t steps_completed;
+    uint32_t routes_completed;
+    uint32_t first_position;
+    uint32_t last_position;
+    uint32_t first_layer;
+    uint32_t last_layer;
+    int32_t q9;
+} proxy_receipt;
+
+typedef struct {
+    int (*capture_z0)(void *ctx, uint32_t boundary, float *z0, uint32_t n_embd);
+    int (*mtp_step)(void *ctx,
+                    uint32_t step,
+                    uint32_t position,
+                    uint32_t min_position,
+                    uint32_t kv_slot,
+                    int32_t input_token,
+                    const float *input_hidden,
+                    float *output_hidden,
+                    float *head_logits,
+                    int32_t *output_token);
+    int (*route_layer)(void *ctx,
+                       uint32_t step,
+                       uint32_t layer,
+                       const float *hidden,
+                       float *selection_scores,
+                       uint8_t *ranked_experts);
+    int (*stage_receipt)(void *ctx,
+                         uint32_t step,
+                         uint32_t position,
+                         uint32_t kv_slot,
+                         int32_t input_token,
+                         int32_t output_token);
+} proxy_ops;
+
+typedef struct {
+    const char *name;
+    uint32_t dtype;
+    uint32_t ndim;
+    uint64_t dims[4];
+    uint64_t original_offset;
+    uint64_t original_length;
+    uint64_t blob_offset;
+    uint64_t blob_length;
+    uint8_t blob_sha256[32];
+} proxy_pack_record;
+
+typedef struct {
+    uint64_t offset;
+    uint64_t length;
+} proxy_range;
+
+typedef struct {
+    const char *name;
+    const void *data;
+    uint64_t size;
+} proxy_artifact;
+
+extern int ds4_glm_mtp_proxy_contract_run(const proxy_request *,
+                                           const proxy_ops *,
+                                           void *,
+                                           proxy_receipt *)
+    __attribute__((weak));
+extern int ds4_glm_mtp_proxy_pack_contract_validate(
+    const proxy_pack_record *, uint32_t, uint64_t, uint64_t,
+    const uint8_t[32], const uint8_t[32],
+    const proxy_range *, uint32_t)
+    __attribute__((weak));
+extern int ds4_glm_mtp_proxy_rank_contract(
+    const float *, uint32_t, uint32_t, uint8_t *, float *, uint8_t *)
+    __attribute__((weak));
+extern int ds4_glm_mtp_proxy_cli_contract_select(
+    const char *, const char *, const char *, const char *, int *)
+    __attribute__((weak));
+extern int ds4_glm_mtp_proxy_publish_contract(
+    const char *, const proxy_artifact *, uint32_t, const char *)
+    __attribute__((weak));
+
+static int failures;
+
+#define CHECK(cond, ...) do {                                                \
+    if (!(cond)) {                                                           \
+        fprintf(stderr, "FAIL %s:%d: ", __func__, __LINE__);                \
+        fprintf(stderr, __VA_ARGS__);                                        \
+        fputc('\n', stderr);                                                  \
+        failures++;                                                          \
+        return;                                                              \
+    }                                                                        \
+} while (0)
+
+typedef struct {
+    uint32_t capture_calls;
+    uint32_t step_calls;
+    uint32_t route_calls;
+    uint32_t receipt_calls;
+    uint32_t next_layer;
+    int callback_error;
+} fake_ctx;
+
+static float hidden_value(uint32_t step, uint32_t i) {
+    return (float)(step * 17u) + (float)(i % 97u) * 0.001f;
+}
+
+static int fake_capture(void *opaque, uint32_t boundary, float *z0,
+                        uint32_t n_embd) {
+    fake_ctx *ctx = opaque;
+    if (ctx->capture_calls++ != 0u || boundary != 1u || n_embd != PROXY_EMBD) {
+        ctx->callback_error = 1;
+        return 0;
+    }
+    for (uint32_t i = 0; i < n_embd; i++) z0[i] = hidden_value(0u, i);
+    return 1;
+}
+
+static int fake_step(void *opaque, uint32_t step, uint32_t position,
+                     uint32_t min_position, uint32_t kv_slot,
+                     int32_t input_token, const float *input_hidden,
+                     float *output_hidden, float *head_logits,
+                     int32_t *output_token) {
+    fake_ctx *ctx = opaque;
+    const uint32_t expected = ctx->step_calls + 1u;
+    if (step != expected || step < 1u || step > PROXY_STEPS ||
+        position != 4096u + step - 1u || min_position != 4080u ||
+        kv_slot != position || input_token != (int32_t)(1000u + step)) {
+        ctx->callback_error = 1;
+        return 0;
+    }
+    for (uint32_t i = 0; i < PROXY_EMBD; i++) {
+        if (input_hidden[i] != hidden_value(step - 1u, i)) {
+            ctx->callback_error = 1;
+            return 0;
+        }
+        output_hidden[i] = hidden_value(step, i);
+    }
+    for (uint32_t i = 0; i < PROXY_VOCAB; i++) head_logits[i] = -1.0f;
+    *output_token = (int32_t)(1001u + step);
+    head_logits[(uint32_t)*output_token] = 1.0f;
+    ctx->step_calls++;
+    ctx->next_layer = PROXY_FIRST_LAYER;
+    return 1;
+}
+
+static int fake_route(void *opaque, uint32_t step, uint32_t layer,
+                      const float *hidden, float *scores, uint8_t *ranks) {
+    fake_ctx *ctx = opaque;
+    if (step != ctx->step_calls || layer != ctx->next_layer ||
+        layer < PROXY_FIRST_LAYER || layer >= PROXY_FIRST_LAYER + PROXY_LAYER_COUNT) {
+        ctx->callback_error = 1;
+        return 0;
+    }
+    for (uint32_t i = 0; i < PROXY_EMBD; i++) {
+        if (hidden[i] != hidden_value(step, i)) {
+            ctx->callback_error = 1;
+            return 0;
+        }
+    }
+    for (uint32_t e = 0; e < PROXY_EXPERTS; e++) {
+        scores[e] = (float)step + (float)layer * 0.01f - (float)e * 0.0001f;
+        ranks[e] = (uint8_t)e;
+    }
+    ctx->route_calls++;
+    ctx->next_layer++;
+    return 1;
+}
+
+static int fake_receipt(void *opaque, uint32_t step, uint32_t position,
+                        uint32_t kv_slot, int32_t input_token,
+                        int32_t output_token) {
+    fake_ctx *ctx = opaque;
+    if (step != ctx->receipt_calls + 1u || position != 4096u + step - 1u ||
+        kv_slot != position || input_token != (int32_t)(1000u + step) ||
+        output_token != (int32_t)(1001u + step) ||
+        ctx->next_layer != PROXY_FIRST_LAYER + PROXY_LAYER_COUNT) {
+        ctx->callback_error = 1;
+        return 0;
+    }
+    ctx->receipt_calls++;
+    return 1;
+}
+
+static void test_exact_causal_recurrence_and_router_coverage(void) {
+    CHECK(ds4_glm_mtp_proxy_contract_run != NULL,
+          "production recurrence entry point is absent");
+    const proxy_request req = {
+        .abi_version = PROXY_ABI,
+        .steps = PROXY_STEPS,
+        .first_layer = PROXY_FIRST_LAYER,
+        .layer_count = PROXY_LAYER_COUNT,
+        .n_embd = PROXY_EMBD,
+        .n_vocab = PROXY_VOCAB,
+        .n_expert = PROXY_EXPERTS,
+        .source_position = 4096u,
+        .min_position = 4080u,
+        .q1 = 1001,
+    };
+    const proxy_ops ops = {
+        .capture_z0 = fake_capture,
+        .mtp_step = fake_step,
+        .route_layer = fake_route,
+        .stage_receipt = fake_receipt,
+    };
+    fake_ctx ctx = {0};
+    proxy_receipt receipt = {0};
+    const int rc = ds4_glm_mtp_proxy_contract_run(&req, &ops, &ctx, &receipt);
+    CHECK(rc == 0, "valid causal fixture rejected: rc=%d", rc);
+    CHECK(ctx.callback_error == 0, "production called a callback out of contract");
+    CHECK(ctx.capture_calls == 1u, "capture count=%u", ctx.capture_calls);
+    CHECK(ctx.step_calls == PROXY_STEPS, "step count=%u", ctx.step_calls);
+    CHECK(ctx.route_calls == PROXY_STEPS * PROXY_LAYER_COUNT,
+          "route count=%u", ctx.route_calls);
+    CHECK(ctx.receipt_calls == PROXY_STEPS, "receipt count=%u", ctx.receipt_calls);
+    CHECK(receipt.steps_completed == PROXY_STEPS &&
+          receipt.routes_completed == PROXY_STEPS * PROXY_LAYER_COUNT &&
+          receipt.first_position == 4096u && receipt.last_position == 4103u &&
+          receipt.first_layer == 3u && receipt.last_layer == 77u &&
+          receipt.q9 == 1009,
+          "receipt does not bind exact recurrence/layer endpoints");
+}
+
+static void fill_record(proxy_pack_record *r, const char *name,
+                        uint64_t original_offset, uint64_t blob_offset,
+                        uint64_t length, uint8_t digest_byte) {
+    memset(r, 0, sizeof(*r));
+    r->name = name;
+    r->dtype = 1u;
+    r->ndim = 2u;
+    r->dims[0] = 16u;
+    r->dims[1] = 16u;
+    r->original_offset = original_offset;
+    r->original_length = length;
+    r->blob_offset = blob_offset;
+    r->blob_length = length;
+    memset(r->blob_sha256, digest_byte, sizeof(r->blob_sha256));
+}
+
+static int validate_pack(proxy_pack_record *records, uint32_t count,
+                         uint64_t model_size, uint64_t payload_size,
+                         proxy_range *forbidden, uint32_t forbidden_count,
+                         int corrupt_inventory) {
+    uint8_t model_sha[32];
+    uint8_t inventory_sha[32];
+    memset(model_sha, 0x31, sizeof(model_sha));
+    memset(inventory_sha, corrupt_inventory ? 0x42 : 0x41, sizeof(inventory_sha));
+    return ds4_glm_mtp_proxy_pack_contract_validate(
+        records, count, model_size, payload_size, model_sha, inventory_sha,
+        forbidden, forbidden_count);
+}
+
+static void test_compact_pack_semantic_mutations(void) {
+    CHECK(ds4_glm_mtp_proxy_pack_contract_validate != NULL,
+          "production compact-pack validator entry point is absent");
+    proxy_pack_record valid[3];
+    fill_record(&valid[0], "token_embd.weight", 4096u, 0u, 4096u, 1u);
+    fill_record(&valid[1], "blk.3.ffn_norm.weight", 16384u, 4096u, 4096u, 2u);
+    fill_record(&valid[2], "blk.3.ffn_gate_inp.weight", 24576u, 8192u, 4096u, 3u);
+    proxy_range forbidden[1] = {{32768u, 4096u}};
+    CHECK(validate_pack(valid, 3u, 65536u, 12288u, forbidden, 1u, 0) == 0,
+          "valid compact inventory rejected");
+
+    proxy_pack_record m[3];
+    memcpy(m, valid, sizeof(m));
+    m[1].name = m[0].name;
+    CHECK(validate_pack(m, 3u, 65536u, 12288u, forbidden, 1u, 0) != 0,
+          "duplicate name accepted");
+    memcpy(m, valid, sizeof(m));
+    m[1].blob_offset = 2048u;
+    CHECK(validate_pack(m, 3u, 65536u, 12288u, forbidden, 1u, 0) != 0,
+          "overlapping blob accepted");
+    memcpy(m, valid, sizeof(m));
+    m[2].original_offset = forbidden[0].offset;
+    CHECK(validate_pack(m, 3u, 65536u, 12288u, forbidden, 1u, 0) != 0,
+          "forbidden expert range accepted");
+    memcpy(m, valid, sizeof(m));
+    m[2].original_offset = UINT64_MAX - 1024u;
+    CHECK(validate_pack(m, 3u, 65536u, 12288u, forbidden, 1u, 0) != 0,
+          "overflowing source range accepted");
+    CHECK(validate_pack(valid, 3u, 65536u, 12289u, forbidden, 1u, 0) != 0,
+          "trailing payload byte accepted");
+    CHECK(validate_pack(valid, 3u, 65536u, 12288u, forbidden, 1u, 1) != 0,
+          "wrong frozen inventory digest accepted");
+}
+
+static void independent_rank(const float *scores, uint32_t experts,
+                             uint8_t *ranked) {
+    for (uint32_t i = 0; i < experts; i++) ranked[i] = (uint8_t)i;
+    for (uint32_t i = 1; i < experts; i++) {
+        uint8_t key = ranked[i];
+        uint32_t j = i;
+        while (j > 0u) {
+            const uint8_t prior = ranked[j - 1u];
+            if (scores[prior] > scores[key] ||
+                (scores[prior] == scores[key] && prior < key)) break;
+            ranked[j] = prior;
+            j--;
+        }
+        ranked[j] = key;
+    }
+}
+
+static void test_router_max_aggregation_and_tie_order(void) {
+    CHECK(ds4_glm_mtp_proxy_rank_contract != NULL,
+          "production router-rank entry point is absent");
+    float step_scores[2u * PROXY_EXPERTS];
+    uint8_t expected_step_rank[2u * PROXY_EXPERTS];
+    float expected_max[PROXY_EXPERTS];
+    uint8_t expected_max_rank[PROXY_EXPERTS];
+    for (uint32_t e = 0; e < PROXY_EXPERTS; e++) {
+        step_scores[e] = (float)(e % 13u) * 0.01f;
+        step_scores[PROXY_EXPERTS + e] = (float)((255u - e) % 17u) * 0.01f;
+        expected_max[e] = fmaxf(step_scores[e], step_scores[PROXY_EXPERTS + e]);
+    }
+    /* Exact ties must rank by lower expert ID. */
+    step_scores[4] = step_scores[7] = 0.75f;
+    step_scores[PROXY_EXPERTS + 4] = step_scores[PROXY_EXPERTS + 7] = 0.75f;
+    expected_max[4] = expected_max[7] = 0.75f;
+    independent_rank(step_scores, PROXY_EXPERTS, expected_step_rank);
+    independent_rank(step_scores + PROXY_EXPERTS, PROXY_EXPERTS,
+                     expected_step_rank + PROXY_EXPERTS);
+    independent_rank(expected_max, PROXY_EXPERTS, expected_max_rank);
+
+    uint8_t actual_step_rank[2u * PROXY_EXPERTS];
+    float actual_max[PROXY_EXPERTS];
+    uint8_t actual_max_rank[PROXY_EXPERTS];
+    memset(actual_step_rank, 0xff, sizeof(actual_step_rank));
+    memset(actual_max, 0, sizeof(actual_max));
+    memset(actual_max_rank, 0xff, sizeof(actual_max_rank));
+    int rc = ds4_glm_mtp_proxy_rank_contract(
+        step_scores, 2u, PROXY_EXPERTS, actual_step_rank,
+        actual_max, actual_max_rank);
+    CHECK(rc == 0, "valid rank fixture rejected: rc=%d", rc);
+    CHECK(memcmp(actual_step_rank, expected_step_rank,
+                 sizeof(actual_step_rank)) == 0,
+          "per-step descending/expert-ascending ranks differ");
+    CHECK(memcmp(actual_max, expected_max, sizeof(actual_max)) == 0,
+          "cross-step aggregation is not exact F32 max");
+    CHECK(memcmp(actual_max_rank, expected_max_rank,
+                 sizeof(actual_max_rank)) == 0,
+          "max ranks differ or reverse exact ties");
+
+    step_scores[9] = NAN;
+    CHECK(ds4_glm_mtp_proxy_rank_contract(
+              step_scores, 2u, PROXY_EXPERTS, actual_step_rank,
+              actual_max, actual_max_rank) != 0,
+          "NaN router score accepted");
+    CHECK(ds4_glm_mtp_proxy_rank_contract(
+              step_scores, 0u, PROXY_EXPERTS, actual_step_rank,
+              actual_max, actual_max_rank) != 0,
+          "zero-step aggregation accepted");
+}
