+#!/usr/bin/env python3
+"""Behavioral CLI dispatch contract for default-off GLM MTP proxy mode."""
+
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+BINARY_ARG = sys.argv[1] if len(sys.argv) > 1 and not sys.argv[1].startswith("-") else "./ds4"
+if len(sys.argv) > 1 and not sys.argv[1].startswith("-"):
+    del sys.argv[1]
+
+
+class GlmMtpProxyCliTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls) -> None:
+        cls.binary = Path(BINARY_ARG).resolve()
+        cls.base_env = {
+            "HOME": os.environ.get("HOME", "/tmp"),
+            "LANG": "C.UTF-8",
+            "LC_ALL": "C.UTF-8",
+            "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
+        }
+
+    def invoke(self, extra: dict[str, str]) -> subprocess.CompletedProcess[str]:
+        with tempfile.TemporaryDirectory(prefix="ds4-glm-proxy-cli-") as td:
+            env = dict(self.base_env)
+            env["DS4_LOCK_FILE"] = str(Path(td) / "engine.lock")
+            env.update(extra)
+            return subprocess.run(
+                [
+                    str(self.binary),
+                    "--model",
+                    str(Path(td) / "missing-model.gguf"),
+                    "--prompt",
+                    "contract probe",
+                ],
+                env=env,
+                text=True,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                timeout=10,
+                check=False,
+            )
+
+    def test_empty_environment_stays_on_ordinary_model_path(self) -> None:
+        result = self.invoke({})
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("cannot open model", result.stderr)
+        self.assertNotIn("GLM MTP proxy candidate", result.stderr)
+
+    def test_each_partial_environment_fails_before_model_open(self) -> None:
+        values = {
+            "DS4_GLM_MTP_PROXY_CANDIDATE_DIR": "/missing/out",
+            "DS4_GLM_MTP_PROXY_PACK": "/missing/pack",
+            "DS4_GLM_MTP_PROXY_SOURCE_STATE": "/missing/state",
+        }
+        keys = tuple(values)
+        for mask in range(1, 1 << len(keys)):
+            if mask == (1 << len(keys)) - 1:
+                continue
+            env = {keys[i]: values[keys[i]] for i in range(len(keys)) if mask & (1 << i)}
+            with self.subTest(mask=mask):
+                result = self.invoke(env)
+                self.assertNotEqual(result.returncode, 0)
+                self.assertIn("incomplete GLM MTP proxy candidate environment", result.stderr)
+                self.assertNotIn("cannot open model", result.stderr)
+
+    def test_complete_environment_dispatches_before_full_model_open(self) -> None:
+        result = self.invoke(
+            {
+                "DS4_GLM_MTP_PROXY_CANDIDATE_DIR": "/missing/out",
+                "DS4_GLM_MTP_PROXY_PACK": "/missing/pack",
+                "DS4_GLM_MTP_PROXY_SOURCE_STATE": "/missing/state",
+            }
+        )
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("cannot open GLM MTP proxy pack", result.stderr)
+        self.assertNotIn("cannot open model", result.stderr)
+
+    def test_unknown_fault_stage_fails_before_any_artifact_open(self) -> None:
+        result = self.invoke(
+            {
+                "DS4_GLM_MTP_PROXY_CANDIDATE_DIR": "/missing/out",
+                "DS4_GLM_MTP_PROXY_PACK": "/missing/pack",
+                "DS4_GLM_MTP_PROXY_SOURCE_STATE": "/missing/state",
+                "DS4_GLM_PROXY_FAIL_STAGE": "unknown",
+            }
+        )
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("invalid DS4_GLM_PROXY_FAIL_STAGE", result.stderr)
+        self.assertNotIn("cannot open model", result.stderr)
+        self.assertNotIn("cannot open GLM MTP proxy pack", result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
