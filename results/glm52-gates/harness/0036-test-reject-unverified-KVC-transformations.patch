diff --git a/tests/test_kvstore_integrity_callsite.py b/tests/test_kvstore_integrity_callsite.py
new file mode 100644
index 0000000..a2ec15e
--- /dev/null
+++ b/tests/test_kvstore_integrity_callsite.py
@@ -0,0 +1,40 @@
+import pathlib
+import unittest
+
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+
+
+def function_body(source: str, signature: str) -> str:
+    start = source.index(signature)
+    brace = source.index("{", start)
+    depth = 0
+    for pos in range(brace, len(source)):
+        if source[pos] == "{":
+            depth += 1
+        elif source[pos] == "}":
+            depth -= 1
+            if depth == 0:
+                return source[brace : pos + 1]
+    raise AssertionError(f"unterminated function: {signature}")
+
+
+class KvstoreIntegrityCallsiteTests(unittest.TestCase):
+    def test_trailer_rewrite_uses_verified_reseal(self) -> None:
+        source = (ROOT / "ds4_kvstore.c").read_text()
+        body = function_body(source, "static void kv_cache_rewrite_trailer")
+        self.assertIn("ds4_kvstore_reseal_record", body)
+        self.assertNotIn("ds4_kvstore_seal_record", body)
+
+    def test_strip_verifies_before_transforming_source(self) -> None:
+        source = (ROOT / "ds4_agent.c").read_text()
+        body = function_body(source, "static bool agent_worker_strip_session")
+        verify = body.index("ds4_kvstore_verify_record")
+        tokenize = body.index("ds4_tokenize_rendered_chat")
+        create = body.index("mkstemp")
+        self.assertLess(verify, tokenize)
+        self.assertLess(verify, create)
+
+
+if __name__ == "__main__":
+    unittest.main()
