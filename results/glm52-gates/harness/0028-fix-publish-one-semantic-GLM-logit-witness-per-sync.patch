@@ -0,0 +1,27 @@
+#!/usr/bin/env python3
+"""The W7 logit witness is emitted exactly once per public session sync."""
+
+from pathlib import Path
+import re
+import unittest
+
+
+SOURCE = Path(__file__).resolve().parents[1] / "ds4.c"
+
+
+class GlmLogitDumpCallsiteTest(unittest.TestCase):
+    def test_only_public_sync_invokes_dump(self) -> None:
+        source = SOURCE.read_text(encoding="utf-8")
+        calls = re.findall(r"\bglm_debug_dump_prefill_logits\s*\(", source)
+        # One definition and one invocation. Restoring any internal-path dump
+        # recreates the duplicate-artifact defect caught in review round 211.
+        self.assertEqual(len(calls), 2)
+
+        wrapper_start = source.index("int ds4_session_sync(")
+        internal_start = source.index("static int ds4_session_sync_internal(", wrapper_start)
+        wrapper = source[wrapper_start:internal_start]
+        self.assertEqual(wrapper.count("glm_debug_dump_prefill_logits("), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
