+/* Publish a diagnostic artifact only after every byte is durable.  link(2)
+ * supplies the no-replace commit, so an existing final path is never changed. */
+bool ds4_glm_publish_exact(const char *path, const void *data, size_t bytes) {
+    if (!path || !path[0] || !data || bytes == 0) return false;
+    char tmp[1200];
+    const int n = snprintf(tmp, sizeof(tmp), "%s.tmp.XXXXXX", path);
+    if (n < 0 || (size_t)n >= sizeof(tmp)) return false;
+    int fd = mkstemp(tmp);
+    if (fd < 0) return false;
+    bool ok = fchmod(fd, 0600) == 0;
+    const unsigned char *p = data;
+    size_t done = 0;
+    while (ok && done < bytes) {
+        const ssize_t wrote = write(fd, p + done, bytes - done);
+        if (wrote > 0) {
+            done += (size_t)wrote;
+        } else if (wrote < 0 && errno == EINTR) {
+            continue;
+        } else {
+            ok = false;
+        }
+    }
+    if (ok && fdatasync(fd) != 0) ok = false;
+    struct stat st;
+    if (ok && (fstat(fd, &st) != 0 || st.st_size != (off_t)bytes)) ok = false;
+    if (close(fd) != 0) ok = false;
+    if (ok && link(tmp, path) != 0) ok = false;
+    if (unlink(tmp) != 0) ok = false;
+    return ok;
+}
