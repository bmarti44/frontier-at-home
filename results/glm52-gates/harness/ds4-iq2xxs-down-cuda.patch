+/* ---------------------------------------------------------------------------
+ * Persistent host-side expert cache (G4a).
+ *
+ * The per-batch selected-expert staging above re-reads every unique expert
+ * from disk on every layer visit (measured: <1% cross-request savings).
+ * This cache keeps whole expert slabs (gate+up+down bytes for one expert of
+ * one layer) in a FIXED host arena allocated once, keyed by
+ * (layer << 32 | expert), with O(1) LRU eviction.
+ *
+ *   - Enabled only when DS4_CUDA_EXPERT_CACHE_GB is set (> 0). Unset/0
+ *     keeps the exact pre-existing behavior (gate A/B requirement).
+ *   - Bounded by construction: arena bytes = n_slots * slot_bytes computed
+ *     once; no growth path exists (post-incident invariant).
+ *   - Hits copy from the arena instead of reading disk; misses read disk
+ *     as before and then populate the arena (evicting the LRU slab).
+ *   - Slabs whose byte sizes differ from the arena's slot layout (e.g. the
+ *     off-slab-class MTP layer, or a different model) bypass the cache.
+ *   - Fail-open: any allocation failure disables the cache permanently and
+ *     logs once; correctness never depends on the cache.
+ *   - Stats: DS4_GLM_TP_DEBUG prints a summary every 1024 loads.
+ * ------------------------------------------------------------------------ */
+typedef struct {
+    uint64_t key;      /* (layer << 32) | expert; UINT64_MAX = free/ghost */
+    uint64_t gate_off; /* model offsets bound to the cached bytes: a hit    */
+    uint64_t down_off; /* additionally requires offset equality (guards     */
+                       /* against same-shaped model reloads — sol finding). */
+    uint32_t prev;
+    uint32_t next;
+} cuda_expert_cache_slot_meta;
+
+static struct {
+    int initialized;
+    int disabled;
+    uint8_t *arena;
+    int arena_pinned;
+    cuda_expert_cache_slot_meta *meta;
+    uint32_t n_slots;
+    uint64_t gate_bytes;    /* per-expert gate (== up) bytes for this layout */
+    uint64_t down_bytes;
+    uint64_t slot_bytes;    /* 2*gate_bytes + down_bytes */
+    uint32_t lru_head;      /* most recent */
+    uint32_t lru_tail;      /* least recent */
+    uint32_t used;
+    uint64_t hits;
+    uint64_t misses;
+    uint64_t loads;
+    uint64_t model_generation; /* cache valid for exactly one model-load
+                                   generation (bumped by every model-map
+                                   registration; immune to address reuse) */
+    std::unordered_map<uint64_t, uint32_t> *map;
+} g_expert_persist_cache;
+
+/* Compact SHA-256 (FIPS 180-4) for the access-stream digest required by the
+ * G4a pre-registered criterion: digest over the post-compaction
+ * (layer u32, expert u32, slab_bytes u64) records of every selected load. */
+typedef struct { uint32_t h[8]; uint64_t len; uint8_t buf[64]; size_t fill; } ec_sha256;
+static const uint32_t ec_k256[64] = {
+ 0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+ 0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+ 0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+ 0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+ 0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+ 0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+ 0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+ 0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};
+static void ec_sha256_init(ec_sha256 *c) {
+    static const uint32_t h0[8] = {0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,
+                                   0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19};
+    memcpy(c->h, h0, sizeof(h0)); c->len = 0; c->fill = 0;
+}
+static void ec_sha256_block(ec_sha256 *c, const uint8_t p[64]) {
+    uint32_t w[64], a, b, d, e, f, g, hh, t1, t2, cc;
+    for (int i = 0; i < 16; i++)
+        w[i] = ((uint32_t)p[i*4] << 24) | ((uint32_t)p[i*4+1] << 16) |
+               ((uint32_t)p[i*4+2] << 8) | p[i*4+3];
+#define EC_ROR(x,n) (((x) >> (n)) | ((x) << (32 - (n))))
+    for (int i = 16; i < 64; i++) {
+        uint32_t s0 = EC_ROR(w[i-15],7) ^ EC_ROR(w[i-15],18) ^ (w[i-15] >> 3);
+        uint32_t s1 = EC_ROR(w[i-2],17) ^ EC_ROR(w[i-2],19) ^ (w[i-2] >> 10);
+        w[i] = w[i-16] + s0 + w[i-7] + s1;
+    }
+    a=c->h[0]; b=c->h[1]; cc=c->h[2]; d=c->h[3]; e=c->h[4]; f=c->h[5]; g=c->h[6]; hh=c->h[7];
+    for (int i = 0; i < 64; i++) {
+        uint32_t S1 = EC_ROR(e,6) ^ EC_ROR(e,11) ^ EC_ROR(e,25);
+        uint32_t ch = (e & f) ^ (~e & g);
+        t1 = hh + S1 + ch + ec_k256[i] + w[i];
+        uint32_t S0 = EC_ROR(a,2) ^ EC_ROR(a,13) ^ EC_ROR(a,22);
+        uint32_t mj = (a & b) ^ (a & cc) ^ (b & cc);
+        t2 = S0 + mj;
+        hh=g; g=f; f=e; e=d+t1; d=cc; cc=b; b=a; a=t1+t2;
+    }
+    c->h[0]+=a; c->h[1]+=b; c->h[2]+=cc; c->h[3]+=d; c->h[4]+=e; c->h[5]+=f; c->h[6]+=g; c->h[7]+=hh;
+#undef EC_ROR
+}
+static void ec_sha256_update(ec_sha256 *c, const void *data, size_t n) {
+    const uint8_t *p = (const uint8_t *)data;
+    c->len += n;
+    while (n) {
+        size_t take = 64 - c->fill; if (take > n) take = n;
+        memcpy(c->buf + c->fill, p, take);
+        c->fill += take; p += take; n -= take;
+        if (c->fill == 64) { ec_sha256_block(c, c->buf); c->fill = 0; }
+    }
+}
+static void ec_sha256_final_hex(ec_sha256 *c, char out[65]) {
+    uint64_t bits = c->len * 8;
+    uint8_t pad = 0x80; ec_sha256_update(c, &pad, 1);
+    uint8_t z = 0;
+    while (c->fill != 56) ec_sha256_update(c, &z, 1);
+    uint8_t lb[8];
+    for (int i = 0; i < 8; i++) lb[i] = (uint8_t)(bits >> (56 - 8*i));
+    ec_sha256_update(c, lb, 8);
+    for (int i = 0; i < 8; i++) sprintf(out + i*8, "%08x", c->h[i]);
+}
+
+static struct {
+    int inited;
+    ec_sha256 stream;
+    uint64_t lookup_bytes;
+    uint64_t hit_bytes;
+} g_expert_cache_run_stats;
+
+static void ec_run_stats_ensure(void) {
+    if (!g_expert_cache_run_stats.inited) {
+        ec_sha256_init(&g_expert_cache_run_stats.stream);
+        g_expert_cache_run_stats.inited = 1;
+    }
+}
+
+/* Called by the server on GET /v1/models: prints the finalized per-window
+ * access-stream digest + byte counters, then resets the window. */
+extern "C" void ds4_gpu_expert_cache_stats_emit(const char *tag) {
+    ec_run_stats_ensure();
+    char hex[65];
+    ec_sha256_final_hex(&g_expert_cache_run_stats.stream, hex);
+    fprintf(stderr,
+            "ds4: expert-cache window tag=%s lookup_bytes=%llu hit_bytes=%llu "
+            "stream_sha256=%s\n",
+            tag ? tag : "-",
+            (unsigned long long)g_expert_cache_run_stats.lookup_bytes,
+            (unsigned long long)g_expert_cache_run_stats.hit_bytes,
+            hex);
+    ec_sha256_init(&g_expert_cache_run_stats.stream);
+    g_expert_cache_run_stats.lookup_bytes = 0;
+    g_expert_cache_run_stats.hit_bytes = 0;
+}
+
+static void cuda_expert_cache_flush_all(const char *why) {
+    if (g_expert_persist_cache.disabled || !g_expert_persist_cache.map) return;
+    g_expert_persist_cache.map->clear();
+    for (uint32_t i = 0; i < g_expert_persist_cache.n_slots; i++) {
+        g_expert_persist_cache.meta[i].key = UINT64_MAX;
+        g_expert_persist_cache.meta[i].prev =
+            g_expert_persist_cache.meta[i].next = UINT32_MAX;
+    }
+    g_expert_persist_cache.lru_head = UINT32_MAX;
+    g_expert_persist_cache.lru_tail = UINT32_MAX;
+    g_expert_persist_cache.used = 0;
+    if (why)
+        fprintf(stderr, "ds4: CUDA persistent expert cache flushed (%s)\n",
+                why);
+}
+
+static void cuda_expert_cache_unpin(void) {
+    if (g_expert_persist_cache.arena_pinned) {
+        (void)cudaHostUnregister(g_expert_persist_cache.arena);
+        g_expert_persist_cache.arena_pinned = 0;
+    }
+}
+
+static void cuda_expert_cache_flush_for_model(void) {
+    if (g_expert_persist_cache.disabled) return;
+    if (g_expert_persist_cache.model_generation == g_model_load_generation)
+        return;
+    cuda_expert_cache_flush_all(g_expert_persist_cache.model_generation != 0 ?
+                                "model load generation changed" : NULL);
+    g_expert_persist_cache.model_generation = g_model_load_generation;
+}
+
+static void cuda_expert_cache_lru_unlink(uint32_t s) {
+    cuda_expert_cache_slot_meta *m = g_expert_persist_cache.meta;
+    if (m[s].prev != UINT32_MAX) m[m[s].prev].next = m[s].next;
+    else g_expert_persist_cache.lru_head = m[s].next;
+    if (m[s].next != UINT32_MAX) m[m[s].next].prev = m[s].prev;
+    else g_expert_persist_cache.lru_tail = m[s].prev;
+    m[s].prev = m[s].next = UINT32_MAX;
+}
+
+static void cuda_expert_cache_lru_push_front(uint32_t s) {
+    cuda_expert_cache_slot_meta *m = g_expert_persist_cache.meta;
+    m[s].prev = UINT32_MAX;
+    m[s].next = g_expert_persist_cache.lru_head;
+    if (g_expert_persist_cache.lru_head != UINT32_MAX)
+        m[g_expert_persist_cache.lru_head].prev = s;
+    g_expert_persist_cache.lru_head = s;
+    if (g_expert_persist_cache.lru_tail == UINT32_MAX)
+        g_expert_persist_cache.lru_tail = s;
+}
+
+static void cuda_expert_cache_init_once(uint64_t gate_bytes, uint64_t down_bytes) {
+    if (g_expert_persist_cache.initialized) return;
+    g_expert_persist_cache.initialized = 1;
+    g_expert_persist_cache.disabled = 1;
+    const char *env = getenv("DS4_CUDA_EXPERT_CACHE_GB");
+    if (!env) return;
+    const double gb = atof(env);
+    if (!(gb > 0.0) || gb > 1024.0) return;
+    if (gate_bytes == 0 || down_bytes == 0 ||
+        gate_bytes > (UINT64_MAX - down_bytes) / 2u) return;
+    const uint64_t slot_bytes = 2u * gate_bytes + down_bytes;
+    if (slot_bytes > (uint64_t)1 << 32) return; /* implausible slab */
+    uint64_t n_slots64 = (uint64_t)(gb * 1e9) / slot_bytes;
+    if (n_slots64 < 64) return;
+    if (n_slots64 > 4u * 1024u * 1024u) n_slots64 = 4u * 1024u * 1024u;
+    const uint32_t n_slots = (uint32_t)n_slots64;
+    uint8_t *arena = (uint8_t *)malloc((size_t)n_slots * slot_bytes);
+    cuda_expert_cache_slot_meta *meta = (cuda_expert_cache_slot_meta *)
+        malloc((size_t)n_slots * sizeof(cuda_expert_cache_slot_meta));
+    std::unordered_map<uint64_t, uint32_t> *map = NULL;
+    try {
+        map = new std::unordered_map<uint64_t, uint32_t>();
+        map->reserve(n_slots);   /* avoid rehash allocations on the hot path */
+    } catch (...) { delete map; map = NULL; }
+    if (!arena || !meta || !map) {
+        free(arena); free(meta); delete map;
+        fprintf(stderr, "ds4: CUDA persistent expert cache DISABLED "
+                        "(arena allocation failed for %.1f GB)\n", gb);
+        return;
+    }
+    for (uint32_t i = 0; i < n_slots; i++) {
+        meta[i].key = UINT64_MAX;
+        meta[i].prev = meta[i].next = UINT32_MAX;
+    }
+    g_expert_persist_cache.arena = arena;
+    g_expert_persist_cache.meta = meta;
+    g_expert_persist_cache.map = map;
+    g_expert_persist_cache.n_slots = n_slots;
+    g_expert_persist_cache.gate_bytes = gate_bytes;
+    g_expert_persist_cache.down_bytes = down_bytes;
+    g_expert_persist_cache.slot_bytes = slot_bytes;
+    g_expert_persist_cache.lru_head = UINT32_MAX;
+    g_expert_persist_cache.lru_tail = UINT32_MAX;
+    g_expert_persist_cache.used = 0;
+    g_expert_persist_cache.disabled = 0;
+    if (getenv("DS4_CUDA_EXPERT_CACHE_PIN")) {
+        /* Pin the arena so hit/fill copies ride the async DMA path instead
+         * of the pageable staging path (measured 62us/call -> the whole
+         * 92ms/token hit-copy cost). Fail-open: an unpinned arena serves
+         * identical bytes through the same code path. */
+        struct timespec pt0 = {0, 0}, pt1 = {0, 0};
+        clock_gettime(CLOCK_MONOTONIC, &pt0);
+        const cudaError_t pin_rc = cudaHostRegister(
+                arena, (size_t)n_slots * slot_bytes, cudaHostRegisterPortable);
+        clock_gettime(CLOCK_MONOTONIC, &pt1);
+        fprintf(stderr,
+                "ds4: expert-cache arena pin: %s (%.1f s)\n",
+                pin_rc == cudaSuccess ? "ok" : cudaGetErrorString(pin_rc),
+                (double)(pt1.tv_sec - pt0.tv_sec) +
+                (double)(pt1.tv_nsec - pt0.tv_nsec) / 1e9);
+        if (pin_rc == cudaSuccess) {
+            g_expert_persist_cache.arena_pinned = 1;
+        } else {
+            /* fail-open requires clearing the sticky per-thread error so a
+             * later cudaGetLastError after a kernel launch does not report
+             * this registration failure as a launch failure. A genuinely
