+ * emplace; on emplace failure the slot becomes a linked ghost (key sentinel)
+ * that natural LRU aging recycles. */
+static uint32_t cuda_expert_cache_insert(uint64_t key, uint64_t gate_off,
+                                         uint64_t down_off) {
+    if (g_expert_persist_cache.disabled) return UINT32_MAX;
+    uint32_t s;
+    int fresh = 0;
+    if (g_expert_persist_cache.used < g_expert_persist_cache.n_slots) {
+        s = g_expert_persist_cache.used;   /* not yet committed */
+        fresh = 1;
+    } else {
+        s = g_expert_persist_cache.lru_tail;
+        if (s == UINT32_MAX) return UINT32_MAX;
+        cuda_expert_cache_lru_unlink(s);
+        if (g_expert_persist_cache.meta[s].key != UINT64_MAX)
+            g_expert_persist_cache.map->erase(g_expert_persist_cache.meta[s].key);
+        g_expert_persist_cache.meta[s].key = UINT64_MAX;
+    }
+    try {
+        (*g_expert_persist_cache.map)[key] = s;
+    } catch (...) {
+        if (!fresh) cuda_expert_cache_lru_push_front(s); /* keep linked ghost */
+        return UINT32_MAX;
+    }
+    if (fresh) g_expert_persist_cache.used++;
+    g_expert_persist_cache.meta[s].key = key;
+    g_expert_persist_cache.meta[s].gate_off = gate_off;
+    g_expert_persist_cache.meta[s].down_off = down_off;
+    cuda_expert_cache_lru_push_front(s);
+    return s;
+}
