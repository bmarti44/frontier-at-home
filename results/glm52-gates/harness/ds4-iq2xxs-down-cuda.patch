+/* Returns arena slot base on hit (and refreshes LRU), NULL on miss.
+ * A hit requires key AND model-offset equality (stale-model guard). */
+static uint8_t *cuda_expert_cache_lookup(uint64_t key, uint64_t gate_off,
+                                         uint64_t down_off) {
+    if (g_expert_persist_cache.disabled) return NULL;
+    auto it = g_expert_persist_cache.map->find(key);
+    if (it == g_expert_persist_cache.map->end()) return NULL;
+    const uint32_t s = it->second;
+    if (g_expert_persist_cache.meta[s].gate_off != gate_off ||
+        g_expert_persist_cache.meta[s].down_off != down_off) {
+        /* same (layer,expert) from a different mapping: drop stale entry */
+        cuda_expert_cache_lru_unlink(s);
+        g_expert_persist_cache.map->erase(it);
+        g_expert_persist_cache.meta[s].key = UINT64_MAX;
+        cuda_expert_cache_lru_push_front(s); /* recycled as a ghost */
+        return NULL;
+    }
+    cuda_expert_cache_lru_unlink(s);
+    cuda_expert_cache_lru_push_front(s);
+    return g_expert_persist_cache.arena +
+           (uint64_t)s * g_expert_persist_cache.slot_bytes;
+}
+
+/* Returns arena slot index to fill for this key (evicting LRU if needed),
+ * UINT32_MAX on failure. Exception-safe: `used` only advances after the map
