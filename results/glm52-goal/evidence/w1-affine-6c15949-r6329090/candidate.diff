diff --git a/tests/test_glm_compact_cache_affine_int8_fake_source.py b/tests/test_glm_compact_cache_affine_int8_fake_source.py
new file mode 100644
index 0000000..795d375
--- /dev/null
+++ b/tests/test_glm_compact_cache_affine_int8_fake_source.py
@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+"""Source contract for the default-off CUDA GLM affine-int8 fidelity arm."""
+
+from pathlib import Path
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+HOST = ROOT / "ds4.c"
+CUDA = ROOT / "ds4_cuda.cu"
+GPU_HEADER = ROOT / "ds4_gpu.h"
+
+
+class GlmCompactCacheAffineInt8FakeSourceTests(unittest.TestCase):
+    def test_arm_is_exact_default_off_and_mutually_exclusive(self):
+        host = HOST.read_text(encoding="utf-8")
+        self.assertIn(
+            'getenv("DS4_GLM_COMPACT_CACHE_AFFINE_INT8_FAKE")',
+            host,
+        )
+        self.assertIn("GLM compact cache fidelity arms are mutually exclusive", host)
+
+    def test_cuda_quantizes_only_f32_latent_in_affine_blocks_of_16(self):
+        cuda = CUDA.read_text(encoding="utf-8")
+        self.assertIn("glm_fake_affine_int8_quantize_latent_kernel", cuda)
+        self.assertIn("kv_lora_dim % 16u", cuda)
+        self.assertIn("(max_shared[0] - min_shared[0]) / 255.0f", cuda)
+        self.assertIn("rintf((row[i] - min_shared[0]) / scale)", cuda)
+        self.assertNotIn("glm_fake_affine_int8_quantize_rope", cuda)
+
+    def test_both_compact_store_paths_apply_the_arm(self):
+        cuda = CUDA.read_text(encoding="utf-8")
+        self.assertGreaterEqual(
+            cuda.count("glm_launch_fake_affine_int8_quantize_latent("),
+            3,
+        )
+
+    def test_affine_reuses_the_existing_int8_mode_argument(self):
+        host = HOST.read_text(encoding="utf-8")
+        header = GPU_HEADER.read_text(encoding="utf-8")
+        self.assertTrue(
+            "glm_graph_compact_cache_fake_int8_mode" in host,
+            "host must combine symmetric and affine int8 into one mode",
+        )
+        self.assertTrue(
+            "uint32_t              fake_int8_mode" in header,
+            "GPU API must reuse the original int8 argument position",
+        )
+        self.assertTrue(
+            "bool                  fake_affine_int8" not in header,
+            "affine mode must not add a GPU API argument",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
