+__global__ static void glm_fake_affine_int8_quantize_latent_kernel(
+        float *cache,
+        uint32_t pos0,
+        uint32_t n_tokens,
+        uint32_t cache_cap,
+        uint32_t kv_lora_dim) {
+    const uint32_t token = blockIdx.x;
+    const uint32_t block = blockIdx.y;
+    const uint32_t lane = threadIdx.x;
+    if (token >= n_tokens || lane >= 16u) return;
+    const uint32_t pos = pos0 + token;
+    const uint32_t i = block * 16u + lane;
+    if (pos >= cache_cap || i >= kv_lora_dim) return;
+
+    float *row = cache + (uint64_t)pos * kv_lora_dim;
+    __shared__ float min_shared[16];
+    __shared__ float max_shared[16];
+    min_shared[lane] = row[i];
+    max_shared[lane] = row[i];
+    __syncthreads();
+    for (uint32_t step = 8u; step > 0u; step >>= 1u) {
+        if (lane < step) {
+            min_shared[lane] =
+                fminf(min_shared[lane], min_shared[lane + step]);
+            max_shared[lane] =
+                fmaxf(max_shared[lane], max_shared[lane + step]);
+        }
+        __syncthreads();
+    }
+    const float scale =
+        fmaxf((max_shared[0] - min_shared[0]) / 255.0f, 1.0e-12f);
+    const float quantized = fminf(
+            255.0f,
+            fmaxf(0.0f, rintf((row[i] - min_shared[0]) / scale)));
+    row[i] = quantized * scale + min_shared[0];
+}
+
+static int glm_launch_fake_affine_int8_quantize_latent(
+        ds4_gpu_tensor *cache,
+        uint32_t pos0,
+        uint32_t n_tokens,
+        uint32_t cache_cap,
+        uint32_t kv_lora_dim,
+        bool fake_affine_int8) {
+    if (!fake_affine_int8) return 1;
+    if (!cache || kv_lora_dim == 0u || kv_lora_dim % 16u != 0u ||
+        cache->bytes < (uint64_t)cache_cap * kv_lora_dim * sizeof(float)) {
+        return 0;
+    }
+    dim3 grid(n_tokens, kv_lora_dim / 16u, 1u);
+    glm_fake_affine_int8_quantize_latent_kernel<<<grid, 16>>>(
+            (float *)cache->ptr, pos0, n_tokens, cache_cap, kv_lora_dim);
+    return cuda_ok(cudaGetLastError(), "glm fake affine int8 latent launch");
+}
