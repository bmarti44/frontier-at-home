vendor/
# Encoders are harness-critical and must always be tracked (see
# scripts/tests/test_encoder_registration.py); everything else under
# vendor/ stays ignored.
!vendor/official-encoding/
vendor/official-encoding/*
!vendor/official-encoding/encoding/
vendor/official-encoding/encoding/*
!vendor/official-encoding/encoding/encoding_*.py
.venv-harness/
results/glm52-goal/state.json
results/glm52-goal/events.jsonl
results/holdout-ledger.json.lock

# gate evidence logs are deliberately tracked (deterministic-gate contract)
!results/glm52-gates/
!results/glm52-gates/**
