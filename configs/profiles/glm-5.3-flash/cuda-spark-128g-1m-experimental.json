{
  "schema_version": 4,
  "profile_id": "glm-5.3-flash/cuda-spark-128g-1m-experimental",
  "model": "glm-5.3-flash",
  "backend": "cuda",
  "hardware_class": "spark",
  "ram_tier_gib": 128,
