{
  "extends": "_tune.json",
  "schema_version": 4,
  "profile_id": "qwen3.8-flash-next/cuda-spark-128g-1m-tune-a4",
  "bench": {
    "stack_label": "qwen3.8-flash-next-cuda-spark-128g-1m-tune-a4"
  },
  "qualification_options": {
    "speed_max_tokens_per_event": 5
  },
  "purpose": "Screen arm A4: _tune.json (runtime-002, L0 patches always on) + L1 PLE MADV_WILLNEED, L2 65,536-row draft vocabulary + NVFP4 draft head, L3 k=4 at one request, k=3 at two to four.",
  "launch": {
    "log_name": "qwen38fn-tune-a4",
    "env": {
      "HOME": "{cache_root}/qwen38-flash-next/home",
      "LANG": "C.UTF-8",
      "PATH": "{cache_root}/qwen38-flash-next/native-runtime-002/runtime/bin:{cache_root}/glm53-flash/tools/bin:/usr/local/cuda-13.0/bin:/usr/bin:/bin",
      "PYTHONPATH": "{repo}/scripts/lib",
      "PYTHONNOUSERSITE": "1",
      "PYTHONDONTWRITEBYTECODE": "1",
      "CUDA_HOME": "/usr/local/cuda-13.0",
      "CUDA_VISIBLE_DEVICES": "0",
      "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
      "NVIDIA_TF32_OVERRIDE": "0",
      "TOKENIZERS_PARALLELISM": "false",
      "HF_HUB_OFFLINE": "1",
      "TRANSFORMERS_OFFLINE": "1",
      "VLLM_NO_USAGE_STATS": "1",
      "DO_NOT_TRACK": "1",
      "MAX_JOBS": "2",
      "NVCC_THREADS": "1",
      "FLASHINFER_NVCC_THREADS": "1",
      "FLASHINFER_DISABLE_JIT": "1",
      "VLLM_MOE_USE_DEEP_GEMM": "0",
      "QWEN38FN_PLE_WILLNEED": "1",
      "QWEN4EXP_DRAFT_VOCAB": "65536"
    },
    "args": [
      "-B",
      "-m",
      "vllm.entrypoints.openai.api_server",
      "--model",
      "{model}",
      "--served-model-name",
      "qwen3.8-flash-next",
      "default",
      "--host",
      "127.0.0.1",
      "--port",
      "{port}",
      "--quantization",
      "modelopt",
      "--max-model-len",
      "262144",
      "--max-num-seqs",
      "4",
      "--kv-cache-dtype",
      "fp8",
      "--gpu-memory-utilization",
      "0.85",
      "--kv-cache-memory-bytes",
      "19220000000",
      "--enable-prefix-caching",
      "--enable-chunked-prefill",
      "--max-num-batched-tokens",
      "4096",
      "--enable-auto-tool-choice",
      "--enable-prompt-tokens-details",
      "--tool-call-parser",
      "qwen3_coder",
      "--reasoning-parser",
      "qwen3",
      "--speculative-config",
      "{\"method\":\"mtp\",\"num_speculative_tokens\":4,\"draft_lm_head_quantization\":\"nvfp4\",\"num_speculative_tokens_per_batch_size\":[[1,1,4],[2,4,3]]}",
      "--engram-config",
      "{\"checkpoint_mapped\":true}",
      "--limit-mm-per-prompt",
      "{\"image\":4,\"video\":0}",
      "--mm-processor-cache-gb",
      "0",
      "--default-chat-template-kwargs",
      "{\"reasoning_effort\":\"low\"}",
      "--worker-cls",
      "qwen38fn_worker.HostCacheReleaseWorker",
      "--middleware",
      "vllm_reasoning_compat.ReasoningContentMiddleware",
      "--middleware",
      "glm53_runtime_policy.SplitTerminalSseMiddleware",
      "--no-enable-flashinfer-autotune",
      "--logprobs-mode",
      "raw_logprobs",
      "--shutdown-timeout",
      "10",
      "--compilation-config",
      "{\"mode\":0,\"cudagraph_mode\":\"FULL_DECODE_ONLY\"}"
    ]
  }
}
