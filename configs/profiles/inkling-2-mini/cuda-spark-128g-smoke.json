{
  "schema_version": 4,
  "profile_id": "inkling-2-mini/cuda-spark-128g-smoke",
  "model": "inkling-2-mini",
  "backend": "cuda",
  "hardware_class": "spark",
  "ram_tier_gib": 128,
  "purpose": "DIAGNOSTIC smoke only (never a headline or acceptance number): the first load of Inkling 2 Mini on the vLLM nightly that ships its model code, at reduced context (2 x 131,072-token slots, BF16 KV, images on), to measure resident weights, KV bytes per token and overhead before the native 1,048,576-token profile is authored.",
  "status": {
    "state": "estimated",
    "basis": "M0 scaffold, pre-measurement: the model has never been loaded on this host, so every memory figure below is an estimate from the checkpoint size; the first smoke load replaces them with measured values."
  },
  "engine": "vllm-inkling2-r001",
  "artifact_roles": {
    "model": "official-b85c3cfa"
  },
  "launch": {
    "mechanism": "systemd-run",
    "user": "bmarti44",
    "log_name": "inkling2-smoke",
    "env": {
      "HOME": "{cache_root}/inkling-2-mini/home",
      "LANG": "C.UTF-8",
      "PATH": "{cache_root}/inkling-2-mini/native-runtime-001/runtime/bin:/usr/local/cuda-13.0/bin:/usr/bin:/bin",
      "PYTHONPATH": "{repo}/scripts/lib",
      "PYTHONNOUSERSITE": "1",
      "PYTHONDONTWRITEBYTECODE": "1",
      "CUDA_HOME": "/usr/local/cuda-13.0",
      "CUDA_VISIBLE_DEVICES": "0",
      "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
      "NVIDIA_TF32_OVERRIDE": "0",
      "TOKENIZERS_PARALLELISM": "false",
      "HF_HUB_OFFLINE": "1",
      "TRANSFORMERS_OFFLINE": "1",
      "VLLM_NO_USAGE_STATS": "1",
      "DO_NOT_TRACK": "1",
      "MAX_JOBS": "2",
      "NVCC_THREADS": "1",
      "FLASHINFER_NVCC_THREADS": "1",
      "FLASHINFER_DISABLE_JIT": "1",
      "TRITON_CACHE_DIR": "{cache_root}/inkling-2-mini/home/.triton/cache",
      "INKLING2_VISION_ATTN": "triton",
      "INKLING2_MAX_IMAGE_SIDE": "4096"
    },
    "diagnostics_unset": [
      "VLLM_LOGGING_LEVEL",
      "VLLM_TRACE_FUNCTION",
      "CUDA_LAUNCH_BLOCKING"
    ],
    "args": [
      "-B",
      "-m",
      "vllm.entrypoints.openai.api_server",
      "--model",
      "{model}",
      "--served-model-name",
      "inkling-2-mini",
      "default",
      "--host",
      "127.0.0.1",
      "--port",
      "{port}",
      "--max-model-len",
      "131072",
      "--max-num-seqs",
      "2",
      "--kv-cache-dtype",
      "auto",
      "--gpu-memory-utilization",
      "0.80",
      "--kv-cache-memory-bytes",
      "24000000000",
      "--enable-prefix-caching",
      "--enable-chunked-prefill",
      "--max-num-batched-tokens",
      "2048",
      "--enable-auto-tool-choice",
      "--tool-call-parser",
      "inkling",
      "--reasoning-parser",
      "inkling",
      "--enable-prompt-tokens-details",
      "--limit-mm-per-prompt",
      "{\"image\":4,\"video\":0}",
      "--mm-processor-cache-gb",
      "0",
      "--default-chat-template-kwargs",
      "{\"reasoning_effort\":\"low\"}",
      "--middleware",
      "vllm_reasoning_compat.ReasoningContentMiddleware",
      "--middleware",
      "glm53_runtime_policy.SplitTerminalSseMiddleware",
      "--logprobs-mode",
      "raw_logprobs",
      "--shutdown-timeout",
      "10"
    ]
  },
  "containment": {
    "unit": "inkling2-smoke",
    "memory_high": "92G",
    "memory_max": "96G",
    "memory_swap_max": "0",
    "oom_policy": "kill",
    "kill_mode": "control-group"
  },
  "safety": {
    "kill_floor_gib": 15,
    "minimum_start_gib": 110,
    "sample_hz": 1,
    "startup_timeout_seconds": 1800,
    "note": "Diagnostic smoke floor 15 GiB, as the qwen3.8-flash-next smoke; the 10 GiB AGENTS floor still bounds everything. Start needs 110 GiB available (and MemFree) after the switch's cache release."
  },
  "memory_model": {
    "kv_bytes_per_token": 0,
    "resident_weights_gib": 20,
    "overhead_gib": 12,
    "extra_gib": 23,
    "floor_gib": 15,
    "basis": "ESTIMATE, pre-measurement: resident_weights_gib 20 rounds up the 18.8 GiB checkpoint (model + mtp head); overhead_gib 12 covers CUDA context, activations, compile and CUDA-graph workspace; extra_gib 23 is the fixed BF16 KV arena (--kv-cache-memory-bytes 24000000000 = 22.35 GiB; a fixed arena also turns off this vLLM build's default extensible KV cache, which would otherwise commit up to 0.80 x total memory after warmup) (kv_bytes_per_token stays 0 because the arena is charged here). Replace every value with the engine-reported pool and the measured peak after the first load."
  },
  "serving": {
    "parallel_slots": 2,
    "request_context_cap": 131072,
    "max_images": 4
  },
  "context_cap": 262144,
  "port_role": "production",
  "bench": {
    "stack_label": "inkling-2-mini-cuda-spark-128g-smoke"
  },
  "qualification_options": {
    "vision_max_tokens": 4096
  }
}
