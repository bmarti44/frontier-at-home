# DSV4 default serving profile: 1M context AND fast prefill (2026-08-01).
# Single source of truth for the performance-critical values; the systemd
# unit (configs/systemd/deepseek-v4-flash-llamacpp.service) and
# scripts/52_engine_switch.sh dsv4_launcher() must stay in sync — enforced by
# scripts/tests/test_profile_conformance.py.
#
# Rationale: ub/b=2048 is the measured fast-prefill config (~434 tok/s @19K,
# agent TTFT ~59 s vs ~100 s at ub=256; docs/speed-tuning-2026-07-23.md).
# At CTX=1M the context-scaled compute buffers leave a measured steady state
# of ~9.8 GiB free (memwatch BREACH 2026-08-01), so the owner accepted an
# 8 GiB watchdog floor — a deliberately thinner crash barrier — rather than
# giving up 1M context or prefill speed. Overhead 12 = measured non-weight,
# non-KV footprint (~11.3 GiB) at exactly this configuration; admission is
# 90.2 (weights) + 4.0 (KV@1M) + 12 + 8 ≈ 114 GiB.
# Two 512k slots protect the agent conversation cache from utility-call
# eviction; single requests are capped at 512k tokens (use the qualified
# ub=256 single-slot profile for true 1M-token runs).
DSV4_UBATCH=2048
DSV4_BATCH=2048
DSV4_UBATCH_LARGE=1
CTX=1048576
DSV4_PARALLEL=2
DSV4_NO_MMAP=1
DSV4_SPEC_TYPE=none
DSV4_MEASURED_HEADLESS_OVERHEAD_GIB=12
DSV4_MEM_FLOOR_GIB=8
DSV4_WATCHDOG_FLOOR_GIB=8
DSV4_CONTEXT_QUALIFICATION_FLOOR_GIB=8
