# DSV4 default serving profile: 1M context AND fast prefill (2026-07-31).
# Single source of truth for the performance-critical values; the systemd
# unit (configs/systemd/deepseek-v4-flash-llamacpp.service) and
# scripts/52_engine_switch.sh dsv4_launcher() must stay in sync — enforced by
# scripts/tests/test_profile_conformance.py.
#
# Rationale: ub/b=2048 is the measured fast-prefill config (~434 tok/s @19K,
# agent TTFT ~59 s vs ~100 s at ub=256; docs/speed-tuning-2026-07-23.md).
# The 2026-07-27 revert to small buffers was an admission-gate marginality,
# not a live OOM; DSV4_MEASURED_HEADLESS_OVERHEAD_GIB=5 is the measured
# admission path that lets these buffers pass the membudget gate under the
# 14 GiB qualification floor (90.2 weights + 4.0 KV@1M + 5 + 14 ≈ 113 GiB).
DSV4_UBATCH=2048
DSV4_BATCH=2048
DSV4_UBATCH_LARGE=1
CTX=1048576
DSV4_PARALLEL=1
DSV4_NO_MMAP=1
DSV4_SPEC_TYPE=none
DSV4_MEASURED_HEADLESS_OVERHEAD_GIB=5
DSV4_MEM_FLOOR_GIB=14
DSV4_WATCHDOG_FLOOR_GIB=14
DSV4_CONTEXT_QUALIFICATION_FLOOR_GIB=14
