+/* ------------------------------------------------------------------------
+ * Cross-layer expert prefetch worker (DS4_GLM_PREFETCH).
+ *
+ * Worker threads perform file reads into private host slabs only.  They never
+ * call CUDA or touch the resident-cache map, metadata, SLRU links, arena, or
+ * direct-slot protection bitmap.  A selected-load thread claims a READY slab,
+ * copies it, and admits it through cuda_expert_cache_insert(), preserving the
+ * cache's single-writer contract.  Model generation and exact source offsets
+ * prevent stale slabs from being consumed after a model reload.
+ * ------------------------------------------------------------------------ */
+#define DS4_PF_SLOTS 12
+#define DS4_PF_MAX_THREADS 8
+
+typedef struct {
+    uint64_t key, gate_off, up_off, down_off, generation, epoch;
+} ds4_pf_req;
+
+typedef struct {
+    int state;              /* 0 empty, 1 filling, 2 ready, 3 loader-owned */
+    uint64_t epoch;
+    uint64_t key, gate_off, up_off, down_off, generation;
+    uint8_t *buf;           /* gate|up|down, exactly one expert slab */
+} ds4_pf_slot;
+
+static struct {
+    int enabled;
+    int started;
+    int stop;
+    pthread_mutex_t mu;
+    pthread_cond_t cv;
+    ds4_pf_slot slots[DS4_PF_SLOTS];
+    ds4_pf_req reqs[DS4_PF_SLOTS];
+    int n_req;
+    uint64_t gate_bytes, down_bytes, slot_bytes;
+    int fd;
+    uint64_t align;
+    uint8_t *stage[DS4_PF_MAX_THREADS];
+    uint64_t stage_bytes;
+    int n_threads;
+    pthread_t threads[DS4_PF_MAX_THREADS];
+    uint64_t issued, served, stale, filled, expired, skipped_resident;
+    uint64_t epoch;
+    uint64_t pool_generation;
+} g_pf;
+
+static int ds4_pf_read_span(int wi, uint64_t off, uint64_t bytes,
+                            uint8_t *dst) {
+    if (g_pf.fd < 0 || g_pf.align <= 1) return 0;
+    const uint64_t aligned_off = (off / g_pf.align) * g_pf.align;
+    const uint64_t delta = off - aligned_off;
+    const uint64_t read_size =
+        ((delta + bytes + g_pf.align - 1) / g_pf.align) * g_pf.align;
+    if (read_size > g_pf.stage_bytes) return 0;
+    uint64_t done = 0;
+    while (done < read_size) {
+        const ssize_t n = pread(g_pf.fd,
+                                g_pf.stage[wi] + done,
+                                (size_t)(read_size - done),
+                                (off_t)(aligned_off + done));
+        if (n <= 0) return 0;
+        done += (uint64_t)n;
+    }
+    memcpy(dst, g_pf.stage[wi] + delta, (size_t)bytes);
+    return 1;
+}
+
+static void *ds4_pf_worker(void *arg) {
+    const int wi = (int)(intptr_t)arg;
+    for (;;) {
+        ds4_pf_req req;
+        int slot = -1;
+        pthread_mutex_lock(&g_pf.mu);
+        while (!g_pf.stop && g_pf.n_req == 0) {
+            pthread_cond_wait(&g_pf.cv, &g_pf.mu);
+        }
+        if (g_pf.stop) {
+            pthread_mutex_unlock(&g_pf.mu);
+            break;
+        }
+        req = g_pf.reqs[--g_pf.n_req];  /* LIFO: newest layer first */
+        for (int i = 0; i < DS4_PF_SLOTS; i++) {
+            if (g_pf.slots[i].state == 0) {
+                slot = i;
+                break;
+            }
+        }
+        if (slot >= 0) {
+            g_pf.slots[slot].state = 1;
+            g_pf.slots[slot].key = req.key;
+            g_pf.slots[slot].gate_off = req.gate_off;
+            g_pf.slots[slot].up_off = req.up_off;
+            g_pf.slots[slot].down_off = req.down_off;
+            g_pf.slots[slot].generation = req.generation;
+            g_pf.slots[slot].epoch = req.epoch;
+        }
+        pthread_mutex_unlock(&g_pf.mu);
+        if (slot < 0) continue;
+
+        uint8_t *buf = g_pf.slots[slot].buf;
+        const int ok =
+            ds4_pf_read_span(wi, req.gate_off, g_pf.gate_bytes, buf) &&
+            ds4_pf_read_span(wi, req.up_off, g_pf.gate_bytes,
+                             buf + g_pf.gate_bytes) &&
+            ds4_pf_read_span(wi, req.down_off, g_pf.down_bytes,
+                             buf + 2u * g_pf.gate_bytes);
+        pthread_mutex_lock(&g_pf.mu);
+        g_pf.slots[slot].state = ok ? 2 : 0;
+        if (ok) g_pf.filled++;
+        pthread_mutex_unlock(&g_pf.mu);
+    }
+    return NULL;
+}
+
+static void ds4_pf_init_once(uint64_t gate_bytes, uint64_t down_bytes) {
+    static int initialized = 0;
+    if (initialized) return;
+    initialized = 1;
+    if (getenv("DS4_GLM_PREFETCH") == NULL) return;
+    if (gate_bytes == 0 || down_bytes == 0 ||
+        gate_bytes > (UINT64_MAX - down_bytes) / 2u) return;
+
+    g_pf.gate_bytes = gate_bytes;
+    g_pf.down_bytes = down_bytes;
+    g_pf.slot_bytes = 2u * gate_bytes + down_bytes;
+    g_pf.align = g_model_direct_align > 1 ? g_model_direct_align : 4096;
+    const uint64_t max_part = gate_bytes > down_bytes ? gate_bytes : down_bytes;
+    g_pf.stage_bytes =
+        ((max_part + 2u * g_pf.align + g_pf.align - 1) / g_pf.align) *
+        g_pf.align;
+    g_pf.fd = -1;
+    if (g_model_direct_fd >= 0) {
+        char proc_path[64];
+        snprintf(proc_path, sizeof(proc_path), "/proc/self/fd/%d",
+                 g_model_direct_fd);
+#if defined(__linux__) && defined(O_DIRECT)
+        g_pf.fd = open(proc_path, O_RDONLY | O_DIRECT);
+#endif
+        if (g_pf.fd < 0) g_pf.fd = open(proc_path, O_RDONLY);
+    }
+
+    const char *threads_env = getenv("DS4_GLM_PREFETCH_THREADS");
+    g_pf.n_threads = threads_env ? atoi(threads_env) : 6;
+    if (g_pf.n_threads < 1) g_pf.n_threads = 1;
+    if (g_pf.n_threads > DS4_PF_MAX_THREADS)
+        g_pf.n_threads = DS4_PF_MAX_THREADS;
+
+    int alloc_ok = g_pf.fd >= 0;
+    for (int i = 0; alloc_ok && i < g_pf.n_threads; i++) {
+        void *stage = NULL;
+        if (posix_memalign(&stage, (size_t)g_pf.align,
+                           (size_t)g_pf.stage_bytes) != 0) {
+            alloc_ok = 0;
+        } else {
+            g_pf.stage[i] = (uint8_t *)stage;
+        }
+    }
+    for (int i = 0; alloc_ok && i < DS4_PF_SLOTS; i++) {
+        void *slab = NULL;
+        if (posix_memalign(&slab, 4096, (size_t)g_pf.slot_bytes) != 0) {
+            alloc_ok = 0;
+            break;
+        }
+        g_pf.slots[i].buf = (uint8_t *)slab;
+        if (cudaHostRegister(g_pf.slots[i].buf,
+                             (size_t)g_pf.slot_bytes,
+                             cudaHostRegisterPortable) != cudaSuccess) {
+            (void)cudaGetLastError();  /* correctness survives pageable copy */
+        }
+    }
+    if (!alloc_ok) {
+        fprintf(stderr, "ds4: expert prefetch DISABLED (allocation/fd)\n");
+        return;
+    }
+
+    pthread_mutex_init(&g_pf.mu, NULL);
+    pthread_cond_init(&g_pf.cv, NULL);
+    for (int i = 0; i < g_pf.n_threads; i++) {
+        if (pthread_create(&g_pf.threads[i], NULL, ds4_pf_worker,
+                           (void *)(intptr_t)i) != 0) {
+            fprintf(stderr, "ds4: expert prefetch DISABLED (thread %d)\n", i);
+            return;
+        }
+    }
+    g_pf.pool_generation = g_model_load_generation;
+    g_pf.started = 1;
+    g_pf.enabled = 1;
+    fprintf(stderr,
+            "ds4: cross-layer expert prefetch enabled (%d workers, "
+            "%d slots x %.2f MiB)\n",
+            g_pf.n_threads,
+            DS4_PF_SLOTS,
+            (double)g_pf.slot_bytes / (1024.0 * 1024.0));
+}
+
+extern "C" void ds4_gpu_expert_prefetch_hint(
+        const ds4_gpu_stream_expert_table *table,
+        const int32_t *ids,
+        uint32_t n_ids) {
+    if (!table || !ids) return;
+    /* This entry point is reached only through ds4.c's cached ON branch, so
+     * OFF mode never calls the initializer from the selected-load hot path. */
+    ds4_pf_init_once(table->gate_expert_bytes, table->down_expert_bytes);
+    if (!g_pf.enabled) return;
+    if (table->gate_expert_bytes != g_pf.gate_bytes ||
+        table->down_expert_bytes != g_pf.down_bytes) return;
+    if (g_pf.pool_generation != g_model_load_generation) {
+        pthread_mutex_lock(&g_pf.mu);
+        for (int i = 0; i < DS4_PF_SLOTS; i++) {
+            if (g_pf.slots[i].state == 2) g_pf.slots[i].state = 0;
+        }
+        g_pf.n_req = 0;
+        g_pf.enabled = 0;
+        pthread_mutex_unlock(&g_pf.mu);
+        fprintf(stderr, "ds4: expert prefetch disabled (model reload)\n");
+        return;
+    }
+
+    pthread_mutex_lock(&g_pf.mu);
+    const uint64_t epoch = ++g_pf.epoch;
+    for (int i = 0; i < DS4_PF_SLOTS; i++) {
+        if (g_pf.slots[i].state == 2 &&
+            epoch > g_pf.slots[i].epoch + 2u) {
+            g_pf.slots[i].state = 0;
+            g_pf.expired++;
+        }
+    }
+    g_pf.n_req = 0;
+    for (uint32_t i = 0; i < n_ids && g_pf.n_req < DS4_PF_SLOTS; i++) {
+        const int32_t expert = ids[i];
+        if (expert < 0 || (uint32_t)expert >= table->n_total_expert) continue;
+        const uint64_t key =
+            ((uint64_t)table->layer << 32) | (uint64_t)(uint32_t)expert;
+
+        /* Hint runs only after the current selected-load has joined, so this
+         * read-only map lookup cannot race the cache's selected-load writer. */
+        if (!g_expert_persist_cache.disabled && g_expert_persist_cache.map) {
+            auto resident = g_expert_persist_cache.map->find(key);
+            if (resident != g_expert_persist_cache.map->end() &&
+                g_expert_persist_cache.meta[resident->second].key == key) {
+                g_pf.skipped_resident++;
+                continue;
+            }
+        }
+        int duplicate = 0;
+        for (int q = 0; q < g_pf.n_req; q++) {
+            if (g_pf.reqs[q].key == key) duplicate = 1;
+        }
+        for (int s = 0; !duplicate && s < DS4_PF_SLOTS; s++) {
+            if (g_pf.slots[s].state != 0 && g_pf.slots[s].key == key)
+                duplicate = 1;
+        }
+        if (duplicate) continue;
+
+        ds4_pf_req *req = &g_pf.reqs[g_pf.n_req++];
+        req->key = key;
+        req->gate_off = table->gate_offset +
+            (uint64_t)expert * table->gate_expert_bytes;
+        req->up_off = table->up_offset +
+            (uint64_t)expert * table->gate_expert_bytes;
+        req->down_off = table->down_offset +
+            (uint64_t)expert * table->down_expert_bytes;
+        req->generation = g_model_load_generation;
+        req->epoch = epoch;
+        g_pf.issued++;
+    }
+    pthread_cond_broadcast(&g_pf.cv);
+    pthread_mutex_unlock(&g_pf.mu);
+}
+
+static uint8_t *ds4_pf_claim(uint64_t key,
+                             uint64_t gate_off,
+                             uint64_t up_off,
+                             uint64_t down_off,
+                             int *slot_out) {
+    if (!g_pf.enabled) return NULL;
+    uint8_t *buf = NULL;
+    pthread_mutex_lock(&g_pf.mu);
+    for (int i = 0; i < DS4_PF_SLOTS; i++) {
+        if (g_pf.slots[i].state != 2 || g_pf.slots[i].key != key) continue;
+        if (g_pf.slots[i].gate_off != gate_off ||
+            g_pf.slots[i].up_off != up_off ||
+            g_pf.slots[i].down_off != down_off ||
+            g_pf.slots[i].generation != g_model_load_generation ||
+            g_pf.pool_generation != g_model_load_generation) {
+            g_pf.slots[i].state = 0;
+            g_pf.stale++;
+            continue;
+        }
+        g_pf.slots[i].state = 3;
+        buf = g_pf.slots[i].buf;
+        *slot_out = i;
+        g_pf.served++;
+        break;
+    }
+    pthread_mutex_unlock(&g_pf.mu);
+    return buf;
+}
+
+static void ds4_pf_release(int slot) {
+    if (slot < 0) return;
+    pthread_mutex_lock(&g_pf.mu);
+    g_pf.slots[slot].state = 0;
+    pthread_mutex_unlock(&g_pf.mu);
+}
