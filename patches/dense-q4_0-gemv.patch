+__device__ __forceinline__ static float glm_q4_0_dot_row_dev(
+        const char *row, const float *x, uint32_t n_cols) {
+    float acc = 0.0f;
+    const uint32_t nb = n_cols >> 5;
+    for (uint32_t b = 0; b < nb; b++) {
+        const char *blk = row + (uint64_t)b * 18u;
+        const float d = __half2float(*(const __half *)blk);
+        const uint8_t *q = (const uint8_t *)(blk + 2);
+        float s = 0.0f;
+        #pragma unroll 8
+        for (uint32_t k = 0; k < 32u; k++) {
+            const uint8_t packed = q[k & 15u];
+            const int v = (int)(k < 16u ? (packed & 0x0fu) : (packed >> 4u)) - 8;
+            s += (float)v * x[b * 32u + k];
+        }
+        acc += d * s;
+    }
+    return acc;
+}
+
+__global__ static void glm_matmul_q4_0_warp8_kernel(
+        float *out, const char *weight, const float *x,
+        uint64_t in_dim, uint64_t out_dim, uint64_t n_tok,
+        uint64_t row_bytes) {
+    const uint64_t row = (uint64_t)blockIdx.x * 8u + (threadIdx.x >> 5u);
+    const uint64_t tok = blockIdx.y;
+    const uint32_t lane = threadIdx.x & 31u;
+    if (row >= out_dim || tok >= n_tok) return;
+    const char *wr = weight + row * row_bytes;
+    const float *xr = x + tok * in_dim;
+    const uint64_t blocks = in_dim >> 5;
+    float acc = 0.0f;
+    for (uint64_t b = lane; b < blocks; b += 32u) {
+        const char *blk = wr + b * 18u;
+        const float d = __half2float(*(const __half *)blk);
+        const uint8_t *q = (const uint8_t *)(blk + 2);
+        float s = 0.0f;
+        #pragma unroll 8
+        for (uint32_t k = 0; k < 32u; k++) {
+            const uint8_t packed = q[k & 15u];
+            const int v = (int)(k < 16u ? (packed & 0x0fu) : (packed >> 4u)) - 8;
+            s += (float)v * xr[b * 32u + k];
+        }
+        acc += d * s;
+    }
+    acc = warp_sum_f32(acc);
+    if (lane == 0u) out[tok * out_dim + row] = acc;
+}
+
+__global__ static void glm_matmul_q4_0_kslice_warp8_kernel(
+        float *out, const char *weight, const float *x,
+        uint64_t full_blocks, uint64_t block_start, uint64_t slice_blocks,
+        uint64_t out_dim) {
+    const uint64_t row = (uint64_t)blockIdx.x * 8u + (threadIdx.x >> 5u);
+    const uint32_t lane = threadIdx.x & 31u;
+    if (row >= out_dim) return;
+    const char *wr = weight + (row * full_blocks + block_start) * 18u;
+    float acc = 0.0f;
+    for (uint64_t b = lane; b < slice_blocks; b += 32u) {
+        const char *blk = wr + b * 18u;
+        const float d = __half2float(*(const __half *)blk);
+        const uint8_t *q = (const uint8_t *)(blk + 2);
+        float s = 0.0f;
+        #pragma unroll 8
+        for (uint32_t k = 0; k < 32u; k++) {
