+    raise ValueError(f"INKLING2_VISION_ATTN must be fa or triton, got {_VISION_ATTN!r}")
+VISION_TRITON_ATTN = _VISION_ATTN == "triton"
+if VISION_TRITON_ATTN:
+    logger.info("INKLING2_VISION_ATTN=triton: vision encoder attention via Triton prefill")
