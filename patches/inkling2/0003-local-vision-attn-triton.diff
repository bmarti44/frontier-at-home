+# Local gate (patches/inkling2/0003): read once at import, default "fa" (upstream).
+# "triton" runs the off-SM100 encoder attention through vLLM's Triton prefill kernel
+# instead of vllm_flash_attn FA2, whose wheel ships sm_80 SASS plus PTX ISA 9.2 only;
+# a CUDA 13.0 driver (r580) cannot JIT that PTX on SM12x.
+_VISION_ATTN = os.environ.get("INKLING2_VISION_ATTN", "fa")
