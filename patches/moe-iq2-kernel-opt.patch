 #define MOE_DECODE_ROWS_PER_BLOCK (32u * MOE_DECODE_ROW_TILES)
 
+/* Eight consecutive IQ2_XXS blocks occupy exactly 528 bytes, or 33 uint4s.
+ * A decode quarter-warp owns those same eight blocks.  Loading the wave as
+ * aligned uint4s makes the global transactions contiguous; the owning lane
+ * then consumes its original 66-byte block from shared memory. */
+#define MOE_IQ2_WAVE_BLOCKS 8u
+#define MOE_IQ2_WAVE_UINT4S \
+    ((MOE_IQ2_WAVE_BLOCKS * sizeof(cuda_block_iq2_xxs)) / sizeof(uint4))
+static_assert(sizeof(cuda_block_iq2_xxs) == 66u,
+              "IQ2_XXS vector staging assumes the 66-byte wire block");
+static_assert((MOE_IQ2_WAVE_BLOCKS * sizeof(cuda_block_iq2_xxs)) %
+                  sizeof(uint4) == 0u,
+              "eight IQ2_XXS blocks must be an integral uint4 wave");
+
+__device__ __forceinline__ static void moe_iq2_stage_wave8(
+        uint4 *dst,
+        const cuda_block_iq2_xxs *src,
+        uint32_t lane) {
+    const uint4 *src4 = (const uint4 *)src;
+    #pragma unroll
+    for (uint32_t i = lane; i < MOE_IQ2_WAVE_UINT4S;
+         i += MOE_IQ2_WAVE_BLOCKS) {
+        dst[i] = __ldg(src4 + i);
+    }
+}
+
