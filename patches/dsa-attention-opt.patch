+/* Byte-identical staged LoRA accumulation for the 64-head GLM decode shape.
+ *
+ * A warp covers 8 heads x 4 adjacent value pairs.  For every selected row,
+ * the four cache pairs are loaded by head 0 and broadcast to the other seven
+ * heads, while each head's softmax weight is loaded once and broadcast across
+ * its four pairs.  Each lane still owns one (head, pair) result and executes
+ * the original s=0..row_count-1 multiply/add sequence, followed by the same
+ * division.  No reduction tree or floating-point accumulation order changes.
+ *
+ * The launch is diagnostic/default-off until matched byte-identity and timing
+ * gates qualify it for the production path. */
+template <typename CT, bool RANGE_TOK2 = false>
+__global__ static void glm_attention_decode_lora_warp_tile_kernel(
+        float *lora_sum,
+        const float *scores,
+        const float *denom,
+        const CT *kv_lora_cache,
+        const uint32_t *selected,
+        uint32_t n_selected,
+        uint32_t cache_cap,
+        uint32_t n_head,
+        uint32_t kv_lora_dim) {
+    const uint32_t lane = threadIdx.x & 31u;
+    const uint32_t warp = threadIdx.x >> 5u;
+    const uint32_t head_in_tile = lane >> 2u;
+    const uint32_t pair_in_warp = lane & 3u;
+    const uint32_t head = blockIdx.y * 8u + head_in_tile;
+    const uint32_t pair = (blockIdx.x * 8u + warp) * 4u + pair_in_warp;
+    const uint32_t j = pair * 2u;
+    const uint32_t token = RANGE_TOK2 ? blockIdx.z : 0u;
+    const uint32_t row_count = n_selected + (RANGE_TOK2 ? token : 0u);
+    const uint32_t score_stride = n_selected + (RANGE_TOK2 ? 1u : 0u);
+
+    /* n_head == 64 and kv_lora_dim is a multiple of 32 at this dispatch.
+     * Therefore a boundary is uniform across a whole warp, as required by
+     * the full-mask shuffles below. */
+    if (head >= n_head || j >= kv_lora_dim) return;
+
+    const uint64_t head_index = (uint64_t)token * n_head + head;
+    const float *head_scores = scores + head_index * score_stride;
+    float acc0 = 0.0f;
+    float acc1 = 0.0f;
+    for (uint32_t s = 0; s < row_count; s++) {
+        uint32_t row = RANGE_TOK2 ? s :
+            (lane == 0u ? __ldg(selected + s) : 0u);
+        row = __shfl_sync(0xffffffffu, row, 0);
+        if (row < cache_cap) {
+            float v0 = 0.0f;
+            float v1 = 0.0f;
+            if (head_in_tile == 0u) {
+                const float2 v = glm_cache_value_pair_dev(
+                        kv_lora_cache + (uint64_t)row * kv_lora_dim + j);
+                v0 = v.x;
+                v1 = v.y;
+            }
+            v0 = __shfl_sync(0xffffffffu, v0, pair_in_warp);
+            v1 = __shfl_sync(0xffffffffu, v1, pair_in_warp);
+            float w = pair_in_warp == 0u ? __ldg(head_scores + s) : 0.0f;
+            w = __shfl_sync(0xffffffffu, w, head_in_tile * 4u);
+            acc0 += w * v0;
+            acc1 += w * v1;
+        }
+    }
+    float *out = lora_sum + head_index * kv_lora_dim + j;
+    const float d = __ldg(denom + head_index);
+    out[0] = acc0 / d;
+    out[1] = acc1 / d;
+}
+
+static void cuda_glm_attn_lora_staged_launch(
+        float *lora_sum,
+        const float *scores,
+        const float *denom,
+        const void *kv_lora_cache,
+        const uint32_t *selected,
+        uint32_t n_selected,
+        uint32_t cache_cap,
+        uint32_t n_head,
+        uint32_t kv_lora_dim,
+        uint32_t token_count,
+        bool cache_f16,
+        bool range_tok2) {
+    const dim3 grid((kv_lora_dim / 2u + 63u) / 64u,
+                    n_head, token_count);
+    if (cache_f16 && range_tok2) {
+        glm_attention_decode_lora_staged_kernel<__half, true><<<grid, 64>>>(
+                lora_sum, scores, denom,
+                (const __half *)kv_lora_cache, selected,
+                n_selected, cache_cap, n_head, kv_lora_dim);
+    } else if (cache_f16) {
+        glm_attention_decode_lora_staged_kernel<__half><<<grid, 64>>>(
+                lora_sum, scores, denom,
+                (const __half *)kv_lora_cache, selected,
+                n_selected, cache_cap, n_head, kv_lora_dim);
+    } else if (range_tok2) {
+        glm_attention_decode_lora_staged_kernel<float, true><<<grid, 64>>>(
+                lora_sum, scores, denom,
+                (const float *)kv_lora_cache, selected,
+                n_selected, cache_cap, n_head, kv_lora_dim);
+    } else {
+        glm_attention_decode_lora_staged_kernel<float><<<grid, 64>>>(
+                lora_sum, scores, denom,
+                (const float *)kv_lora_cache, selected,
+                n_selected, cache_cap, n_head, kv_lora_dim);
+    }
+}
+
+static void cuda_glm_attn_lora_warp_tile_launch(
+        float *lora_sum,
+        const float *scores,
+        const float *denom,
+        const void *kv_lora_cache,
+        const uint32_t *selected,
+        uint32_t n_selected,
+        uint32_t cache_cap,
+        uint32_t n_head,
+        uint32_t kv_lora_dim,
+        uint32_t token_count,
+        bool cache_f16,
+        bool range_tok2) {
+    if (n_head != 64u) {
+        cuda_glm_attn_lora_staged_launch(
+                lora_sum, scores, denom, kv_lora_cache, selected,
+                n_selected, cache_cap, n_head, kv_lora_dim, token_count,
+                cache_f16, range_tok2);
+        return;
+    }
+    const dim3 grid((kv_lora_dim / 2u + 31u) / 32u,
+                    (n_head + 7u) / 8u, token_count);
+    if (cache_f16 && range_tok2) {
+        glm_attention_decode_lora_warp_tile_kernel<__half, true>
+                <<<grid, 256>>>(
+                lora_sum, scores, denom,
+                (const __half *)kv_lora_cache, selected,
+                n_selected, cache_cap, n_head, kv_lora_dim);
+    } else if (cache_f16) {
+        glm_attention_decode_lora_warp_tile_kernel<__half><<<grid, 256>>>(
+                lora_sum, scores, denom,
+                (const __half *)kv_lora_cache, selected,
+                n_selected, cache_cap, n_head, kv_lora_dim);
+    } else if (range_tok2) {
+        glm_attention_decode_lora_warp_tile_kernel<float, true>
+                <<<grid, 256>>>(
+                lora_sum, scores, denom,
+                (const float *)kv_lora_cache, selected,
+                n_selected, cache_cap, n_head, kv_lora_dim);
+    } else {
+        glm_attention_decode_lora_warp_tile_kernel<float><<<grid, 256>>>(
+                lora_sum, scores, denom,
+                (const float *)kv_lora_cache, selected,
+                n_selected, cache_cap, n_head, kv_lora_dim);
+    }
+}
