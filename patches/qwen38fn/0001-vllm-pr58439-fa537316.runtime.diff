+            input_ids.reshape(-1).long(),
+            output.view(torch.uint8).reshape(-1, self.table.row_bytes),
+            self.shard_indices.org_vocab_start_index,
+            self.shard_indices.org_vocab_end_index,
+        )
+        return output
