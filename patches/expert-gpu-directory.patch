+__global__ static void cuda_expert_gpu_dir_translate_kernel(
+        const int32_t *selected,
+        int32_t *remapped,
+        uint64_t *direct_ptrs,
+        const uint32_t *slot_of,
+        uint8_t *protected_slots,
+        uint32_t *miss,
+        uint8_t *arena_base,
+        uint64_t slot_bytes,
+        uint64_t expert_bytes,
+        uint32_t layer,
+        uint32_t n_slots,
+        uint32_t clear_protected) {
+    const uint32_t tid = threadIdx.x;
+    if (clear_protected) {
+        for (uint32_t slot = tid; slot < n_slots; slot += blockDim.x)
+            protected_slots[slot] = 0;
+    }
+    if (tid == 0) *miss = 0;
+    __syncthreads();
+    if (tid >= 8u) return;
+    const int32_t expert = selected[tid];
+    int bad = expert < 0 || expert >= (int32_t)DS4_EXPERT_GPU_DIR_EXPERTS;
+    for (uint32_t prior = 0; prior < tid && !bad; prior++)
+        bad = selected[prior] == expert;
+    uint32_t slot = DS4_EXPERT_GPU_DIR_INVALID;
+    if (!bad)
+        slot = slot_of[layer * DS4_EXPERT_GPU_DIR_EXPERTS +
+                       (uint32_t)expert];
+    if (slot == DS4_EXPERT_GPU_DIR_INVALID || slot >= n_slots) {
+        atomicOr(miss, 1u);
+        remapped[tid] = (int32_t)tid;
+        direct_ptrs[(uint64_t)tid * 3u + 0u] = 0;
+        direct_ptrs[(uint64_t)tid * 3u + 1u] = 0;
+        direct_ptrs[(uint64_t)tid * 3u + 2u] = 0;
+        return;
+    }
+    protected_slots[slot] = 1;
+    remapped[tid] = (int32_t)tid;
+    uint8_t *base = arena_base + (uint64_t)slot * slot_bytes;
+    direct_ptrs[(uint64_t)tid * 3u + 0u] =
+        (uint64_t)(uintptr_t)base;
+    direct_ptrs[(uint64_t)tid * 3u + 1u] =
+        (uint64_t)(uintptr_t)(base + expert_bytes);
+    direct_ptrs[(uint64_t)tid * 3u + 2u] =
+        (uint64_t)(uintptr_t)(base + 2u * expert_bytes);
+}
