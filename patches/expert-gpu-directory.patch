+static void cuda_expert_gpu_dir_invalidate_for_reuse(uint64_t key) {
+    if (!g_expert_persist_cache.gpu_dir_enabled || key == UINT64_MAX) return;
+    /* Miss processing may reuse this host-mirror cell and arena slot.  Drain
+     * an older publication, enqueue the invalidation, then make it visible
+     * before the CPU overwrites the slot.  This synchronization is miss-only. */
+    cudaError_t rc = cudaStreamSynchronize(0);
+    if (rc == cudaSuccess) {
+        cuda_expert_gpu_dir_update(key, DS4_EXPERT_GPU_DIR_INVALID);
+        if (g_expert_persist_cache.gpu_dir_enabled)
+            rc = cudaStreamSynchronize(0);
+    }
+    if (rc != cudaSuccess) {
+        g_expert_persist_cache.gpu_dir_enabled = 0;
+        (void)cudaGetLastError();
+        fprintf(stderr, "ds4: CUDA expert GPU directory DISABLED "
+                        "(reuse invalidation failed: %s)\n",
+                cudaGetErrorString(rc));
+    }
+}
