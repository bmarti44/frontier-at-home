+/* Directory updates share stream 0 with translation and MoE dispatch.  An
+ * invalidation is therefore visible before a reused arena slot can be
+ * published, and a publication is visible before a later translation. */
+static void cuda_expert_gpu_dir_update(uint64_t key, uint32_t slot) {
+    if (!g_expert_persist_cache.gpu_dir_enabled) return;
+    const uint32_t layer = (uint32_t)(key >> 32);
+    const uint32_t expert = (uint32_t)key;
+    if (layer >= DS4_EXPERT_GPU_DIR_LAYERS ||
+        expert >= DS4_EXPERT_GPU_DIR_EXPERTS) return;
+    const uint32_t index = layer * DS4_EXPERT_GPU_DIR_EXPERTS + expert;
+    g_expert_persist_cache.gpu_dir_host[index] = slot;
+    const cudaError_t rc = cudaMemcpyAsync(
+            g_expert_persist_cache.gpu_dir_device + index,
+            g_expert_persist_cache.gpu_dir_host + index,
+            sizeof(uint32_t), cudaMemcpyHostToDevice, 0);
+    if (rc != cudaSuccess) {
+        g_expert_persist_cache.gpu_dir_enabled = 0;
+        (void)cudaGetLastError();
+        fprintf(stderr, "ds4: CUDA expert GPU directory DISABLED "
+                        "(directory update failed: %s)\n",
+                cudaGetErrorString(rc));
+    }
+}
