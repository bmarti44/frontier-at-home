+/* Returns 1 for a complete device-directory hit and 0 to use the unchanged
+ * host readback/remap/fill path.  The event provides completion/visibility
+ * for the mapped miss word; it does not transfer selected IDs to the host. */
+static int cuda_expert_gpu_dir_try_selected(
+        const ds4_gpu_stream_expert_table *table,
+        const ds4_gpu_tensor *selected,
+        uint32_t n_selected) {
+    if (!g_expert_persist_cache.gpu_dir_enabled || n_selected != 8u ||
+        table->layer >= DS4_EXPERT_GPU_DIR_LAYERS ||
+        table->n_total_expert > DS4_EXPERT_GPU_DIR_EXPERTS ||
+        table->gate_type != 16u || table->up_type != 16u ||
+        table->down_type != 16u ||
+        table->gate_expert_bytes != table->down_expert_bytes)
+        return 0;
+    const uint64_t remap_bytes = 8u * sizeof(int32_t);
+    const uint64_t ptr_offset = (remap_bytes + 7u) & ~7ull;
+    const uint64_t payload_bytes = ptr_offset + 8u * 3u * sizeof(uint64_t);
+    if (ds4_gpu_set_current_device(0) != 0 ||
+        !cuda_stream_selected_ensure_bytes(
+                (char **)&g_stream_selected_cache.slot_selected_ptr,
+                &g_stream_selected_cache.slot_selected_capacity,
+                payload_bytes, "selected-id/GPU-directory table"))
+        return 0;
+
+    const int clear_protected =
+        g_expert_persist_cache.protected_last_layer == UINT32_MAX ||
+        table->layer <= g_expert_persist_cache.protected_last_layer;
+    g_expert_persist_cache.protected_last_layer = table->layer;
+    int32_t *remapped = g_stream_selected_cache.slot_selected_ptr;
+    uint64_t *direct_ptrs = (uint64_t *)(
+            (uint8_t *)g_stream_selected_cache.slot_selected_ptr + ptr_offset);
+    cuda_expert_gpu_dir_translate_kernel<<<1, 256>>>(
+            (const int32_t *)selected->ptr, remapped, direct_ptrs,
+            g_expert_persist_cache.gpu_dir_device,
+            g_expert_persist_cache.protected_slots_device,
+            g_expert_persist_cache.gpu_dir_miss_device,
+            g_expert_persist_cache.arena_device,
+            g_expert_persist_cache.slot_bytes,
+            table->gate_expert_bytes, table->layer,
+            g_expert_persist_cache.n_slots,
+            clear_protected ? 1u : 0u);
+    cudaError_t rc = cudaGetLastError();
+    if (rc == cudaSuccess)
+        rc = cudaEventRecord(g_expert_persist_cache.gpu_dir_event, 0);
+    if (rc == cudaSuccess)
+        rc = cudaEventSynchronize(g_expert_persist_cache.gpu_dir_event);
+    if (rc != cudaSuccess) {
+        g_expert_persist_cache.gpu_dir_enabled = 0;
+        (void)cudaGetLastError();
+        fprintf(stderr, "ds4: CUDA expert GPU directory DISABLED "
+                        "(translation failed: %s)\n",
+                cudaGetErrorString(rc));
+        return 0;
+    }
+    if (*g_expert_persist_cache.gpu_dir_miss_host != 0) return 0;
+
+    g_stream_selected_cache.logical_tier = 0;
+    g_stream_selected_cache.model_map = table->model_map;
+    g_stream_selected_cache.layer = table->layer;
+    g_stream_selected_cache.n_total_expert = table->n_total_expert;
+    g_stream_selected_cache.slot_count = 8u;
+    g_stream_selected_cache.compact_count = 8u;
+    g_stream_selected_cache.gate_offset = table->gate_offset;
+    g_stream_selected_cache.up_offset = table->up_offset;
+    g_stream_selected_cache.down_offset = table->down_offset;
+    g_stream_selected_cache.gate_expert_bytes = table->gate_expert_bytes;
+    g_stream_selected_cache.down_expert_bytes = table->down_expert_bytes;
+    g_stream_selected_cache.slot_selected_tensor.ptr = remapped;
+    g_stream_selected_cache.slot_selected_tensor.bytes = remap_bytes;
+    g_stream_selected_cache.slot_selected_tensor.owner = 0;
+    g_stream_selected_cache.slot_selected_tensor.device_id = 0;
+    g_stream_selected_cache.direct_slot_valid = 1;
+    g_stream_selected_cache.direct_slot_ptrs = direct_ptrs;
+    g_stream_selected_cache.valid = 1;
+    g_expert_persist_cache.hits += 8u;
+    g_expert_persist_cache.loads++;
+    return 1;
+}
